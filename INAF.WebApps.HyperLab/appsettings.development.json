{
  "AppSettings": {
    "DownloadRootPath": "G:\\Publish",
    /* setting for expiration datetime for confirmation token a new user registration occurs */
    "JwtToken": {
      /* private/public keys are stored in 'user secrets' */
      "Issuer": "http://localhost",
      "Audience": "http://localhost",
      "TokenTimeoutDays": 60
    },
    /* prefix for retrieving user-secrets */
    "AppPrefixForUserSecrets": "HyperLab",
    /* setting for expiration datetime for confirmation token a new user registration occurs */
    "ConfirmationToken": {
      "TokenTimeoutDays": 1
    },
    "DbConnection": {
      /* server_value, userid_value, pwd_value are stored in 'user secrets' */
      "GenericConnString": "Server=172.31.160.17;Database=db_name;User Id=userid_value;Password=pwd_value;Encrypt=no;TrustServerCertificate=true;MultipleActiveResultSets=true",
      "DbForData": "HyperLabData",
      "DbForUsers": "HyperLabUsers"
    },
    "Log4NetCore": {
      "Log4NetConfigFileName": "C:\\CommonFiles\\log4net_inaf_hyperlab.xml"
    }
  },
  "AllowedHosts": "*"
}
