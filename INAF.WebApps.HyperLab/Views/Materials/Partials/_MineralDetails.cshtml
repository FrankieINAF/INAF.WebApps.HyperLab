@model MaterialModel

@using INAF.Libraries.Net.HyperLabCommonModels.Models.SampleData
@using INAF.WebApps.HyperLab.Resources


<div class="row">
    <div class="cell-fs-12 margin-left-8">
        <!-- PICTURE + BUTTONS -->
        <div class="row rows-divider">
            <div class="cell-fs-6 cell-sm-4">
                <img id="infoPicture" src="/images/infoCard.png" width="128" height="128" />
            </div>
            <div class="cell-fs-6 cell-sm-8">
                <div class="row">
                    <div class="cell-fs-12">
                        <span id="person-name" class="person-name">@Html.Raw(Model.Name)</span>
                    </div>
                </div>
                <div class="row">
                    <div class="cell-fs-12">
                        <span class="mif-pencil" onclick="loadUpsertMineralFromEdit(@Model.Id)" style="margin: 0px 8px; cursor: pointer"></span>
                        <span class="mif-bin" onclick="deleteMineralProcedure(@Model.Id)" style="margin: 0px 8px; cursor: pointer"></span>
                        <span class="mif-cross-light" onclick="closePartialView('selectedMineralContainer', 'showCardContainer')" style="float:right; margin-right: 8px; display:block; cursor:pointer;"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row rows-divider3">
            <div class="cell-fs-3 cell-sm-2 text-right">
                <span><strong>@Materials.FormulaLabel</strong></span>
            </div>
            <div class="cell-fs-9 cell-sm-10">
                <span>@Model.Formula</span>
            </div>
        </div>
    </div>
</div>