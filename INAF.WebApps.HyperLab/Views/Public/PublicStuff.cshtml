@using INAF.WebApps.HyperLab.Resources

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}


<div class="d-flex flex-column-fs flex-row-lg h-100 overflow-x-auto overflow-y-auto" style="max-width: 100%">
    <div class="d-flex flex-column margin-16">
        <span class="text-medium text-just">@Html.Raw(PublicStuff.SampleNameGroupsLabel)</span>
        <canvas id="chartSampleNames" class="w-100-fs w-30-lg"></canvas>
    </div>

    <div class="d-flex flex-column margin-16">
        <span class="text-medium text-just">@Html.Raw(PublicStuff.SampleTypeGroupsLabel)</span>
        <canvas id="chartSampleTypes" class="w-100-fs w-30-lg"></canvas>
    </div>

    <div class="d-flex flex-column margin-16">
        <span class="text-medium text-just">@Html.Raw(PublicStuff.MineralTypeGroupsLabel)</span>
        <canvas id="chartMineralTypes" class="w-100-fs w-30-lg"></canvas>
    </div>
</div>

@{
    <!-- CHARMS SHARE -->
    await Html.RenderPartialAsync("Partials/_PublicStuffJsCommon");
}

<script type="text/javascript" src="~/lib/chartjs/chartjs.min.js"></script>
<environment names="Development">
    <script type="text/javascript" src="~/js/src/public/publicstuff.js" asp-append-version="true"></script>
</environment>
<environment names="Production">
    <script type="text/javascript" src="~/js/dist/public/publicbundle.min.js" asp-append-version="true"></script>
</environment>