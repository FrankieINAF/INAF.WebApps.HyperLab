@model SpectrumFileMeasurementInfoValues

@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.HyperLabCommonModels.Models.MeasurementInfo

<div class="row">
    <!-- LEFT -->
    <div class="cell-fs-12 cell-md-4 border-tab">
        <div class="row cell-fs-12 text-center">
            <span class="text-leader2"><strong>@Html.Raw(Info.InfoLeftColumnTitle)</strong></span>
        </div>
        <div class="row cell-fs-12 text-center">
            <span class="fg-cyan">@Html.Raw(Info.InfoSpectrumInfoLabel)</span>
        </div>
        <!-- NUM OF SPECTRA -->
        <div class="row cell-fs-12 text-center">
            <span>@Html.Raw(Info.NumOfAcquiredSpectraLabel)</span>
        </div>
        <div class="row cell-fs-12">
            <input id="numOfAcquiredSpectra" type="text" data-role="spinner" data-size="20" value="@Model.NumOfAcquiredSpectra" data-step="1" data-min-value="0" data-buttons-position="right">
        </div>
        <!-- NUM OF ACQUISITIONS FOR SPECTRUM -->
        <div class="row cell-fs-12 text-center margin-top-16">
            <span>@Html.Raw(Info.NumOfAcquisitionsForSpectrumLabel)</span>
        </div>
        <div class="row cell-fs-12">
            <input id="numOfAcquisitionsForSpectrum" type="text" data-role="spinner" value="@Model.NumOfAcquisitionsForSpectrum" data-step="100" data-min-value="0" data-buttons-position="right">
        </div>

        <!-- ANGLES -->
        <div class="row cell-fs-12 text-center margin-top-32">
            <span class="fg-cyan">@Html.Raw(Info.InfoGeometryInfoLabel)</span>
        </div>
        <!-- INCIDENCE ANGLE -->
        <div class="row cell-fs-12 text-center">
            <span>@Html.Raw(Info.InfoGeometryIncidenceAngleLabel)</span>
        </div>
        <div class="row cell-fs-12">
            <input id="incidenceAngle" type="text" data-role="spinner" value="@Model.IncidenceAngle" data-step="1" data-min-value="0" data-max-value="90" data-buttons-position="right">
        </div>
        <!-- EMISSION ANGLE -->
        <div class="row cell-fs-12 text-center margin-top-16">
            <span>@Html.Raw(Info.InfoGeometryEmissionAngleLabel)</span>
        </div>
        <div class="row cell-fs-12">
            <input id="emissionAngle" type="text" data-role="spinner" value="@Model.EmissionAngle" data-step="1" data-min-value="0" data-max-value="90" data-buttons-position="right">
        </div>
    </div>
    
    <!-- CENTER -->
    <div class="cell-fs-12 cell-md-4 border-tab">
        <div class="row cell-fs-12 text-center">
            <span class="text-leader2"><strong>@Html.Raw(Info.InfoCenterColumnTitle)</strong></span>
        </div>
    </div>
</div>