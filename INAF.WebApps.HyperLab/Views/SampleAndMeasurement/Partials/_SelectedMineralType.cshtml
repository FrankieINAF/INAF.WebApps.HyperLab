@model SampleDataSelectedValues

@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.HyperLabCommonModels.Models.SampleData
@using INAF.Libraries.Net.HyperLabCommonModels.Values
@using System.Text;

<!-- MINERALS -->
@if (Model.MineralTypeId == (int)Enums.MineralType.Monomineralic)
{
    <div class="row cell-fs-12 margin-top-16">
        <label for="selectedMineral" class="control-label">@Html.Raw(Info.InfoSelectedMineralLabel)</label>
    </div>
    <div id="selectedMonoMineralContainer" class="row cell-fs-12">
        @if (Model.Minerals?.Count > 0)
        {
            <span id="selectedMineral">@Html.Raw(Model.Minerals[0].Name)</span>
            @Html.HiddenFor(model => model.Minerals[0].Id)
        }
        else
        {
            <div id="noSelectedMonoMineral" class="remark warning">
                @Html.Raw(Info.InfoNoMineralSelectedYet)
            </div>
        }
    </div>
}
else if (Model.MineralTypeId == (int)Enums.MineralType.Amorphous)
{
    // do nothing
}
else if (Model.MineralTypeId == (int)Enums.MineralType.Mix)
{
    <div class="row cell-fs-12 margin-top-16">
        <label for="selectedMinerals" class="control-label">@Html.Raw(Info.InfoSelectedMineralsLabel)</label>
    </div>
    <div id="selectedMineralsContainer" class="row cell-fs-12">
        <div class="row cell-fs-12">
            <ul id="selectedMinerals" 
                data-role="list" 
                class="items-list"
                data-show-pagination="false">
            </ul>
            @if (Model.Minerals?.Count > 0)
            {
                int mineralsNum = Model.Minerals.Count;
                for (int i = 0; i < mineralsNum; i++)
                {
                    string id = $"mineral{Model.Minerals[i].Id}";
                    string percentageId = $"mineralPercentage{Model.Minerals[i].Id}";
                    <li id="@id" class="d-flex flex-row flex-align-center flex-justify-between material-row">
                        <span class="label w-25">@Model.Minerals[i].Name</span>
                        <input id="@percentageId" type="number" min="0" max="100" maxlength="10" value="@Model.Minerals[i].Percentage">
                        <span class="mif-bin pointer" onclick="deleteMineralProcedure('@id')"></span>
                    </li>
                }
            }
            else
            {
                <div id="noSelectedMinerals" class="remark warning">
                    @Html.Raw(Info.InfoNoMineralsSelectedYet)
                </div>
            }
        </div>
    </div>
}
else if (Model.MineralTypeId == (int)Enums.MineralType.Rock)
{
    <div class="row cell-fs-12 margin-top-16">
        <label for="selectedMineralContainer" class="control-label">@Html.Raw(Info.InfoSelectedRockLabel)</label>
    </div>
    <div id="selectedRockContainer" class="row cell-fs-12">
    @if (Model.Rock != null)
    {
        <span id="selectedRock">@Html.Raw(Model.Rock.Name)</span>
        @Html.HiddenFor(model => model.Rock.Id)
    }
    else
    {
        <div id="noSelectedRock" class="remark warning">
            @Html.Raw(Info.InfoNoRockSelectedYet)
        </div>
    }
    </div>
}
else if (Model.MineralTypeId == (int)Enums.MineralType.Extraterrestrial)
{
    <div class="row cell-fs-12 margin-top-16">
    <label for="selectedMeteorClassContainer" class="control-label">@Html.Raw(Info.InfoSelectedMeteorMeteorClassLabel)</label>
    </div>
    <div id="selectedMeteorClassContainer" class="row cell-fs-12">
    @if (Model.MeteorClass != null)
    {
        <span id="selectedMeteorClass">@Html.Raw(Model.MeteorClass.Name)</span>
        @Html.HiddenFor(model => model.MeteorClass.Id)
    }
    else
    {
        <div id="noSelectedMeteorClass" class="remark warning">
            @Html.Raw(Info.InfoNoMeteorClassSelectedYet)
        </div>
    }
    </div>
}

<script type="text/javascript">
    function setMineralTypeItems() {
    @if (Model.MineralTypeId == (int)Enums.MineralType.Monomineralic)
    {
        string setMonomineral = $"setMonomineral({Model.Minerals[0].Id}, \"{Model.Minerals[0].Name}\")";
        @Html.Raw(setMonomineral);
    }
    else if (Model.MineralTypeId == (int)Enums.MineralType.Mix)
    {
        if (Model.Minerals?.Count > 0)
        {
            StringBuilder sb = new StringBuilder();
            int mineralsNum = Model.Minerals.Count;
            for (int i = 0; i < mineralsNum; i++)
            {
                sb.AppendLine($"addMineralItem({Model.Minerals[i].Id}, \"{Model.Minerals[i].Name}\", {Model.Minerals[i].Percentage});");
            }
            @Html.Raw(sb.ToString());
        }
    }
    else if (Model.MineralTypeId == (int)Enums.MineralType.Rock)
    {
        if (Model.Rock != null)
        {
            string setRock = $"setRock({Model.Rock.Id}, \"{Model.Rock.Name}\")";
            @Html.Raw(setRock);
        }
    }
    else if (Model.MineralTypeId == (int)Enums.MineralType.Extraterrestrial)
    {
        if (Model.MeteorClass != null)
        {
            string setMeteorClass = $"setMeteorClass({Model.MeteorClass.Id}, \"{Model.MeteorClass.Name}\")";
            @Html.Raw(setMeteorClass);
        }
    }
    }
</script>