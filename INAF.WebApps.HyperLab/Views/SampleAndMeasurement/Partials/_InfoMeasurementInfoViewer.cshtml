@model SpectrumFileMeasurementInfoValues

@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.MeasurementInfo

<div class="row">
    <!-- LEFT -->
    <div class="cell-fs-12 cell-md-4 border-tab">
        <div class="row cell-fs-12 text-center">
            <span class="text-leader2"><strong>@Html.Raw(Info.InfoLeftColumnTitle)</strong></span>
        </div>
        <div class="row cell-fs-12 text-center">
            <span class="fg-cyan">@Html.Raw(Info.InfoSpectrumInfoLabel)</span>
        </div>
        <!-- NUM OF SPECTRA -->
        <div class="row cell-fs-12">
            <span class="control-label">
                @Html.Raw(Info.NumOfAcquiredSpectraLabel)
            </span>
            <span>:&nbsp;</span>
            <span>
                <label>@Html.Raw(Model.NumOfAcquiredSpectra)</label>
            </span>
        </div>
        <!-- NUM OF ACQUISITIONS FOR SPECTRUM -->
        <div class="row cell-fs-12 margin-top-8">
            <span class="control-label">
                @Html.Raw(Info.NumOfAcquisitionsForSpectrumLabel)
            </span>
            <span>:&nbsp;</span>
            <span>
                <label>@Html.Raw(Model.NumOfAcquisitionsForSpectrum)</label>
            </span>
        </div>
        <!-- ANGLES -->
        <div class="row cell-fs-12 text-center margin-top-32">
            <span class="fg-cyan">@Html.Raw(Info.InfoGeometryInfoLabel)</span>
        </div>
        <!-- INCIDENCE ANGLE -->
        <div class="row cell-fs-12">
            <span class="control-label">
                @Html.Raw(Info.InfoGeometryIncidenceAngleLabel)
            </span>
            <span>:&nbsp;</span>
            <span>
                <label>@Html.Raw(Model.IncidenceAngle)</label>
            </span>
        </div>
        <!-- EMISSION ANGLE -->
        <div class="row cell-fs-12 margin-top-8">
            <span class="control-label">
                @Html.Raw(Info.InfoGeometryEmissionAngleLabel)
            </span>
            <span>:&nbsp;</span>
            <span>
                <label>@Html.Raw(Model.EmissionAngle)</label>
            </span>
        </div>
    </div>
    
    <!-- CENTER -->
    <div class="cell-fs-12 cell-md-4 border-tab">
        <div class="row cell-fs-12 text-center">
            <span class="text-leader2"><strong>@Html.Raw(Info.InfoCenterColumnTitle)</strong></span>
        </div>
        <div class="cell-fs-12">
            @if (Model.InputSpectra != null && Model.InputSpectra.Count > 0)
            {
                int spectraNum = Model.InputSpectra.Count;
                for (int i = 0; i < spectraNum; i++)
                {
                    <div class="row cell-fs-12 margin-top-8">
                        <span class="label">@Model.InputSpectra[i].Name</span>
                    </div>
                }
            }
            else
            {
                <div class="remark info">
                    <span>@Html.Raw(Info.InfoNoInputSpectraMessage)</span>
                </div>

            }
        </div>
    </div>
</div>