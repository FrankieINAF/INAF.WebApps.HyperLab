@using INAF.WebApps.HyperLab.Resources

<!-- CONTAINER FOR FIT SETTINGS -->
<div id="fitPanel" class="d-none">
    <!-- NUM OF POINTS FOR MISSING POINTS -->
    <div id="fitNumOfPointsValueContainer">
        <label for="inputNumOfPointsForFit">@Html.Raw(Charms.FitNumOfPointsForMissingPointsLabel)</label>
        <input id="inputNumOfPointsForFit"
               type="text"
               data-role="spinner"
               data-buttons-position="right"
               data-cls-spinner="spinner margin-top-4"
               data-step="1"
               data-min-value="3"
               data-max-value="100"
               data-plus-icon="<span class='mif-chevron-thin-up'></span>"
               data-minus-icon="<span class='mif-chevron-thin-down'></span>"
               data-cls-spinner-button-plus="bg-cyan"
               data-cls-spinner-button-minus="bg-cyan"
               data-on-plus-click="onFitNumOfPointsForMissingPointsChange"
               data-on-minus-click="onFitNumOfPointsForMissingPointsChange"
               data-cls-spinner-button="fg-white">
    </div>

    <!-- SEGMENTS (CORE) -->
    <div id="fitSegmentsListContainerCore" class="flex-column margin-top-24 d-none">
        <!-- LIST OF SEGMENTS -->
        <label for="fitSegmentsListCore">@Html.Raw(Charms.FitSegmentsListLabel)</label>
        <div id="fitSegmentsListCore" class="overflow-y-auto overflow-x-hidden" style="height: 55vh"></div>
    </div>

    <!-- SEGMENTS (PRO) -->
    <div id="fitSegmentsListContainerPro" class="flex-column margin-top-24 d-none">
        <!-- LIST OF SEGMENTS -->
        <label for="fitSegmentsListPro">@Html.Raw(Charms.FitSegmentsListLabel)</label>
        <div id="fitSegmentsListPro" class="overflow-y-auto overflow-x-hidden" style="height: 55vh"></div>
    </div>

    <!-- NO SEGMENTS MESSAGE -->
    <div id="noSegmentsMessageContainer" class="margin-top-24">
        <p class="text-just fg-white">@Html.Raw(Charms.FitNoSegmentsAvailableMessage)</p>
    </div>

    <!-- BUTTONS -->
    <div class="row cell-fs-12">
        <!-- BUTTON CREATE CONTINUUM -->
        <button id="fitButtonExecute" class="button primary cycle pointer disabled" title="@Html.Raw(Charms.FitButtonDisabledMessage)" onclick="startRemoveContinuumProcedureAsync()"><span class="mif-checkmark"></span></button>
        <!-- BUTTON SAVE -->
        <button id="fitButtonSave" class="button primary cycle pointer disabled margin-left-16" title="@Html.Raw(Charms.FitButtonSaveLabel)" onclick="saveContinuumRemovedSpectrumProcedureAsync()"><span class="mif-floppy-disk"></span></button>
        <!-- BUTTON REMOVE -->
        <button id="fitButtonRemove" class="button primary cycle pointer disabled margin-left-16" title="@Html.Raw(Charms.FitButtonRemoveLabel)" onclick="removeContinuumRemovedSpectrumProcedure()"><span class="mif-bin"></span></button>
    </div>
</div>

<div id="continuumRemovedDialogRemove" class="dialog" data-role="dialog">
    <div class="dialog-title">@Html.Raw(Charms.ContinuumRemovalManagementTitle)</div>
    <div class="dialog-content">
        <div class="d-flex flex-row">
            <span class="mif-bin mif-5x"></span>
            <div class="d-flex flex-column margin-left-24">
                <!-- MAIN MESSAGE -->
                <div><span>@Html.Raw(Charms.ContinuumRemovalRemoveQuestion)</span></div>
                <!-- MESSAGE REMOVAL OF CHILDREN SPECTRA -->
                <div id="continuumRemovedChildrenRemovalWarning" class="margin-top-16 d-none flex-row">
                    <span class="mif-warning mif-2x fg-lightOrange margin-top-8"></span>
                    <div class="margin-horizontal-8"><span class="text-medium text-secondary text-just">@Html.Raw(Charms.SpectrumChildrenRemovalWarningMessage)</span></div>
                </div>
                <!-- CHECKBOX CLOUD -->
                <div class="d-flex flex-column margin-top-16">
                    <input id="checkboxRemoveContinuumRemovedSpectrumOnCloud"
                           type="checkbox"
                           data-role="checkbox"
                           data-caption="@Html.Raw(Charms.CharmsRemoveOnCloudQuestion)"
                           data-style="2"
                           data-cls-caption="fg-black"
                           data-cls-check="bd-cyan charmsSwitch"
                           data-cls-checkbox="d-none" />
                </div>
            </div>
        </div>
    </div>
    <div class="dialog-actions">
        <button class="button primary" onclick="removeSpectraProcedureAsync(SPECTRUM_TYPE_CONTINUUM_REMOVED, 'continuumRemovedDialogRemove', 'checkboxRemoveContinuumRemovedSpectrumOnCloud')">@Html.Raw(SharedResources.YesLabel)</button>
        <button class="button js-dialog-close">@Html.Raw(SharedResources.NoLabel)</button>
    </div>
</div>

<script type="text/javascript">
    if (isContinuumRemovedDownloadRequested)
        downloadProcessedSpectrumAsync(SPECTRUM_TYPE_CONTINUUM_REMOVED);
        //getSpectrumIdByParentIdAndSpectrumTypeAsync(selectedSpectrumForProcessingId, SPECTRUM_TYPE_CONTINUUM_REMOVED, downloadContinuumRemovalSettingsAsync)
</script>