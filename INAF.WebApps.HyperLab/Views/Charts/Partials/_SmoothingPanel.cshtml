@using INAF.WebApps.HyperLab.Resources
@using Enums = INAF.Libraries.Net.HyperLab.CommonModels.Values;


<!-- CONTAINER FOR SMOOTHING SETTINGS -->
<div id="smoothingPanel" class="row cell-fs-12">
	<!-- DROPDOWN SETTINGS -->
	<div class="d-flex flex-row margin-vertical-4">
		<button id="smoothingSettings" class="button cycle bg-transparent bg-cyan-hover pointer" onclick="toggleDropDown('smoothingSettingsDropdown')"><span class="mif-cogs mif-2x fg-white"></span></button>
		<span class="text-secondary margin-left-8 margin-top-4">@Html.Raw(Charms.SmoothingSettingsLabel)</span>
	</div>
	<div class="pos-relative">
		<div id="smoothingSettingsDropdown"
			 class="fg-white"
			 data-role="dropdown"
			 data-no-close="true"
			 data-toggle-element="#smoothingSettings">
			<!-- SET VARIABLE TO AUTOMATICALLY SAVE SEGMENTS SETTINGS ON CLOUD AFTER EACH VALUE CHANGES -->
			<div class="row cell-fs-12 margin-vertical-4">
				<input id="charmsSwitchAutoSaveSmoothingSegments"
					   type="checkbox"
					   data-role="switch"
					   data-caption="@Html.Raw(Charms.SmoothingAutoSaveSegmentsLabel)"
					   data-cls-switch="charmsSwitch"
					   data-cls-caption="fg-white"
					   data-cls-check="bd-cyan charmsSwitch">
			</div>

			<div id="charmsSwitchAutoSaveSmoothingSegmentsBubble" speech-bubble pleft atop style="--bbColor:#f05142; z-index: 10; position: absolute; top: 35px; left: 50px; display: none">
				<span>@Html.Raw(Charms.SmoothingAutoSaveSegmentsMessage)</span>
			</div>

			<!-- BUTTON FOR MANUALLY SAVING SEGMENTS SETTINGS -->
			<div class="row cell-fs-12 margin-vertical-4">
				<button id="smoothingButtonSaveSegments" class="button primary cycle pointer margin-left-4" title="@Html.Raw(Charms.SmoothingSaveSegmentsLabel)" onclick="saveSmoothingSettingsAsync(BY_SEGMENTS);return false"><span class="mif-floppy-disk"></span></button>
				<span class="margin-left-4">@Html.Raw(Charms.SmoothingSaveSegmentsLabel)</span>
			</div>
		</div>
	</div>

	<!-- DIV FOR SELECTED SRC SPECTRUM TYPE -->
	<div id="srcSpectrumType" class="row cell-fs-12">
		<p class="text-secondary">@Html.Raw(Charms.SmoothingSrcSpectrumTypeLabel)</p>
		<div id="srcSpectrumTypeListContainer" class="d-none">
			<select id="srcSpectrumTypeList" data-role="select" data-on-change="onSrcSpectrumTypeSelected">
				<option value="@{@((int)Enums.Enums.SpectrumType.Aligned);}">@Enums.Enums.SpectrumType.Aligned.ToString()</option>
				<option value="@{@((int)Enums.Enums.SpectrumType.ContinuumRemoved);}">@Enums.Enums.SpectrumType.ContinuumRemoved.ToString()</option>
			</select>
		</div>
		<p id="smoothingSrcSpectrumType" class="text-bold d-none"></p>
	</div>

	<!-- TABS FOR SMOOTHING TYPE SELECTION -->
	<div class="row cell-fs-12">
		<ul id="smoothingTypeTabs"
			data-role="tabs"
			data-app-bar="false"
			data-expand="true"
			data-expand-point="fs"
			data-cls-tabs="tabs-list flex-justify-center">
			<li><a id="bysegmentstitle" href="#bysegmentsoptions">@Html.Raw(Charms.SmoothingBySegmentsTabTitle)</a></li>
			<li><a id="wholespectrum" href="#wholespectrumoptions">@Html.Raw(Charms.SmoothingWholeSpectrumTabTitle)</a></li>
		</ul>
	</div>
	<div class="row cell-fs-12">
		<!-- ICONS SAVED ON CLOUD -->
		<div id="smoothedBySegmentsSavedOnCloud" class="margin-left-4 margin-vertical-8" style="display: none">
			<div><span id="smoothedBySegmentsCloudIcon" class="mif-cloud-download mif-2x fg-cyan pointer" title="@Html.Raw(Charms.CharmsCloudDownloadLabel)" onclick="downloadSmoothedBySegmentsSpectrumProcedure()"></span></div>
			<div><span id="smoothedBySegmentsCloudText" class="margin-left-8 text-small margin-top-4">@Html.Raw(Charms.CharmsAlreadySavedOnCloudMessage)</span></div>
		</div>

		<!-- BY SEGMENTS -->
		<div id="bysegmentsoptions">
			<div class="row cell-fs-12">
				<span class="text-secondary">@Html.Raw(Charms.SmoothingTabBySegmentsOptionsLabel)</span>
			</div>

			<!-- OPTIONS FOR SMOOTHING -->
			<div><span id="smoothingBySegmentsOptionsContainer" class="text-bold text-secondary"></span></div>

			<!-- BUTTONS -->
			<div class="row cell-fs-12">
				<!-- BUTTON SMOOTH -->
				<button id="smoothingBySegmentsButtonExecute" class="button primary cycle pointer disabled large" title="@Html.Raw(Charms.SmoothingButtonExecuteLabel)" onclick="applySmoothingAsync(BY_SEGMENTS)"><span class="mif-checkmark"></span></button>
				@if (Model.IsUserAuthenticated)
				{
					<!-- BUTTON SAVE -->
					<button id="smoothingBySegmentsButtonSave" class="button primary cycle pointer disabled large margin-left-16" title="@Html.Raw(Charms.SmoothingButtonSaveLabel)" onclick="saveSmoothedSpectrumProcedureAsync(BY_SEGMENTS)"><span class="mif-floppy-disk"></span></button>
				}
				<!-- BUTTON REMOVE -->
				<button id="smoothingBySegmentsButtonRemove" class="button primary cycle pointer disabled large margin-left-16" title="@Html.Raw(Charms.SmoothingButtonRemoveLabel)" onclick="removeSmoothedSpectrumProcedure(BY_SEGMENTS)"><span class="mif-bin"></span></button>
				<!-- BUTTON DOWNLOAD -->
				<div id="smoothingBySegmentsButtonDownload" class="multi-action d-none margin-left-16">
					<button class="action-button rotate-minus primary fg-white"
							onclick="$(this).toggleClass('active')">
						<span class="icon"><span class="mif-file-download"></span></span>
					</button>
					<ul class="actions drop-bottom">
						<li class="bg-cyan" title="@Html.Raw(Charms.SmoothingButtonDownloadAsCsvLabel)" onclick="downloadSmoothedSpectrumAsCsvAsync()">
							<p class="text-small fg-white text-center text-bold">@Html.Raw(Charms.DownloadAsCSVLabel)</p>
						</li>
						<li class="bg-cyan" title="@Html.Raw(Charms.SmoothingButtonDownloadAsXmlLabel)" onclick="downloadSmoothedSpectrumAsXmlAsync()">
							<p class="text-small fg-white text-center text-bold">@Html.Raw(Charms.DownloadAsXMLLabel)</p>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- WHOLE SPECTRUM -->
		<div id="wholespectrumoptions">
			<div class="row cell-fs-12">
				<span class="text-secondary">@Html.Raw(Charms.SmoothingTabByWholeSpectrumOptionsLabel)</span>
			</div>

			<!-- OPTIONS FOR SMOOTHING -->
			<div><span id="smoothingByWholeSpectrumOptionsContainer" class="text-bold text-secondary"></span></div>

			<!-- BUTTONS -->
			<div class="row cell-fs-12">
				<!-- BUTTON SMOOTH -->
				<button id="smoothingByWholeSpectrumButtonExecute" class="button primary cycle pointer disabled large" title="@Html.Raw(Charms.SmoothingButtonExecuteLabel)" onclick="applySmoothingAsync(BY_WHOLE_SPECTRUM)"><span class="mif-checkmark"></span></button>
				@if (Model.IsUserAuthenticated)
				{
					<!-- BUTTON SAVE -->
					<button id="smoothingByWholeSpectrumButtonSave" class="button primary cycle pointer disabled large margin-left-16" title="@Html.Raw(Charms.SmoothingButtonSaveLabel)" onclick="saveSmoothedSpectrumProcedureAsync(BY_WHOLE_SPECTRUM)"><span class="mif-floppy-disk"></span></button>
				}
				<!-- BUTTON REMOVE -->
				<button id="smoothingByWholeSpectrumButtonRemove" class="button primary cycle pointer disabled large margin-left-16" title="@Html.Raw(Charms.SmoothingButtonRemoveLabel)" onclick="removeSmoothedSpectrumProcedure(BY_WHOLE_SPECTRUM)"><span class="mif-bin"></span></button>
				<!-- BUTTON DOWNLOAD -->
				<div id="smoothingByWholeSpectrumButtonDownload" class="multi-action d-none margin-left-16">
					<button class="action-button rotate-minus primary fg-white"
							onclick="$(this).toggleClass('active')">
						<span class="icon"><span class="mif-file-download"></span></span>
					</button>
					<ul class="actions drop-bottom">
						<li class="bg-cyan" title="@Html.Raw(Charms.SmoothingButtonDownloadAsCsvLabel)" onclick="downloadSmoothedSpectrumAsCsvAsync()">
							<p class="text-small fg-white text-center text-bold">@Html.Raw(Charms.DownloadAsCSVLabel)</p>
						</li>
						<li class="bg-cyan" title="@Html.Raw(Charms.SmoothingButtonDownloadAsXmlLabel)" onclick="downloadSmoothedSpectrumAsXmlAsync()">
							<p class="text-small fg-white text-center text-bold">@Html.Raw(Charms.DownloadAsXMLLabel)</p>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

<div id="smoothedDialogRemove" class="dialog" data-role="dialog">
	<div class="dialog-title">@Html.Raw(Charms.SmoothingManagementTitle)</div>
	<div class="dialog-content">
		<div class="d-flex flex-row">
			<span class="mif-bin mif-5x"></span>
			<div class="d-flex flex-column margin-left-24">
				<div><span>@Html.Raw(Charms.SmoothingRemoveQuestion)</span></div>
				<div class="d-flex flex-column margin-top-16">
					<input id="checkboxRemoveSmoothedSpectrumOnCloud"
						   type="checkbox"
						   data-role="checkbox"
						   data-caption="@Html.Raw(Charms.CharmsRemoveOnCloudQuestion)"
						   data-style="2"
						   data-cls-caption="fg-black"
						   data-cls-check="bd-cyan charmsSwitch" />
				</div>
			</div>
		</div>
	</div>
	<div class="dialog-actions">
		<button class="button primary" onclick="callRemoveSpectraProcedureAsync('smoothedDialogRemove', 'checkboxRemoveSmoothedSpectrumOnCloud')">@Html.Raw(SharedResources.YesLabel)</button>
		<button class="button js-dialog-close">@Html.Raw(SharedResources.NoLabel)</button>
	</div>
</div>

<script type="text/javascript">
	/* enable tab for smoothing spectrum */
	setTabEnabled(2, true);

	/* load elements of panel */
	loadSmoothingPanelValuesAsync();
</script>