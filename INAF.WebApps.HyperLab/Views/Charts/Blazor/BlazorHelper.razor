@using INAF.Libraries.Net.HyperLab.CommonHelpers
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Spectrum.BandAnalysis
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Spectrum.ProcessedSpectraInfo.Smoothing
@using INAF.Libraries.Net.HyperLabCommonHelpers
@using INAF.Libraries.Net.HyperLabCommonHelpers.ProcessingHelpers
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Spectrum
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Spectrum.ProcessedSpectraInfo
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Spectrum.ProcessedSpectraInfo.Alignment
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Spectrum.ProcessedSpectraInfo.ContinuumRemoval
@using INAF.Libraries.Net.Math.Fit.LinerAlgebra;
@using INAF.Libraries.Net.Math.Fit.LinerAlgebra.Models;
@using INAF.Libraries.Net.Math.Models;
@using INAF.Libraries.Net.Math.Simple;
@using INAF.Libraries.Net.Math.Fit.Spline;
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using static INAF.Libraries.Net.HyperLab.CommonModels.Values.Enums
@using static INAF.Libraries.Net.Math.Values.Enums;
@using INAF.Libraries.Net.HyperLab.CommonModels.Extensions;

@inject IServiceProvider serviceProvider
@inject IJSRuntime jsruntime;

@implements IDisposable

@code {
    private DotNetObjectReference<BlazorHelper>? objRef;
    private IJSObjectReference? jsmodule;

    #region interfaces
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            if (jsruntime != null)
                await jsruntime.InvokeAsync<string>("setDotNetHelper", objRef);
        }

        await base.OnAfterRenderAsync(firstRender);

        //Console.WriteLine("OnInitializedAsync completed.");
    }

    public async void Dispose()
    {
        if (objRef != null)
            objRef.Dispose();

        if (jsmodule != null)
            await jsmodule.DisposeAsync();
    }
    #endregion

    #region JSInvokable
    [JSInvokable]
    public int retrieveSpectrumTypeFromString(string spectrumTypeString)
    {
        SpectrumType spectrumType = SpectrumType.None;

        try
        {
            spectrumType = (SpectrumType)System.Enum.Parse(typeof(SpectrumType), spectrumTypeString, ignoreCase: true);
        }
        catch (Exception)
        { }

        return (int)spectrumType;
    }

    #region ALIGNMENT
    [JSInvokable]
    public List<PointModel> normalizePoints(List<PointModel> points,
                                            double refWhiteMaxY,
                                            List<PointModel> refSpectrumPoints)
    {
        var normalizedPoints = new AlignmentHelper().multiplyByRef(points,
                                                                   refWhiteMaxY,
                                                                   refSpectrumPoints);
        return normalizedPoints;
    }

    [JSInvokable]
    public List<PointModel> alignSpectrumPoints(List<PointModel> points,
                                                List<double> separators,
                                                double selectedRefBandXMin,
                                                double selectedRefBandXMax,
                                                bool isXMinLowestBoundary,
                                                bool isXMaxHighestBoundary,
                                                int numOfPointsForAlignment)
    {
        return new AlignmentHelper().alignSegments(points,
                                                   separators.OrderBy(x => x),
                                                   selectedRefBandXMin,
                                                   selectedRefBandXMax,
                                                   isXMinLowestBoundary,
                                                   isXMaxHighestBoundary,
                                                   numOfPointsForAlignment);
    }
    #endregion

    #region FIT
    [JSInvokable]
    public PointModel? calculateMaximumInRange(List<PointModel> points)
    {
        if (points == null || points.Count == 0)
            return null;

        var maxY = points.Max(p => p.Y);
        return points.FirstOrDefault(p => p.Y == maxY);
    }

    [JSInvokable]
    public PointModel calculateMissingPoint(MissingPointPosition missingPointPosition,
                                            List<PointModel> points,
                                            int numOfPointsForMissingPoints)
    {
        var missingPointHelper = serviceProvider.GetRequiredService<MissingPointHelper>();
        return missingPointHelper.calculateMissingPoint(missingPointPosition, points, numOfPointsForMissingPoints);
    }

    [JSInvokable]
    public async Task<ProcessingResult> fitSegmentAsync(List<PointModel> points,
                                                        FitMethodModel fitMethod)
    {
        var fitMethodsHelper = serviceProvider.GetRequiredService<FitMethodsHelper>();
        return await fitMethodsHelper.fitSelectedSegmentAsync(points,
                                                              fitMethod);
    }

    [JSInvokable]
    public ProcessingResult removeContinuum(List<PointModel> points,
                                            List<PointModel> continuumPoints)
    {
        var continuumRemovalHelper = serviceProvider.GetRequiredService<ContinuumRemovalHelper>();
        return continuumRemovalHelper.calculateContinuumRemoved(points,
                                                                continuumPoints);
    }
    #endregion

    #region SMOOTHING
    [JSInvokable]
    public async Task<ProcessingResult> applySmoothingBySegments(List<PointModel> points,
                                                                 List<SegmentSmoothingSettingsModel> settingsModels)
    {
        return await new SmoothingHelper().applySmoothingBySegmentsAsync(points, settingsModels);
    }

    [JSInvokable]
    public async Task<ProcessingResult> applySmoothingByWholeSpectrum(List<PointModel> points,
                                                                      SegmentSmoothingSettingsModel settingsModel)
    {
        return await new SmoothingHelper().applySmoothingToWholeSpectrumAsync(points, settingsModel);
    }

    [JSInvokable]
    public SmoothingSettingsModel? deserializeFromXml(string xml)
    {
        return new XmlSerializationHelper().DeserializeFromXml<SmoothingSettingsModel>(xml);
    }

    [JSInvokable]
    public SpectrumType getDestSpectrumType(SmoothingType smoothingType,
                                            SpectrumType srcSpectrumType)
    {
        return new SmoothingHelper().getDestSpectrumType(smoothingType, srcSpectrumType);
    }

    [JSInvokable]
    public string serializeToXml(SmoothingSettingsModel smoothingSettingsModel)
    {
        return new XmlSerializationHelper().SerializeToXml<SmoothingSettingsModel>(smoothingSettingsModel);
    }
    #endregion

    #region NORMAL FIT
    [JSInvokable]
    public GaussianFitResultModel getAbsorptionBandGaussianFit(double[] xs, double[] ys)
    {
        return new GaussianFitHelper().getInvertedYGaussianFit(xs, ys);
    }
    #endregion

    #region PMIN-PMAX FIT
    [JSInvokable]
    public async Task<PMinPMaxResultModel> getPMinPMaxMaxValueAsync(double[] xs,
                                                                    double[] ys,
                                                                    FitMethodModel fitMethod)
    {
        try
        {
            var pMinPMaxHelper = serviceProvider.GetRequiredService<PMinPMaxHelper>();
            return await pMinPMaxHelper.getPMinPMaxMaxValueAsync(xs, ys, fitMethod);
        }
        catch (global::System.Exception ex)
        {
            System.Console.WriteLine($"Error in getPMinPMaxMaxValueAsync {ex.Message}");
            return new PMinPMaxResultModel();
        }
    }
    #endregion

    #region BAND ANALYSIS
    [JSInvokable]
    public double evaluateBandArea(double[] xs, double[] ys)
    {
        return new BandAnalysisHelper().evaluateBandArea(xs, ys);
    }

    [JSInvokable]
    public FwhmResultModel? evaluateFwhm(double[] xs, double[] ys, int bandCenterX, double bandDepth)
    {
        return new BandAnalysisHelper().evaluateFwhm(xs, ys, bandCenterX, bandDepth);
    }

    [JSInvokable]
    public FwhmResultModel rebuildFwhm(double[] xs, double[] ys, int leftMargin, int rightMargin)
    {
        return new BandAnalysisHelper().rebuildFwhm(xs, ys, leftMargin, rightMargin);
    }

    [JSInvokable]
    public string? getBandAnalysisAsTxt(string filename,
                                        BandAnalysisModel bandAnalysisModel)
    {
        return bandAnalysisModel.ToTxt(filename);
    }

    [JSInvokable]
    public string? getBandAnalysisAsXml(string filename,
                                        BandAnalysisModel bandAnalysisModel)
    {
        return bandAnalysisModel.ToXml(filename);
    }
    #endregion

    #region TO TXT
    [JSInvokable]
    public string? getSpectrumOfTypeAsTxt(string filename,
                                          SpectrumType spectrumType,
                                          List<PointModel> points)
    {
        SpectrumModel spectrumModel = new SpectrumModel(spectrumType, SpectrumLevel.Averaged, filename);
        spectrumModel.Points = points;

        return spectrumModel.ToTxt();
    }
    #endregion

    #region TO XML
    [JSInvokable]
    public string getSpectrumOfTypeAlignedModelAsXml(string filename,
                                                     SpectrumType spectrumType,
                                                     List<PointModel> points,
                                                     AlignmentSettingsModel alignmentSettings,
                                                     ParentFilesModel parentFiles)
    {
        return new SpectrumOfTypeAlignedModel(filename, spectrumType, points, alignmentSettings, parentFiles).ToXmlString();
    }

    [JSInvokable]
    public string getSpectrumOfTypeContinuumRemovedModelAsXml(string filename,
                                                              SpectrumType spectrumType,
                                                              List<PointModel> points,
                                                              ContinuumRemovalSettingsModel continuumRemovalSettings,
                                                              ParentFilesModel parentFiles)
    {
        return new SpectrumOfTypeContinuumRemovedModel(filename, spectrumType, points, continuumRemovalSettings, parentFiles).ToXmlString();
    }

    [JSInvokable]
    public string getSpectrumOfTypeSmoothedModelAsXml(string filename,
                                                      SpectrumType spectrumType,
                                                      List<PointModel> points,
                                                      SmoothingSettingsModel smoothingSettingsModel,
                                                      ParentFilesModel parentFiles)
    {
        return new SpectrumOfTypeSmoothedModel(filename, spectrumType, points, smoothingSettingsModel, parentFiles).ToXmlString();
    }
    #endregion
    #endregion
}
