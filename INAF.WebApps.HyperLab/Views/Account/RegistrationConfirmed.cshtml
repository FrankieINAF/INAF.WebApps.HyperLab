@using INAF.WebApps.HyperLab.Resources
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources

@{
	Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

	ViewBag.Title = "Registration Confirmed";
}

<environment names="Development">
	<link rel="stylesheet" href="~/css/hyperlab/common.css" />
	<link rel="stylesheet" href="~/css/hyperlab/account/login.css" />
	<link rel="stylesheet" href="~/css/hyperlab/account/registrationconfirmed.css" />
</environment>
<environment names="Production">
	<link rel="stylesheet" href="~/css/dist/account/registrationconfirmedbundle.min.css" asp-append-version="true" />
</environment>

<div>
	<div class="d-flex flex-column-fs flex-row-xl">
		<!-- TEXT/IMAGES -->
		@{
			await Html.RenderPartialAsync("Partials/_TextImages");
		}

		<!-- FORM -->
		<div class="col-form-width form-cell-background h-vh-75-fs h-vh-100-xl">
			<div class="outer-div">
				<div class="inner-div bg-white p-6 mx-auto border bd-default win-shadow">
					<p class="text-medium">@Html.Raw(CommonResources.Account.RegistrationConfirmedMessage)</p>
					<p class="text-medium">@Html.Raw(CommonResources.Account.RegistrationConfirmedRedirectMessage)</p>
					<div class="margin-top-24"><span id="countdown">00:10</span></div>
				</div>
			</div>
		</div>
	</div>
</div>

<script type="text/javascript">
	window.onload = function () {
		var countdownDuration = 10; // Countdown duration in seconds (e.g., 5 minutes)
		var display = document.querySelector('#countdown');
		const redirectAction = function() {
		  location.href = "https://hyperlab.iaps.inaf.it/Account/Login"
	  };
		startCountdown(countdownDuration, display, redirectAction);
	};
</script>
