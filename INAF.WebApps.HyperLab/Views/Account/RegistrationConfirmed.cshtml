@using INAF.WebApps.HyperLab.Resources
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources

@{
    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

    ViewBag.Title = "Registration Confirmed";
}

<link rel="stylesheet" href="~/css/hyperlab/account/login.css" />
<link rel="stylesheet" href="~/css/hyperlab/common.css" />
<link rel="stylesheet" href="~/css/hyperlab/account/registrationconfirmed.css" />
<div class="h-vh-100 w-vw-100">
    <div class="row h-vh-100">
        <!-- TEXT/IMAGES -->
        <div class="cell-fs-12 cell-xl-4 h-vh-25-fs h-vh-100-xl">
            <div class="row cell-fs-12 text-center h-25">
                <span class="fg-black display2">@Html.Raw(SharedResources.HyperLabLabel)</span>
            </div>
            <div class="row text-center h-75">
                <div class="cell-fs-6 cell-lg-12 text-center h-50">
                    <img src="~/images/login/em_spectrum_400x400.png" class="spectrum-image" />
                </div>
                <div class="cell-fs-6 cell-lg-12 text-center h-50">
                    <img src="~/images/login/iaps_marchio_full_colorinaf.svg" class="inaf-image" />
                </div>
            </div>
        </div>

        <div class="cell-fs-12 cell-xl-8 form-cell-background h-vh-75-fs h-vh-100-xl">
            <div class="outer-div">
                <div class="inner-div bg-white p-6 mx-auto border bd-default win-shadow">
                    <p class="text-medium">@Html.Raw(CommonResources.Login.RegistrationConfirmedMessage)</p>
                    <p class="text-medium">@Html.Raw(CommonResources.Login.RegistrationConfirmedRedirectMessage)</p>
                    <div class="margin-top-24"><span id="countdown">00:10</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function startCountdown(duration, display) {
        var timer = duration, minutes, seconds;
        var countdownInterval = setInterval(function () {
            minutes = parseInt(timer / 60, 10);
            seconds = parseInt(timer % 60, 10);
    
            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;
    
            display.textContent = minutes + ":" + seconds;
    
            if (--timer < 0) {
                clearInterval(countdownInterval);
                window.location.href = "https://hyperlab.iaps.inaf.it/Account/Login"; // Redirect to your desired page
            }
        }, 1000);
    }

    window.onload = function () {
        var countdownDuration = 10; // Countdown duration in seconds (e.g., 5 minutes)
        var display = document.querySelector('#countdown');
        startCountdown(countdownDuration, display);
    };
</script>
