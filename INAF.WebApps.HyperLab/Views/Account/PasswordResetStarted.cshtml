@using INAF.Libraries.Net.CommonResources
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Helpers
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.CommonWebAppModels.Models.Account
@using INAF.Libraries.Net.HyperLab.CommonModels.Resources
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources

@{
	Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

	ViewBag.Title = Account.PasswordResetStartedPageTitle;
}

<div>
	<div class="d-flex flex-column-fs flex-row-xl">
		<!-- TEXT/IMAGES -->
		@{
			await Html.RenderPartialAsync("Partials/_TextImages");
		}

		<!-- FORM -->
		<div class="col-form-width form-cell-background h-vh-75-fs h-vh-100-xl">
			<!-- MAIN ROW -->
			<div class="row" style="height: 100%; overflow-y: auto">
				<div class="cell-md-2">&nbsp;</div>
				<div class="cell-fs-12 cell-md-8 d-flex">
					<div class="registration-completed-container bg-white p-6 mx-auto border bd-default win-shadow flex-self-center">
						<div class="row cell-fs-12">
							<div class="login-form">
								<!-- MESSAGE -->
								<div class="row cell-fs-12">
									<p class="text-medium">@Html.Raw(Account.PasswordResetStartedTitle)</p>
									<p class="text-normal text-just margin-top-16">@Html.Raw(Account.PasswordResetStartedMessage1)</p>
									<p class="text-normal text-just margin-top-16">@Html.Raw(Account.PasswordResetStartedMessage2)</p>
									<p class="text-normal text-just margin-top-16">@Html.Raw(Account.PasswordResetStartedMessage3)</p>
									<p class="text-normal text-just margin-top-16">@Html.Raw(SharedResources.HyperLabTeamSignature)</p>
								</div>
							</div>
						</div>
						<!-- CONTACT US -->
						@{
							await Html.RenderPartialAsync("Partials/_ContactUs");
						}
					</div>
				</div>
				<div class="cell-md-2">&nbsp;</div>
			</div>
		</div>
	</div>
</div>
<environment names="Development">
	<link rel="stylesheet" href="~/css/hyperlab/common.css" />
	<link rel="stylesheet" href="~/css/hyperlab/account/login.css" />
</environment>
<environment names="Production">
	<link rel="stylesheet" href="~/css/dist/account/loginbundle.min.css" asp-append-version="true" />
</environment>
