@model PasswordResetModel

@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Helpers
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.CommonWebAppModels.Models.Account
@using INAF.Libraries.Net.HyperLab.CommonModels.Resources
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources
@using INAF.Libraries.Net.CommonResources;

@{
    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

    ViewBag.Title = Account.PasswordResetRequestPageTitle;
}

<environment names="Development">
    <link rel="stylesheet" href="~/css/hyperlab/common.css" />
    <link rel="stylesheet" href="~/css/hyperlab/account/login.css" />
</environment>
<environment names="Production">
    <link rel="stylesheet" href="~/css/dist/account/loginbundle.min.css" asp-append-version="true" />
</environment>

<div>
    <div class="d-flex flex-column-fs flex-row-xl">
        <!-- TEXT/IMAGES -->
        @{
            await Html.RenderPartialAsync("Partials/_TextImages");
        }

        <!-- FORM -->
        <div class="col-form-width form-cell-background h-vh-75-fs h-vh-100-xl">
            <!-- FORM ROW -->
            <div class="row" style="height: 100%; overflow-y: auto">
                <div class="cell-sm-0 cell-md-2">&nbsp;</div>
                <div class="cell-sm-12 cell-md-8 d-flex">
                    <div class="registration-container bg-white p-6 mx-auto border bd-default win-shadow flex-self-center">
                        <div class="row cell-fs-12">
                            <p class="text-medium text-center fg-black h6">@Html.Raw(Account.PasswordResetTitle)</p>
                        </div>
                        <div class="row cell-fs-12">
                            <p>@Html.Raw(Account.PasswordResetExecuteMessage)</p>
                        </div>
                        <div class="row cell-fs-12">
                            <div class="registration-form">
                                <form id="formPasswordReset"
                                      method="post"
                                      action="/@GenericHelper.GetControllerName(nameof(AccountController))/@nameof(AccountController.PasswordReset)"
                                      target="_self">
                                    @Html.AntiForgeryToken()
									@Html.HiddenFor(m => m.Email)

                                    <div class="row">
                                        <div class="cell-xs-12">
                                            <p class="margin-top-8">
                                                <span class="text-secondary">@Html.Raw(CommonResources.Login.PasswordRulesMessage1)</span>
                                                <ol class="decimal text-small">
                                                    <li>@Html.Raw(CommonResources.Login.PasswordRulesMessage2)</li>
                                                    <li>@Html.Raw(CommonResources.Login.PasswordRulesMessage3)</li>
                                                    <li>@Html.Raw(CommonResources.Login.PasswordRulesMessage4)</li>
                                                </ol>
                                            </p>
                                            <!-- PASSWORD -->
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.Password,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-key'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Login.PasswordPlaceholder) }
                                                })
                                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- CONFIRM PASSWORD -->
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.ConfirmPassword,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-key'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Login.ConfirmPasswordPlaceholder) }
                                                })
                                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- SUBMIT -->
                                            <div class="form-group mt-10">
                                                <button id="submitButton" class="button">@Html.Raw(SharedResources.SubmitLabel)</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cell-sm-0 cell-md-2">&nbsp;</div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var formPasswordReset = $('#formPasswordReset');
</script>
<!-- SCRIPTS -->
<environment names="Development">
    <script src="~/js/hyperlab/account/passwordresetexecute.js" asp-append-version="true"></script>
</environment>
<environment names="Production">
    <script src="~/js/dist/account/passwordresetexecutebundle.min.js" asp-append-version="true"></script>
</environment>