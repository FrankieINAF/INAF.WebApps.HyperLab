@using Resources = INAF.WebApps.HyperLab.Resources
@using CommonResources = INAF.Libraries.Net.CommonResources

@{
    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

    ViewBag.Title = "HyperLab Registration completed";
}
<environment names="Development">
    <link rel="stylesheet" href="~/css/src/common.css" />
    <link rel="stylesheet" href="~/css/src/account/login.css" />
</environment>
<environment names="Production">
    <link rel="stylesheet" href="~/css/dist/account/loginbundle.min.css" asp-append-version="true" />
</environment>

<div>
    <div class="d-flex flex-column-fs flex-row-xl">
        <!-- TEXT/IMAGES -->
        @{
            await Html.RenderPartialAsync("Partials/_TextImages");
        }

        <div class="col-form-width form-cell-background h-vh-75-fs h-vh-100-xl">
            <!-- MAIN ROW -->
            <div class="row" style="height: 100%; overflow-y: auto">
                <div class="cell-md-2">&nbsp;</div>
                <div class="cell-fs-12 cell-md-8 d-flex">
                    <div class="registration-completed-container bg-white p-6 mx-auto border bd-default win-shadow flex-self-center">
                        <div class="row cell-fs-12">
                            <div class="login-form">
                                <!-- MESSAGE -->
                                <div class="row cell-fs-12">
                                    <p class="text-medium">@Html.Raw(CommonResources.Account.LoginConfirmationRequiredTitle)</p>
                                    <p class="text-normal text-just margin-top-16">@Html.Raw(CommonResources.Account.LoginConfirmationRequiredMessage1)</p>
                                    <p class="text-normal text-just margin-top-16">@Html.Raw(CommonResources.Account.LoginConfirmationRequiredMessage2)</p>
                                    <p class="text-normal text-just margin-top-16">@Html.Raw(Resources.SharedResources.HyperLabTeamSignature)</p>
                                </div>
                                <!-- BUTTON TO LOGIN  -->
                                <div class="row cell-fs-12 margin-top-8 d-flex flex-justify-center">
                                    <button class="button primary cycle" onclick="navigateTo('/Account/Login')" title="@Html.Raw(CommonResources.Account.NavigateToLoginMessage)">
                                        <span class="mif-arrow-right" />
                                    </button>
                                    <span class="margin-left-16 margin-top-4">@Html.Raw(CommonResources.Account.NavigateToLoginMessage)</span>
                                </div>
                            </div>
                        </div>
                        <!-- CONTACT US -->
                        @{
                            await Html.RenderPartialAsync("Partials/_ContactUs");
                        }
                    </div>
                </div>
                <div class="cell-md-2">&nbsp;</div>
            </div>
        </div>
    </div>
</div>