@model RegistrationModel

@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Helpers
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.CommonResources;
@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.CommonWebAppModels.Models.Account
@using INAF.Libraries.Net.HyperLab.CommonModels.Resources
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources

@{
    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

	ViewBag.Title = Account.RegistrationPageTitle;

    var password = nameof(RegistrationModel.Password);
}

<environment names="Development">
    <link rel="stylesheet" href="~/css/src/common.css" />
    <link rel="stylesheet" href="~/css/src/account/confirmationcompleted.css" />
    <link rel="stylesheet" href="~/css/src/account/login.css" />
</environment>
<environment names="Production">
    <link rel="stylesheet" href="~/css/dist/account/loginbundle.min.css" asp-append-version="true" />
</environment>

<div>
    <div class="d-flex flex-column-fs flex-row-xl">
        <!-- TEXT/IMAGES -->
        @{
            await Html.RenderPartialAsync("Partials/_TextImages");
        }

        <!-- FORM -->
        <div class="col-form-width form-cell-background h-vh-75-fs h-vh-100-xl">
            <!-- MAIN ROW -->
            <div class="row" style="height: 100%; overflow-y: auto">
                <div class="cell-sm-0 cell-md-2">&nbsp;</div>
                <div class="cell-sm-12 cell-md-8 d-flex">
                    <div class="registration-container bg-white p-6 mx-auto border bd-default win-shadow flex-self-center">
                        <div class="row cell-fs-12">
                            <div class="registration-form">
                                <form id="formRegistration"
                                      method="post"
                                      action="/@GenericHelper.GetControllerName(nameof(AccountController))/@nameof(AccountController.Registration)"
                                      target="_self">
                                    <span class="text-medium text-center fg-black h6">@Html.Raw(CommonResources.Account.RegistrationTitle)</span>
                                    @* <hr class="thin mt-4 mb-4 bg-white"> *@

                                    @Html.AntiForgeryToken()

                                    <div class="row">
                                        <div class="col-xs-12">
                                            <!-- NAME -->
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.Name,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-pencil'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Account.NamePlaceholder) },
                                                })
                                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- LASTNAME -->
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.LastName,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-pencil'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Account.LastNamePlaceholder) },
                                                })
                                                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- USERNAME -->
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.Email,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-envelop'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Account.EmailPlaceholder) },
                                                })
                                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                            </div>

                                            <p class="margin-top-8">
                                                <span class="text-secondary">@Html.Raw(CommonResources.Account.PasswordRulesMessage1)</span>
                                                <ol class="decimal text-small">
                                                    <li>@Html.Raw(CommonResources.Account.PasswordRulesMessage2)</li>
                                                    <li>@Html.Raw(CommonResources.Account.PasswordRulesMessage3)</li>
                                                    <li>@Html.Raw(CommonResources.Account.PasswordRulesMessage4)</li>
                                                </ol>
                                            </p>
                                            <!-- PASSWORD -->
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.Password,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-key'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Account.PasswordPlaceholder) }
                                                })
                                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- CONFIRM PASSWORD -->
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.ConfirmPassword,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-key'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Account.ConfirmPasswordPlaceholder) }
                                                })
                                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger"})
                                            </div>
                                            <!-- SUBMIT + REMEMBER ME-->
                                            <div class="form-group mt-10 d-flex flex-justify-center">
                                                <button id="submitButton" class="image-button primary">
                                                    <span class="mif-checkmark icon"></span>
                                                    <span class="caption">@Html.Raw(SharedResources.SubmitLabel)</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cell-sm-0 cell-md-2">&nbsp;</div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var formRegistration = $('#formRegistration');
    var password = '@password';
</script>
<!-- SCRIPTS -->
<environment names="Development">
    <script src="~/js/src/account/registration.js" asp-append-version="true"></script>
</environment>
<environment names="Production">
    <script src="~/js/dist/account/registrationbundle.min.js" asp-append-version="true"></script>
</environment>