@model LoginModel

@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Helpers
@using INAF.Libraries.Net.CommonWebAppModels.Models.Account
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.HyperLab.CommonModels.Resources
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources

@{
    Layout = "~/Views/Shared/_LayoutNoNavigation.cshtml";

    ViewBag.Title = "Login";

    int confirmation = ViewBag?.Confirmation ?? 0;
    string returnUrl = ViewBag?.ReturnUrl ?? string.Empty;
}
<environment names="Development">
    <link rel="stylesheet" href="~/css/src/hyperlab/common.css" />
    <link rel="stylesheet" href="~/css/src/hyperlab/account/login.css" />
</environment>
<environment names="Production">
    <link rel="stylesheet" href="~/css/dist/account/loginbundle.min.css" asp-append-version="true" />
</environment>

<div>
    <div class="d-flex flex-column-fs flex-row-xl">
        <!-- TEXT/IMAGES -->
        @{
            await Html.RenderPartialAsync("Partials/_TextImages");
        }

        <!-- FORM -->
        <div class="form-cell-background col-form-width h-vh-75-fs h-vh-100-xl">
            <!-- LOGIN ROW -->
            <div class="row" style="height: 100%; overflow-y: auto">
                <div class=" cell-sm-0 cell-md-2">&nbsp;</div>
                <div class="cell-sm-12 cell-md-8 d-flex">
                    <div class="login-container bg-white mx-auto border bd-default win-shadow flex-self-center">
                        <div class="row cell-fs-12">
                            <h2 class="text-medium text-center fg-black">@Html.Raw(CommonResources.Login.LoginTitle)</h2>
                            <hr class="thin mt-4 mb-4 bg-white">
                            <!-- LOGIN MESSAGE ROW -->
                            <div class="row cell-fs-12 d-flex flex-justify-center">
                                <div><span class="margin-left-24 text-secondary text-center fg-black">@Html.Raw(CommonResources.Login.LoginMessage)</span></div>
                            </div>
                            <div class="login-form">
                                <form id="formLogin"
                                      method="post"
                                      action="/@GenericHelper.GetControllerName(nameof(AccountController))/@nameof(AccountController.Login)"
                                      target="_self">


                                    @Html.AntiForgeryToken()

                                    <input type="hidden" id="ReturnUrl" name="ReturnUrl" value="@returnUrl" />

                                    <div class="row loginRowsDivider">
                                        <div class="cell-fs-12">
                                            <!-- USERNAME -->
                                            <div class="form-group">
                                                @Html.TextBoxFor(m => m.UserName,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-envelop'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Login.LoginUsernamePlaceholder) },
                                                })
                                                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- PASSWORD -->
                                            <div class="form-group">
                                                @Html.PasswordFor(m => m.Password,
                                                         new Dictionary<string, object> {
                                                { "data_role", "input" },
                                                { "data-prepend", "<span class='mif-key'>" },
                                                { "data-validate", "required" },
                                                { "placeholder", Html.Raw(CommonResources.Login.PasswordPlaceholder) }
                                                })
                                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                            </div>
                                            <!-- SUBMIT + REMEMBER ME-->
                                            <div class="row margin-top-32">
                                                <div class="d-none-fs cell-sm-2">&nbsp;</div>
                                                <div class="cell-fs-8 cell-sm-8 d-flex flex-justify-center">
                                                    <div>
                                                        <button id="submitButton" class="image-button primary">
                                                            <span class="mif-checkmark icon"></span>
                                                            <span class="caption">@Html.Raw(SharedResources.SubmitLabel)</span>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="cell-fs-4 cell-sm-2">
                                                    @Html.CheckBoxFor(m => m.RememberMe, new Dictionary<string, object> { { "data-role", "checkbox" }, { "class", "place-right" }, { "data-caption", @Html.Raw(CommonResources.Login.RememberMeLabel) }, { "id", "checkboxRememberMe" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <!-- SIGN UP ROW -->
                        <div class="row cell-fs-12 d-flex flex-justify-center">
                            <div><span class="text-secondary text-center fg-black">@Html.Raw(CommonResources.Login.RegistrationMessage)</span></div>
                        </div>
                        <!-- SIGN IN ROW-->
                        <div class="row">
                            <div class="cell-fs-12 d-flex flex-justify-around">
                                <!-- BUTTON REGISTRATION -->
                                <div>
                                    <button class="image-button success" onclick="navigateTo('/@GenericHelper.GetControllerName(nameof(AccountController))/@nameof(AccountController.Registration)')">
                                        <span class="mif-user-check icon"></span>
                                        <span class="caption">@Html.Raw(CommonResources.Login.RegistrationLabel)</span>
                                    </button>
                                </div>
                                <!-- BUTTON ORCID -->
                                @* <div>
                                    <button class="image-button icon-right success" onclick="initAuth()">
                                        <span class="icon">ID</span>
                                        <span class="caption">ORC</span>
                                    </button>
                                </div> *@
                            </div>
                        </div>
                        <!-- FORGOT PASSWORD -->
                        <div class="row margin-horizontal-32">
                            <div class="cell-fs-12 d-flex">
                                <div><span class="mif mif-key"></span></div>
                                <div class="margin-left-8"><a href="/Account/PasswordResetRequest" class="text-small">forgot password?</a></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cell-sm-0 cell-md-2">&nbsp;</div>
            </div>
        </div>
    </div>
</div>

<!-- CONFIRMATION COMPLETED MESSAGE -->
<div id="confirmationCompletedMessage" class="row w-vw-100 h-vh-100 d-flex d-justify-center confirmation-completed-container display-none-important">
    <div class="confirmation-completed-box padding-horizontal-16 padding-vertical-16">
        <div>
            <span class="text-normal text-just">@Html.Raw(Account.ConfirmationSuccessfullyCompleted)</span>
        </div>

        <div class="margin-top-32" style="float:right">
            <button class="button primary cycle" onclick="setConfirmationCompletedMessageVisibility(false)">
                <span class="mif-cross-light"></span>
            </button>
        </div>
    </div>
</div>

<!-- SCRIPTS -->
<environment names="Development">
    <script src="~/js/src/hyperlab/common.js"></script>
    <script src="~/js/src/hyperlab/account/login.js" asp-append-version="true"></script>
</environment>
<environment names="Production">
    <script src="~/js/dist/account/loginbundle.min.js" asp-append-version="true"></script>
</environment>