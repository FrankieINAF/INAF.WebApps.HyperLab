@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Controllers.Simbio
@using INAF.WebApps.HyperLab.Resources

@{
    ViewBag.Title = SimbioMap.MapPageTitle;

}

<link href="~/lib/openglobus/css/og.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/dist/simbio/map/mapbundle.min.css" asp-append-version="true" />

<div class="container h-100 overflow-x-auto overflow-y-auto">
    <div class="h-100 d-flex flex-column-fs flex-row-lg">
        <!-- SELECTORS -->
        <div id="selectors" class="w-100-fs w-25-lg order-fs-2 order-lg-1">
            <div class="d-flex flex-justify-between-fs flex-column-lg">
                <!-- FEATURES -->
                <div>
                    <div class="d-flex">
                        <div><input id="loadHideFeatures" type="checkbox" onclick="onLoadHideFeaturesClick()" data-role="switch" data-cls-switch="switch-cyan" data-cls-check="bd-cyan" data-on="Load" data-off="Hide"></div>
                        <div class="margin-top-4"><p class="fg-black">@Html.Raw(SimbioMap.FeaturesLabel)</p></div>
                    </div>
                    <div id="featuresDropdown"
                         data-role="dropdown"
                         data-toggle-element="#loadHideFeatures"
                         data-on-drop="openCloseFeaturesDropdown"
                         data-on-up="openCloseFeaturesDropdown">
                        <div class="d-flex flex-column">
                            <p class="fg-black">@Html.Raw(SimbioMap.FeaturesShowHideLabel)</p>
                            <div><input id="showHideFeaturesAll" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-left-48" data-caption="@Html.Raw(SimbioMap.FeatureCategoryAll)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresAlbedo.png"/><input id="showHideFeaturesAlbedos" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryAlbedos)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresCrater.png" /><input id="showHideFeaturesCraters" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryCraters)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresDorsum.png" /><input id="showHideFeaturesDorsa" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryDorsa)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresFossa.png" /><input id="showHideFeaturesFossae" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryFossae)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresMons.png" /><input id="showHideFeaturesMontes" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryMontes)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresPlanitia.png" /><input id="showHideFeaturesPlanitiae" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryPlanitiae)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresRupes.png" /><input id="showHideFeaturesRupes" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryRupes)"></div>
                            <div class="d-flex"><img src="~/images/simbiomap/features/featuresVallis.png" /><input id="showHideFeaturesValles" type="checkbox" data-role="checkbox" data-cls-check="bd-black" data-cls-checkbox="margin-top-8" data-caption="@Html.Raw(SimbioMap.FeatureCategoryValles)"></div>
                        </div>
                    </div>
                </div>
                <hr class="d-none-fs d-block-lg w-100 bg-cyan margin-top-8" />
                <!-- TARGETS -->
                <div class="d-flex flex-column">
                    <!-- SHOW/HIDE -->
                    <div class="d-flex">
                        <div><input id="loadHideTargets" type="checkbox" data-role="switch" data-cls-switch="switch-cyan" data-cls-check="bd-cyan" data-on="Load" data-off="Hide"></div>
                        <div class="margin-top-4"><p class="fg-black">@Html.Raw(SimbioMap.SelectorsShowHideTargets)</p></div>
                    </div>
                    <!-- SEARCH BOX -->
                    <div id="searchTargetInputContainer" class="d-none">
                        <div class="d-flex">
                            <div>
                                <input id="searchTargetInput"
                                       type="text"
                                       placeholder="@Html.Raw(SimbioMap.TargetsSearchTargetLabel)"
                                       data-role="input"
                                       data-search-button="true"
                                       data-search-button-click="custom"
                                       data-on-search-button-click="searchForTarget()"
                                       data-on-clear-click="restoreDefaultVisualization()" />
                            </div>
                            <div>
                                <button class="button cycle dark small outline margin-left-4 margin-top-4" onclick="restoreDefaultVisualization()" title="@Html.Raw(SimbioMap.TargetsRestoreDefaultVisualizationLabel)"><span class="mif-cross-light"></span></button>
                            </div>
                        </div>
                    </div>
                </div>
                <hr class="d-none-fs d-block-lg w-100 bg-cyan margin-top-8" />
                <!-- STPs AND FOOTPRINTS -->
                <div class="d-flex flex-column">
                    <!-- SHOW/HIDE SEARCH BOX -->
                    <div class="d-flex">
                        <div><input id="showHideSearchOfFootprints" type="checkbox" data-role="switch" data-cls-switch="switch-cyan" data-cls-check="bd-cyan" data-on="Show" data-off="Hide"></div>
                        <div class="margin-top-4"><p class="fg-black">@Html.Raw(SimbioMap.SelectorsShowHideSearchOfFootprints)</p></div>
                    </div>
                    <!-- SEARCH BOX -->
                    <div id="selectStpContainer" class="d-none">
                        <select id="selectStp" data-role="select" data-on-item-select="retrieveFootprintsByStpAsync"></select>
                    </div>
                </div>
            </div>
        </div>
        <!-- MAP -->
        <div id="map" class="w-100-fs w-75-lg order-fs-1 order-lg-2"></div>
        <!-- TOOLTIP FOR TARGETS -->
        <div id="targetsTooltip" class="map-target-tooltip d-none flex-column">
            <div class="d-flex">
                <div><img src="~/images/simbiomap/target.png" /></div>
                <div>
                    <div><p id="targetsTooltipContent" class="text-center"></p></div>
                    <div><p class="text-center text-small margin-top-4">@Html.Raw(SimbioMap.TargetTooltipInfo)</p></div>
                </div>
            </div>
        </div>
        <!-- TOOLTIP FOR FEATURES -->
        <div id="featuresTooltip" class="map-feature-tooltip d-none flex-column" style="pointer-events: auto">
            <div class="d-flex">
                <div>
                    <div class="d-flex">
                        <div style="width: 40px"><image id="featureImage" /></div>
                        <div style="width: 120px"><p id="featureName" class="text-center text-bold text-ellipsis margin-top-8"></p></div>
                        <div style="width: 40px" onclick="hideFeatureTooltip()"><span id="featuresTooltipCloseButton" class="mif mif-cross-light pointer margin-top-4 margin-left-16 d-none"></span></div>
                    </div>
                    <div><p id="featureCategory" class="text-left margin-top-4"></p></div>
                    <div><p id="featurePosition" class="text-left margin-top-4"></p></div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- CHART -->
</div>

<div id="charmsSelectedItem" data-role="charms" data-cls-charms="charms-panel" data-position="right" data-on-open="onCharmsSelectedItemOpened()">
    <!-- MAIN BAR -->
    <div style="height: 60px">
        <!-- HIDE-CHARMS BUTTON -->
        <div class="button light cycle outline float-right pointer" title="@Html.Raw(Charms.CharmsHideLabel)" onclick="hideCharmsSelectedItem()">
            <span class="mif-arrow-right"></span>
        </div>
    </div>
    <!-- TARGET INFO -->
    <!-- NAME -->
    <div class="row cell-12">
        <p id="targetName" class="fg-white text-center text-leader"></p>
    </div>
    <hr class="thin mt-4 mb-4 bg-white">
    <!-- OBSERVED BY INFO -->
    <div class="row cell-12">
        <span class="fg-white text-center">@Html.Raw(SimbioMap.TargetObservedByLabel)</span>
        <span id="observedBy" class="fg-white text-center"></span>
    </div>
    <hr class="thin mt-4 mb-4 bg-white">
    <!-- OBSERVATION INFO -->
    <div class="row cell-12">
        <p class="fg-white text-center text-leader2">@Html.Raw(SimbioMap.TargetObservationInfoLbel)</p>
    </div>
    <div class="row cell-12">
        <span class="fg-white text-center">@Html.Raw(SimbioMap.TargetCategoryLabel)</span>
        <span id="category" class="fg-white text-center"></span>
    </div>
    <div class="row cell-12">
        <span class="fg-white text-center">@Html.Raw(SimbioMap.TargetObservationModeLabel)</span>
        <span id="observationMode" class="fg-white text-center"></span>
    </div>
    <div class="row cell-12">
        <span class="fg-white text-center">@Html.Raw(SimbioMap.TargetObservationTypeLabel)</span>
        <span id="observationType" class="fg-white text-center"></span>
    </div>
    <hr class="thin mt-4 mb-4 bg-white">
    <!-- GEOM INFO -->
    <div class="row cell-12">
        <p class="fg-white text-center text-leader2">@Html.Raw(SimbioMap.TargetGeomInfoLabel)</p>
    </div>
    <div class="row cell-12 d-flex flex-column">
        <!-- LAT -->
        <div class="d-flex flex-row">
            <div>
                <span>@Html.Raw(SimbioMap.TargetLatRangeLabel)</span>
                <span id="latRange"></span>
            </div>
            <div class="margin-left-16">
                <span>@Html.Raw(SimbioMap.TargetLatCenterLabel)</span>
                <span id="latCenter"></span>
            </div>

        </div>
        <!-- LON -->
        <div class="d-flex flex-row margin-top-16">
            <div>
                <span>@Html.Raw(SimbioMap.TargetLonRangeLabel)</span>
                <span id="lonRange"></span>
            </div>
            <div class="margin-left-16">
                <span>@Html.Raw(SimbioMap.TargetLonCenterLabel)</span>
                <span id="lonCenter"></span>
            </div>
        </div>
        <!-- AREA  -->
        <div class="d-flex flex-row margin-top-16">
            <div>
                <span>@Html.Raw(SimbioMap.TargetAreaLabel)</span>
                <span id="area"></span>
            </div>
        </div>
        <!-- COVERAGE  -->
        <div class="d-flex flex-row margin-top-16">
            <div>
                <span>@Html.Raw(SimbioMap.TargetCoveragePercentageLabel)</span>
                <span id="coveragePercentage"></span>
            </div>
        </div>
    </div>
    <hr class="thin mt-4 mb-4 bg-white">
    <!-- OTHER INFO -->
    <div class="row cell-12">
        <span class="fg-white text-center">@Html.Raw(SimbioMap.TargetLiteratureReferenceLabel)</span>
        <a id="litRef" class="fg-white"></a>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_JsCommonSimbio");
}

<script type="text/javascript">
    var footprintsArray = [];

    var selectedTargetName = null;
    var tooltipElement = document.getElementById('tooltip');
</script>
<script type="module" src="~/lib/openglobus/js/og.es.js"></script>
<environment names="Development">
    @* <script type="module" src="~/js/src/simbio/map/mapcommons.js"></script> *@
    <script type="module" src="~/js/src/simbio/map/map.js"></script>
    <script type="module" src="~/js/src/simbio/map/mapfeatures.js"></script>
    <script type="module">
        import {
            hideCharmsSelectedItem,
            onCharmsSelectedItemOpened,
            onFeaturesDropdownOpenClose,
            onLoadHideFeaturesClick,
            restoreDefaultVisualization,
            retrieveFootprintsByStpAsync,
            searchForTarget
        } from '/js/src/simbio/map/map.js';
        /* following lines are required to access imported function by global scope */
        window.hideCharmsSelectedItem = hideCharmsSelectedItem;
        window.onCharmsSelectedItemOpened = onCharmsSelectedItemOpened;
        window.onFeaturesDropdownOpenClose = onFeaturesDropdownOpenClose;
        window.onLoadHideFeaturesClick = onLoadHideFeaturesClick;
        window.restoreDefaultVisualization = restoreDefaultVisualization;
        window.retrieveFootprintsByStpAsync = retrieveFootprintsByStpAsync;
        window.searchForTarget = searchForTarget;

        import { 
            hideFeatureTooltip 
        } from '/js/src/simbio/map/mapfeatures.js';
        /* following lines are required to access imported function by global scope */
        window.hideFeatureTooltip = hideFeatureTooltip;
    </script>
</environment>
<environment names="Production">
    <script type="module" src="~/js/dist/simbio/map/mapbundle.js" asp-append-version="true"></script>
    <script type="module">
        import {
            hideCharmsSelectedItem,
            hideFeatureTooltip,
            onCharmsSelectedItemOpened,
            onFeaturesDropdownOpenClose,
            restoreDefaultVisualization,
            retrieveFootprintsByStpAsync,
            searchForTarget
        } from '/js/dist/simbio/map/mapbundle.js';
        /* following lines are required to access imported function by global scope */
        window.hideCharmsSelectedItem = hideCharmsSelectedItem;
        window.hideFeatureTooltip = hideFeatureTooltip;
        window.onCharmsSelectedItemOpened = onCharmsSelectedItemOpened;
        window.onFeaturesDropdownOpenClose = onFeaturesDropdownOpenClose;
        window.restoreDefaultVisualization = restoreDefaultVisualization;
        window.retrieveFootprintsByStpAsync = retrieveFootprintsByStpAsync;
        window.searchForTarget = searchForTarget;
    </script>
</environment>

