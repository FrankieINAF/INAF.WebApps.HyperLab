@using INAF.WebApps.HyperLab.Resources

<environment names="Development">
    <link rel="stylesheet" href="~/css/hyperlab/hubandchart/share.css" />
</environment>
<environment names="Production">
    <link rel="stylesheet" href="~/css/dist/hyperlab/hubandchart/sharebundle.min.css" asp-append-version="true" />
</environment>
<div id="charmsShare" data-role="charms" data-cls-charms="charms-share-panel" data-position="bottom" data-on-open="onCharmsShareOpen">
    <!-- TITLE + CLOSE BUTTON -->
    <div class="row">
        <div class="cell-fs-2">&nbsp;</div>
        <!-- TITLE -->
        <div class="cell-fs-8">
            <h3 class="text-light text-center">@Html.Raw(CharmsShare.CharmsShareTitle)</h3>
        </div>
        <!-- CLOSE-AND-RESET-CHARMS BUTTON -->
        <div class="cell-fs-2">
            <div onclick="closeCharmsShare()" class="button light cycle outline float-right pointer" title="@Html.Raw(Charms.CharmsHideAndResetLabel)">
                <span class="mif-cross-light"></span>
            </div>
        </div>
    </div>

    <!-- EXPLANATION -->
    <div class="row margin-top-16">
        <div class="cell-fs-12 d-flex">
            <div><span class="mif-info"></span></div>
            <div class="margin-left-16"><p class="text-light text-just">@Html.Raw(CharmsShare.CharmsShareExplanation)</p></div>
        </div>
    </div>

    <!-- NUM OF SHARED SPECTRA -->
    <div class="row cell-fs-12 margin-top-8">
        <p id="numOfSharedSpectraLabel" class="text-light text-center h5"></p>
    </div>

    <!-- SHARE INTERFACE -->
    <div class="row cell-fs-12 margin-top-8">
        <p class="text-light text-just text-small">@Html.Raw(CharmsShare.CharmsShareEnterUsersEmail)</p>
    </div>
    <!-- insert new user -->
    <div class="row margin-top-8">
        <div class="cell-fs-2 cell-md-4">&nbsp;</div>
        <div class="cell-fs-8 cell-md-4 margin-top-8">
            <input id="newUserToShare" type="email" data-role="input" placeholder="@Html.Raw(CharmsShare.CharmsShareInputPlaceholder)" data-prevent-submit="true" data-custom-buttons="shareCustomButtons">
        </div>
        <div>&nbsp;</div>
    </div>
    <!-- activity messages-->
    <div class="row cell-fs-12">
        <div id="newUserToShareActivity" class="d-flex flex-column flex-align-center"></div>
    </div>
    <!-- list of inserted users -->
    <div id="selectedUsersToShareListLabel" class="row cell-fs-12 margin-top-8 d-none">
        <p class="text-center text-light h5">@Html.Raw(CharmsShare.CharmsShareSelectedUsersLabel)</p>
    </div>
    <div class="row margin-top-4">
        <div class="cell-fs-2 cell-md-4">&nbsp;</div>
        <div class="cell-fs-8 cell-md-4">
            <ul id="selectedUsersToShareList" class="overflow-y-auto"></ul>
        </div>
        <div class="cell-fs-2 cell-md-4">&nbsp;</div>
    </div>
    <!-- share button -->
    <div class="row margin-top-8">
        <div class="cell-fs-2 cell-md-4">&nbsp;</div>
        <div class="cell-fs-8 cell-md-4">
            <button id="buttonShareSpectra" class="image-button primary disabled float-right" onclick="shareSpectraAsync()">
                <span class="mif-share icon"></span>
                <span class="caption">@Html.Raw(CharmsShare.CharmsShareButton)</span>
            </button>
        </div>
        <div class="cell-fs-2 cell-md-4">&nbsp;</div>
    </div>
</div>

<script type="text/javascript">
    var CharmsShareCheckUserMessage = "@Html.Raw(CharmsShare.CharmsShareCheckUserMessage)";
    var CharmsShareInvitationNotCreatedErrorMessage = "@Html.Raw(CharmsShare.CharmsShareInvitationNotCreatedErrorMessage)";
    var CharmsShareShareNotCreatedForUserErrorMessage = "@Html.Raw(CharmsShare.CharmsShareShareNotCreatedForUserErrorMessage)";
    var CharmsShareSpectraSharedInfoMessage = "@Html.Raw(CharmsShare.CharmsShareSpectraSharedInfoMessage)";
    var CharmsShareSpectraSharedErrorMessage = "@Html.Raw(CharmsShare.CharmsShareSpectraSharedErrorMessage)";
    var CharmsShareUserNotExistantMessage = "@Html.Raw(CharmsShare.CharmsShareUserNotExistantMessage)";

    var shareCustomButtons = [
        {
            html: "<span class='mif-add'></span>",
            cls: 'primary',
            onclick: function() {
                checkUserAsync();
            }
        },
         {
            html: "<span class='mif-user'></span>",
        }
    ]

    $(function() {
        $('#newUserToShare').on('keydown', function(evt) {
            if (evt.originalEvent.code == 'Enter')
                checkUserAsync();
        });
    });
</script>
