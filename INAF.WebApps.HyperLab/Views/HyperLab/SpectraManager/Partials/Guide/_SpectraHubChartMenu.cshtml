@using INAF.WebApps.HyperLab.Resources;

<div id="generalInfo" class="margin-horizontal-16">
    <!-- LEGEND -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36" onclick="showGuideLegend()"><span class="mif-list"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonLegendLabel)</p>
        </div>
    </div>
    <!-- BACK TO SEARCH -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36 disabled"><span class="mif-cross-light"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonBackToSearchLabel)</p>
        </div>
    </div>
    <!-- DATA ANALYSIS -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36"><span class="mif-magic-wand" onclick="showGuideMagicWand()"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonWizardLabel)</p>
        </div>
    </div>
    <!-- COLOR PICKER -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36"><span class="mif-palette" onclick="showGuideColorPicker()"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonColorPickerLabel)</p>
        </div>
    </div>
    <!-- MESSAGES -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36"><span class="mif-chat" onclick="showGuideMessages()"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonMessagesLabel)</p>
        </div>
    </div>
    <!-- FULL SCREEN -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36 disabled"><span class="mif-enlarge"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonEnterFullScreenLabel)</p>
        </div>
    </div>
</div>