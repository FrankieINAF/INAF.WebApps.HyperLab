@using INAF.WebApps.HyperLab.Resources;

<!-- TITLE + CLOSE BUTTON -->
<div class="row">
    <div class="cell-fs-2">&nbsp;</div>
    <div class="cell-fs-8 text-center"><span class="text-leader fg-white">@Html.Raw(Guide.SpectraHubTitle)</span></div>
    <div class="cell-fs-2"><button id="buttonCloseGuide" class="button light cycle outline pointer fg-white margin-right-8" style="float: right" onclick="closeGuide()"><span class="mif-cross-light"></span></button></div>
</div>
<!-- GENERAL INFO -->
<div class="row">
    <div class="cell-fs-12 text-center">
        <p class="text-normal text-just fg-white margin-top-16 margin-horizontal-16">@Html.Raw(Guide.SpectraHub1)</p>
        <p class="text-normal text-just fg-white margin-top-4 margin-horizontal-16">@Html.Raw(Guide.SpectraHub2)</p>
        <p class="text-normal text-just fg-white margin-top-4 margin-horizontal-16">@Html.Raw(Guide.SpectraHub3)</p>
        <p class="text-normal text-just fg-white margin-top-8 margin-horizontal-16">@Html.Raw(Guide.SpectraHub4)</p>
    </div>
</div>
<!-- BUTTONS -->
<div class="margin-top-16">
    <!-- SIMPLE SEARCH -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36" onclick="showGuideSimpleSearch()"><span class="mif-search"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonSpectraHubSimpleSearchLabel)</p>
        </div>
    </div>
    <!-- COMPLEX SEARCH -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36" onclick="showGuideComplexSearch()"><span class="mif-search"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonSpectraHubComplexSearchLabel)</p>
        </div>
    </div>
    <!-- SEARCHES RESULTS -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36" onclick="showGuideSearchResults()"><span class="mif-list"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonSpectraHubSearchResultsLabel)</p>
        </div>
    </div>
    <!-- LOAD SEARCH -->
    <div class="row">
        <div class="cell-fs-12 d-flex">
            <button class="button light cycle outline min-width-36" onclick="showGuideLoadLocalFiles()"><span class="mif-folder-open"></span></button>
            <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.ButtonSpectraHubLoadLocalFilesLabel)</p>
        </div>
    </div>
</div>