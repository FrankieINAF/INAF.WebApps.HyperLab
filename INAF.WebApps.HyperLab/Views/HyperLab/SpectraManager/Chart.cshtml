@model ChartPageModel

@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Pages
@using INAF.Libraries.Net.HyperLab.CommonModels.Models.Searches
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Controllers.HyperLab
@using INAF.WebApps.HyperLab.Resources
@using INAF.WebApps.HyperLab.Views.HyperLab.Charts.Blazor

@{
    ViewBag.Title = Search.ChartPageTitle;

    IEnumerable<int>? spectraIds = null;
    if (Model.SelectedSpectraModel != null && Model.SelectedSpectraModel.Ids != null && Model.SelectedSpectraModel.Ids.Any())
    {
        spectraIds = Model.SelectedSpectraModel.Ids;
    }

    bool IsSLabDataManagerAllowed = false;
    if (Model.Permissions != null && Model.Permissions.Any())
    {
        IsSLabDataManagerAllowed = Model.Permissions.Any(p => p.Id == (int)INAF.WebApps.HyperLab.Values.Enums.Permissions.SLabManager);
    }

    var UrlHub = $"/{GenericHelper.GetControllerName(nameof(SpectraManagerController))}/{nameof(SpectraManagerController.Hub)}";
}

<link rel="stylesheet" href="~/css/dist/errorpagebundle.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dist/devextreme/devextremebundle.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dist/hyperlab/hubandchart/hubandchartbundle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dist/jqueryuibundle.min.css" asp-append-version="true" />

<!-- CHARTS -->
<div id="charts" class="h-100 overflow-x-auto overflow-y-auto" style="max-width: 100%"></div>

<!-- JOYSTICK -->
<div id="joystickMainContainer" class="joystick-main-container flex-column d-none" style="top: calc(100% - 46px)">
    <!-- LITTLE PANEL FOR SHOWING/HIFING JOYSTICK -->
    <div class="row" style="height: 46px">
        <div class="cell-fs-4">&nbsp;</div>
        <div class="cell-fs-4 semitransparent-black">
            <div class="row">
                <div class="cell-fs-4 d-flex flex-justify-center"><img src="~/images/chart/joystick.png" width="20" height="20" /></div>
                <div class="cell-fs-4 d-flex flex-justify-center"><span id="joystickVisualizationIcon" class="mif mif-expand-less fg-white pointer" onclick="toggleJoystickContainer()"></span></div>
                <div class="cell-fs-4">&nbsp;</div>
            </div>
        </div>
        <div class="cell-fs-4">&nbsp;</div>
    </div>
    <!-- MAIN PANEL -->
    <div class="row semitransparent-black" style="height: 220px">
        <div class="cell-fs-2 cell-md-4 d-flex flex-justify-center">
            <div id="chartMagnifier" style="margin: auto"></div>
        </div>
        <div class="cell-fs-8 cell-md-6">
            <!-- TOP BUTTON -->
            <div class="row cell-fs-12 d-flex flex-justify-center">
                <span id="buttonMovePointerUp" class="mif mif-chevron-right mif-4x fg-white pointer" style="display: inline-block; transform: rotate(-90deg);" onclick="movePointerUp(1)"></span>
            </div>
            <!-- JOYSTICK + LEFT/RIGHT BUTTONS -->
            <div class="row">
                <!-- LEFT BUTTON -->
                <div class="cell-fs-3 d-flex flex-column flex-justify-center">
                    <span id="buttonMovePointerLeft" class="mif mif-chevron-left mif-4x fg-white margin-right-16 pointer" onclick="movePointerLeft(1)"></span>
                </div>
                <!-- JOYSTICK -->
                <div class="cell-fs-6">
                    <canvas id="joystick" height="100" width="100" style="position:relative; left: calc(50% - 50px); z-index:20"></canvas>
                </div>
                <!-- RIGHT BUTTON -->
                <div class="cell-fs-3 d-flex flex-column flex-justify-center">
                    <span id="buttonMovePointerRight" class="mif mif-chevron-right mif-4x fg-white pointer" onclick="movePointerRight(1)"></span>
                </div>
            </div>
            <!-- BOTTOM BUTTON -->
            <div class="row cell-fs-12 d-flex flex-justify-center">
                <span id="buttonMovePointerDown" class="mif mif-chevron-right mif-4x fg-white pointer" style="display: inline-block; transform: rotate(90deg);" onclick="movePointerDown(1)"></span>
            </div>
        </div>
        <div class="cell-fs-2 cell-md-2 d-flex flex-column">
            <!-- POSITION -->
            <div class="d-flex flex-column">
                <div><span class="text-secondary fg-white text-bold">@Html.Raw(Charts.JoystickPositionLabel)</span></div>
                <div><span id="joystickPositionValue" class="text-secondary fg-white"></span></div>
            </div>
            <!-- BUTTON ADD POINT FOR FIT -->
            <div style="height: 50%; margin: auto" class="d-flex flex-column flex-justify-center">
                <button id="buttonJoystickAddFitPoint" class="button primary cycle large pointer disabled" title="@Html.Raw(Charts.JoystickButtonAddFitPointTitle)" onclick="addFitPoint()"><span class="mif-target"></span></button>
            </div>

            <!-- BUTTON RESET POINTER POSITION -->
            <div style="height: 50%" class="d-flex flex-justify-center">
                <button id="buttonResetPointerPosition" class="button primary cycle large pointer" title="@Html.Raw(Charts.JoystickButtonResetPointerPositionTitle)" onclick="resetPointerPosition()"><span class="mif-refresh"></span></button>
            </div>
        </div>
    </div>
</div>

<!-- MOBILE POINTER MOVED BY JOYSTICK -->
<div id="targetPointer" class="d-none" style="left: calc(50% - 25px);">
    <div id="centerDotExternal" class="center-dot-external">
        <div id="centerDotMiddle" class="center-dot-middle">
            <div id="centerDotInternal" class="center-dot-internal"></div>
        </div>
    </div>
</div>

<!-- CHARMS - COLOR SELECTOR -->
<div id="charmsColorSelector" data-role="charms" data-cls-charms="charms-color-selector-panel" data-position="top" data-on-open="createSpectraTypesColorList()">
    <!-- TITLE + BUTTON-->
    <div class="d-flex flex-justify-between">
        <div>
            <button class="button light cycle outline float-right pointer" onclick="toggleCharmsColorSelector()">
                <span class="mif-arrow-up mif-2x"></span>
            </button>
        </div>
        <div class="text-leader">@Html.Raw(CharmsColorSelector.ColorSelectorTitle)</div>
        <div>&nbsp;</div>
    </div>
    <!-- ASSOCIATION + COLOR-SELECTOR -->
    <div class="row">
        <!-- ASSOCIATION SPECTRUMTYPE - COLOR -->
        <div class="cell-fs-12 cell-md-6 d-flex flex-justify-center charms-color-selector-column">
            <!-- LABEL + LIST -->
            <div class="row">
                <!-- LABEL -->
                <div class="cell-fs-12 cell-md-6">
                    <div>
                        <p class="text-medium margin-bottom-8">@Html.Raw(CharmsColorSelector.ColorSelectorLabel1)</p>
                        <ol>
                            <li class="margin-vertical-8">@Html.Raw(CharmsColorSelector.ColorSelectorLabel2)</li>
                            <li class="margin-vertical-8">@Html.Raw(CharmsColorSelector.ColorSelectorLabel3)</li>
                        </ol>
                    </div>
                </div>
                <!-- LIST -->
                <div class="cell-fs-12 cell-md-6">
                    <div id="spectraTypesColorsListContainer"></div>
                </div>
            </div>
        </div>
        <!-- COLOR-SELECTOR -->
        <div class="cell-fs-12 cell-md-6 d-flex flex-justify-center charms-color-selector-column">
            <div id="colorSelector" data-role="color-selector" data-show-values="hex,rgb" data-on-select-color="onSelectColor"></div>
        </div>
    </div>
</div>

<!-- CHARMS - SPECTRA PROCESSING -->
<div id="charmsProcessSpectra" data-role="charms" data-cls-charms="charms-panel" data-position="right" data-on-open="onCharmsProcessSpectraOpened()" data-on-close="onCharmsProcessSpectraClosed()">
    <!-- MAIN BAR -->
    <div class="d-flex flex-justify-between" style="height: 60px">
        <!-- SPECTRUM SELECTION -->
        <div class="d-flex flex-row">
            <div id="spectrumSelectionContainer"></div>
            <div>
                <button id="buttonShowToastAutoHideNotSelectedSpectra" class="button primary cycle small margin-left-8 margin-top-4 pointer d-none" onmouseover="showToastAutoHideNotSelectedSpectra()">
                    <span class="mif-info mif-2x"></span>
                </button>
            </div>
        </div>

        <!-- CLOSE-AND-RESET-CHARMS BUTTON -->
        <div class="button light cycle outline float-right pointer" title="@Html.Raw(Charms.CharmsHideAndResetLabel)" onclick="closeCharmsProcessSpectraAsync()">
            <span class="mif-cross-light"></span>
        </div>
        <!-- HIDE-CHARMS BUTTON -->
        <div class="button light cycle outline float-right pointer" title="@Html.Raw(Charms.CharmsHideLabel)" onclick="hideCharmsProcessSpectra()">
            <span class="mif-arrow-right"></span>
        </div>
    </div>
    <!-- SPECTRA PROCESSING MAIN PANEL -->
    <div id="charmsSpectraProcessingMainPanel" class="row cell-fs-12">
        <!-- TABS -->
        <div id="charmsTabsContainer" class="row cell-fs-12 d-none">
            <ul id="charmsTabs"
                data-app-bar="false"
                data-role="tabs"
                data-expand="true"
                data-expand-point="fs"
                data-cls-tabs="tabs-list flex-justify-center">
                <li><a id="alignmentoptionstitle" href="#alignmentoptions">@Html.Raw(Charms.TabsAlignmentTitle)</a></li>
                <li><a id="fitoptionstitle" href="#fitoptions">@Html.Raw(Charms.TabsFitTitle)</a></li>
                <li><a id="smoothingoptionstitle" href="#smoothingoptions" onclick="selectTargetSpectrumType()">@Html.Raw(Charms.TabsSmoothingTitle)</a></li>
                <li><a id="bandanalysistitle" href="#bandanalysis" onclick="createListOfSegmentsForBandAnalysis()">@Html.Raw(Charms.TabsBandAnalysisTitle)</a></li>
            </ul>
        </div>
        <!-- PANELS -->
        <div id="charmsPanels" class="row cell-fs-12">
            <!-- ALIGNMENT -->
            <div id="alignmentoptions">
                <!-- MESSAGE FOR EMPTY PANEL -->
                <div id="charmsTabAlignmentStartingMessageContainer" class="h-vh-75 d-flex flex-content-center" style="flex-wrap: wrap">
                    <span class="mif-info mif-2x"></span>
                    <p class="text-just fg-white margin-top-16">@Html.Raw(Charms.CharmsStartingMessage)</p>
                </div>
                <div id="alignmentOptionsPanel"></div>
            </div>
            <!-- FIT -->
            <div id="fitoptions">
                @{
                    await Html.RenderPartialAsync("~/Views/HyperLab/SpectraManager/Partials/_AlwaysVisibleFitPanel.cshtml");
                }
            </div>
            <!-- SMOOTHING -->
            <div id="smoothingoptions"></div>
            <!-- BAND ANALYSIS -->
            <div id="bandanalysis">
                <div class="d-flex flex-column">
                    <!-- SEGMENTS -->
                    <div><span class="text-leader text-center">@Html.Raw(CharmsBandAnalysis.BandAnalysisSegmentsListTitle)</span></div>
                    <div id="bandsAnalysisSegmentsListContainer" class="margin-top-24"></div>
                    <!-- RESULT -->
                    <div id="bandAnalysisResultsContainer" class="d-none border-top margin-top-24">
                        <!-- DROPDOWN SETTINGS -->
                        <div id="availableBandsAnalysisData" class="margin-vertical-4 d-none">
                            <button class="button cycle bg-transparent bg-cyan-hover pointer" onclick="toggleDropDown('availableBandsAnalysisDataDropdown')"><span class="mif-cloud-download mif-2x fg-white"></span></button>
                            <span class="text-secondary margin-left-8 margin-top-4">@Html.Raw(CharmsBandAnalysis.BandAnalysisBandsAnalysisOnCloudLabel)</span>
                        </div>
                        <div class="pos-relative">
                            <div id="availableBandsAnalysisDataDropdown"
                                 class="fg-white"
                                 data-role="dropdown"
                                 data-no-close="true"
                                 data-toggle-element="#availableBandsAnalysisData">
                                <!-- LIST OF AVAILABLE BANDS ANALYSIS DATA -->
                                <div id="bandsAnalysisDataList"></div>
                            </div>
                        </div>
                        <!-- RESULTS TITLE -->
                        <div><span class="text-leader">@Html.Raw(CharmsBandAnalysis.BandAnalysisResultsTitle)</span></div>
                        <!-- BAND BOUNDARIES -->
                        <div class="d-flex flex-row margin-top-16">
                            <div><span>@Html.Raw(CharmsBandAnalysis.BandAnalysisBandBoundariesLabel)</span></div>
                            <div class="margin-left-16">
                                <span>[</span>
                                <span id="bandAnalysisBandBoundariesMinValue"></span>
                                <span class="margin-left-4">,</span>
                                <span class="margin-left-4" id="bandAnalysisBandBoundariesMaxValue"></span>
                                <span>]</span>
                            </div>
                        </div>

                        <!-- BAND CENTER -->
                        <div class="d-flex flex-row margin-top-16">
                            <div><span>@Html.Raw(CharmsBandAnalysis.BandAnalysisBandCenterLabel)</span></div>
                            <div class="margin-left-16"><span id="bandAnalysisBandCenterValue">-</span></div>
                            <div class="margin-left-8"><span id="bandAnalysisBandCenterUnit" class="d-none">nm</span></div>
                        </div>

                        <!-- BAND FWHM -->
                        <div class="d-flex flex-row margin-top-16">
                            <div><span>@Html.Raw(CharmsBandAnalysis.BandAnalysisBandFwhmLabel)</span></div>
                            <div class="margin-left-16"><span id="bandAnalysisBandFwhmValue">-</span></div>
                            <div class="margin-left-8"><span id="bandAnalysisBandFwhmUnit" class="d-none">nm</span></div>
                        </div>

                        <!-- BAND DEPTH -->
                        <div class="d-flex flex-row margin-top-16">
                            <div><span>@Html.Raw(CharmsBandAnalysis.BandAnalysisBandDepthLabel)</span></div>
                            <div class="margin-left-16"><span id="bandAnalysisBandDepthValue">-</span></div>
                        </div>

                        <!-- BAND AREA -->
                        <div class="d-flex flex-row margin-top-16">
                            <div><span>@Html.Raw(CharmsBandAnalysis.BandAnalysisBandAreaLabel)</span></div>
                            <div class="margin-left-16"><span id="bandAnalysisBandAreaValue">-</span></div>
                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex flex-row margin-top-16">
                            @if (Model.IsUserAuthenticated)
                            {
                                <!-- BUTTON SAVE -->
                                <button id="bandAnalysisDataButtonSave" class="button primary cycle pointer disabled large margin-left-16" title="@Html.Raw(CharmsBandAnalysis.BandAnalysisSaveOnCloudLabel)" onclick="saveBandAnalysisDataProcedureAsync()"><span class="mif-cloud-upload"></span></button>
                            }
                            <!-- BUTTON DOWNLOAD -->
                            <div id="bandAnalysisButtonDownload" class="multi-action d-none margin-left-16">
                                <button class="action-button rotate-minus primary fg-white"
                                        onclick="$(this).toggleClass('active')">
                                    <span class="icon"><span class="mif-file-download"></span></span>
                                </button>
                                <ul class="actions drop-bottom">
                                    <li class="bg-cyan" title="@Html.Raw(CharmsBandAnalysis.BandAnalysisButtonDownloadAsCsvLabel)" onclick="downloadBandAnalysisDataAsCsvAsync()">
                                        <p class="text-small fg-white text-center text-bold">@Html.Raw(Charms.DownloadAsCSVLabel)</p>
                                    </li>
                                    <li class="bg-cyan" title="@Html.Raw(CharmsBandAnalysis.BandAnalysisButtonDownloadAsXmlLabel)" onclick="downloadBandAnalysisDataAsXmlAsync()">
                                        <p class="text-small fg-white text-center text-bold">@Html.Raw(Charms.DownloadAsXMLLabel)</p>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHARMS - LEGEND -->
<div id="charmsLegend" data-role="charms" data-cls-charms="charms-legend-panel" data-position="left" data-on-open="createCharmsLegend()">

    <!-- ARROW + TITLE -->
    <div class="row">
        <!-- ARROW -->
        <div class="cell-fs-4 cell-md-2">
            <div class="button light cycle outline float-left pointer fg-white" title="@Html.Raw(Charms.CharmsHideLabel)" onclick="toggleCharmsLegend()">
                <span class="mif-arrow-left"></span>
            </div>
        </div>
        <!-- TITLE -->
        <div class="cell-fs-4 cell-md-8 text-center">
            <span class="text-bold text-leader fg-white">@Html.Raw(CharmsLegend.LegendTitle)</span>
        </div>
        <!-- REFRESH-->
        <div class="cell-fs-4 cell-md-2">
            <div class="button light cycle outline float-left pointer fg-white" title="@Html.Raw(CharmsLegend.LegendRefreshLabel)" onclick="refreshCharmsLegend()">
                <span class="mif-refresh"></span>
            </div>
        </div>
    </div>

    <!-- LEGEND LABEL -->
    <div class="row cell-fs-12">
        <p class="fg-light text-secondary">@Html.Raw(CharmsLegend.LegendLabel1)</p>
        <p class="fg-light text-secondary">@Html.Raw(CharmsLegend.LegendLabel2)</p>
    </div>

    <!-- LEGEND -->
    <div id="legendContainer" class="row cell-fs-12">
        <ul id="legend" data-role="treeview">
        </ul>
    </div>
</div>

<!-- CHARMS - MESSAGES -->
@{
    await Html.RenderPartialAsync("~/Views/HyperLab/SpectraManager/Partials/_Messages.cshtml");
}

<!-- REFERENCE TO BLAZOR BlazorHelper COMPONENT -->
<base href="~/" />
<component type="typeof(BlazorHelper)" render-mode="ServerPrerendered" />

<!-- common js variables -->
@{
    await Html.RenderPartialAsync("~/Views/HyperLab/SpectraManager/Partials/_HubAndChartJsCommon.cshtml");
    await Html.RenderPartialAsync("~/Views/HyperLab/SpectraManager/Partials/_ChartJsCommon.cshtml");
}

<script src="_framework/blazor.server.js"></script>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js"></script>
<script type="text/javascript" src="https://code.createjs.com/1.0.0/createjs.min.js"></script>
<script type="text/javascript" src="~/js/dist/blazorglobalbundle.js" asp-append-version="true"></script>
<script type="text/javascript" src="~/js/dist/devextreme/devextremebundle.min.js" asp-append-version="true"></script>
<environment names="Development">
    <script type="text/javascript" src="~/js/hyperlab/commonbuttons.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/commonhubandchartsandsharedstuff.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/commonhubandchart.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charts.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/chartsbuttons.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/chartsarrays.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/chartsunauthorized.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charms.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmslegend.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmscolorselector.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmsalignmentpanel.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmsfitpanel.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmsfitpanelcore.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmsfitpanelpro.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmsfitpanelcommon.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmssmoothingpanel.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/charms/charmsbandanalysis.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/charmsmessages.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/joystick/joystick.js"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/joystickmanager.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/chart/joystickchart.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/hyperlab/guide/guide.js" asp-append-version="true"></script>
</environment>
<environment names="Production">
    <script type="text/javascript" src="~/js/dist/hyperlab/chart/chartbundle.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/dist/hyperlab/chart/charmsbundle.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/dist/hyperlab/chart/joystickbundle.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/dist/guide/guidebundle.min.js" asp-append-version="true"></script>
</environment>

<script type="text/javascript">
    var isSLabDataManagerAllowed = @IsSLabDataManagerAllowed.ToJsString();
    var isUserAuthenticated = @Model.IsUserAuthenticated.ToJsString();
    var UrlHub = '@UrlHub';

    /* fill 'selectedSpectra' array with ids retrieved by back-end */
    function fillSelectedSpectra() {
        selectedSpectra = @Html.Raw(Json.Serialize(spectraIds));
    }
</script>
