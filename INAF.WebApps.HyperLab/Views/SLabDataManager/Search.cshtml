                    <ol>
                        <li>@Html.Raw(Search.SearchTypeSimpleHowTo1)</li>
                        <li>@Html.Raw(Search.SearchTypeSimpleHowTo2)</li>
                        <li>@Html.Raw(Search.SearchHowToFinal)</li>
                    </ol>
                    <p>@Html.Raw(Search.SearchTypeSimpleHowTo2NbTitle)</p>
                    <ul>
                        <li>@Html.Raw(Search.SearchTypeSimpleHowTo2Nb1)</li>
                        <li>@Html.Raw(Search.SearchTypeSimpleHowTo2Nb2)</li>
                        <li>@Html.Raw(Search.SearchTypeSimpleHowTo2Nb3)</li>
                    </ul>
                </div>
                <div id="complexsearch">
                    <p class="text-just">@Html.Raw(Search.SearchTypeComplexExplanation)</p>
                    <p class="margin-top-8">@Html.Raw(Search.SearchTypeComplexHowToTitle)</p>
                    <ol>
                        <li>@Html.Raw(Search.SearchTypeComplexHowTo11)&nbsp;<small>@Html.Raw(Search.SearchTypeComplexHowTo12)</small></li>
                        <li>@Html.Raw(Search.SearchTypeComplexHowTo21)&nbsp;<small>@Html.Raw(Search.SearchTypeComplexHowTo22)</small></li>
                        <li>@Html.Raw(Search.SearchTypeComplexHowTo31)&nbsp;<small>@Html.Raw(Search.SearchTypeComplexHowTo32)</small></li>
                        <li>@Html.Raw(Search.SearchHowToFinal)</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

