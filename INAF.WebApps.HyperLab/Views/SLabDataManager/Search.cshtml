<!-- SPECTRUM INFO -->
<div id="info" class="container mywrapper overflow-x-auto overflow-y-auto bg-light zindex-10">
    <!-- CLOSE BUTTON -->
    <div class="row cell-fs-12">
        <div onclick="hideInfo()" class="button primary cycle float-right margin-right-8 margin-top-8">
            <span class="mif-cross-light"></span>
        </div>
    </div>
    <!-- FILE INFO -->
    <!-- filename -->
    <div class="row">
        <div class="cell-fs-12 d-flex flex-justify-start margin-left-8 margin-top-8">
            <label for="filename" class="control-label">@Html.Raw(Info.FilenameLabel)</label>
            <span id="filename" class="margin-left-8"></span>
            <span id="type" class="margin-left-8"></span>
        </div>
    </div>
    <!-- INFO -->
    <div class="row">
        <div class="cell-fs-12">
            <ul data-role="tabs" data-expand="true">
