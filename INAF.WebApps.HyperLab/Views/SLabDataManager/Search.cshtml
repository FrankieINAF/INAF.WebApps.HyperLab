<script type="text/javascript">
    var CONDITION_OPERATORS = '@ConditionsOperators';
    var CONDITION_TYPE_MATERIAL = '@ConditionMaterial';
    var CONDITION_TYPE_MINERAL_TYPE = '@ConditionMineralType';
    var CONDITION_TYPE_ORIGIN_TYPE = '@ConditionOriginType';
    var CONDITION_TYPE_SAMPLE_NAME = '@ConditionSampleName';
    var CONDITION_TYPE_SAMPLE_TYPE = '@ConditionSampleType';

    var CONDITION_OPERATOR_NONE = '@Enums.ConditionOperatorType.None.ToString()';
    var CONDITION_OPERATOR_AND = '@Enums.ConditionOperatorType.And.ToString()';
    var CONDITION_OPERATOR_OR = '@Enums.ConditionOperatorType.Or.ToString()';

    var MATERIAL_TYPE_NONE = '@materialTypeNone';
    var MATERIAL_TYPE_MINERAL = '@materialTypeMineral';
    var MATERIAL_TYPE_ROCK = '@materialTypeRock';
    var MATERIAL_TYPE_METEORCLASS = '@materialTypeMeteorClass';

    var searchTypeRadio = '@searchTypeRadio';
    var selectMaterial = '@selectMaterial';
    var selectMineralType = '@selectMineralType';
    var selectSampleDataType = '@selectSampleDataType';
    var selectSampleName = '@selectSampleName';
    var selectOriginType = '@selectOriginType';

    function search() {
        /* reset array */
        selectedSpectra = [];

        /* remove 'show chart' button, if available */
        //removeCreateChartsButtonProcedure();

        /* execute selected search */
        if (SELECTED_SEARCH_TYPE == SEARCH_SIMPLE_TYPE) {
            if (selectedSearchSimpleType == '@selectMaterial') {
                searchSimpleByMaterial();
            } else if (selectedSearchSimpleType == '@selectSampleName') {
                searchSimpleBySampleName();
            } else if (selectedSearchSimpleType == '@selectMineralType') {
                searchSimpleByMineralType();
            } else if (selectedSearchSimpleType == '@selectOriginType') {
                searchSimpleByOriginType();
            } else if (selectedSearchSimpleType == '@selectSampleDataType') {
                searchSimpleBySampleType();
            }
        } else {
            executeComplexSearchAsync();
        }
    }

    function fillSampleTypes() {
    @{
        if (Model.SampleTypeValuesContainerExtended.SampleDataValues != null && Model.SampleTypeValuesContainerExtended.SampleDataValues.Any())
        {
            StringBuilder sb = new StringBuilder();
            int sampleTypesNum = Model.SampleTypeValuesContainerExtended.SampleDataValues.Count;
            for (int i = 0; i < sampleTypesNum; i++)
            {
                sb.AppendLine($"sampleTypes.push({{key: {Model.SampleTypeValuesContainerExtended.SampleDataValues[i].Id}, value: '{Model.SampleTypeValuesContainerExtended.SampleDataValues[i].Value}' }});");
            }
            @Html.Raw(sb.ToString())
            ;
        }
    }
    }

    function fillMineralTypes() {
    @{
        if (Model.SampleTypeValuesContainerExtended.MineralTypeValues != null && Model.SampleTypeValuesContainerExtended.MineralTypeValues.Any())
        {
            StringBuilder sb = new StringBuilder();
            int mineralTypesNum = Model.SampleTypeValuesContainerExtended.MineralTypeValues.Count;
            for (int i = 0; i < mineralTypesNum; i++)
            {
                sb.AppendLine($"mineralTypes.push({{key: {Model.SampleTypeValuesContainerExtended.MineralTypeValues[i].Id}, value: '{Model.SampleTypeValuesContainerExtended.MineralTypeValues[i].Value}' }});");
            }
            @Html.Raw(sb.ToString())
            ;
        }
    }
    }

    function fillOriginTypes() {
    @{
        if (Model.SampleTypeValuesContainerExtended.OriginTypeValues != null && Model.SampleTypeValuesContainerExtended.OriginTypeValues.Any())
        {
            StringBuilder sb = new StringBuilder();
            int originTypesNum = Model.SampleTypeValuesContainerExtended.OriginTypeValues.Count;
            for (int i = 0; i < originTypesNum; i++)
            {
                sb.AppendLine($"originTypes.push({{key: {Model.SampleTypeValuesContainerExtended.OriginTypeValues[i].Id}, value: '{Model.SampleTypeValuesContainerExtended.OriginTypeValues[i].Value}' }});");
            }
            @Html.Raw(sb.ToString())
            ;
        }
    }
    }

    $(function () {
        addClass('bandanalysistitle', 'disabled');
    });


</script>
