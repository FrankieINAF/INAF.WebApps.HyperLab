@model WebBaseModel

@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Resources

@{
    ViewBag.Title = Users.UsersListPageTitle;

    var controllerOperationMessage = (!string.IsNullOrEmpty(Model.ControllerOperationMessage) ? Model.ControllerOperationMessage : "");
}

<link rel="stylesheet" href="~/css/dist/users/usersbundle.min.css" />
<div id="wrapper" class="container mywrapper overflow-y-auto">
    <!-- SEARCH -->
    <div id="searchboxContainer" class="row rows-divider">
        <div class="cell-fs-12 cell-sm-6">
            <input id="searchbox"
                   type="text"
                   data-role="input"
                   placeholder="@Html.Raw(Users.SearchContactsLabel)"
                   data-search-button="true"
                   data-search-button-click="custom"
                   data-on-search-button-click="doSearchProcedure"
                   data-on-clear-click="clearSearchboxProcedure">
        </div>
    </div>

    <div id="listAndCardContainer" class="row rows-divider">
        <!-- LIST-->
        <div id="contactsCol" class="cell-fs-12 cell-sm-6 list-card-separator" style="height: 85vh; overflow-y: auto; overflow-x: hidden">
            <!-- USERS LIST -->
            <div id="usersList" class="row"></div>
        </div>

        <!-- CARD-->
        <div id="cardContainer" class="cell-fs-12 cell-sm-6 user-details" style="height: 85vh;">
            <div id="selectedPersonContainerBckGnd">
                <div id="selectedUserContainer"></div>
            </div>
        </div>

        <!-- LETTERS GRID -->
        <div id="lettersGrid" class="row lettersGrid">
            <div id="lettersList" class="cell-fs-12 cell-sm-6"></div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@await Html.PartialAsync("Partials/_JsCommon")
@await Html.PartialAsync("Partials/_JsUsersCommon")

