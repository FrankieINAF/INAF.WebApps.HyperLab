<!-- FORM FOR ADDING NEW PERSON -->
@using (Html.BeginForm(nameof(UsersController.UpsertUser), GenericHelper.GetControllerName(nameof(UsersController)), FormMethod.Get, new Dictionary<string, object> { { "id", "upsertUserForm" } }))
{ }

<script type="text/javascript">
    var detail = $('#selectedDetailContainer');

    var UrlDeleteUser = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.DeleteUser)';
    var UrlEditUser = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.EditUser)';
    var UrlGetUsersList = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.GetUsersList)';
    var UrlGetUserDetails = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.GetUserDetailsView)';
    var UrlUpsertUser = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.UpsertUser)';

    var DeletePersonErrorMessage = '@Users.DeletePersonErrorMessage';
    var PersonDeletionQuestion = '@Users.PersonDeletionQuestion';
    var PersonManagementTitle = '@Users.PersonManagementTitle';

    var controllerOperationStatus = @{@((int)Model.ControllerOperationStatus);};
    var controllerOperationMessage = '@controllerOperationMessage';
</script>
<environment names="Development">
    <script type="text/javascript" src="~/js/dist/users/userslistbundle.js"></script>
</environment>
<environment names="Production">
    <script type="text/javascript" src="~/js/dist/users/userslistbundle.min.js"></script>
</environment>