@model UserModel

@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Resources
@using INAF.Libraries.Net.CommonWebAppModels
@using INAF.Libraries.Net.CommonWebAppModels.Models.Users
@using CommonResources = INAF.Libraries.Net.CommonWebAppModels.Resources
@using INAF.Libraries.NetStandard.HyperLabCommonModels.Values

@{
    ViewBag.Title = @Html.Raw(Users.AddUserPageTitle);

    string errorMessage = string.Empty;
    string isError = false.ToJsString();
    if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        isError = true.ToJsString();
        errorMessage = Model.ErrorMessage;
    }
}

<div class="container mywrapper" style="overflow-y: auto">
    <div class="row">
        <div class="cell-fs-12">
            <h3 class="text-center fg-black">@Html.Raw(Users.AddUserTitle)</h3>
            <span class="mif-cross-light" onclick="tryClose()" style="float:right; margin-right: 8px; display:block; cursor:pointer;"></span>
        </div>
    </div>

    <form id="formAddUser"
          method="post"
          target="_self">

        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.OperationType)

        <div class="row">
            <div class="cell-fs-12">
                <ul data-role="tabs" data-cls-tabs="flex-justify-center mt-2" data-expand="true">
                    <li name="tab1"><a href="#tab-1">@Html.Raw(Users.TabPersonInfoLabel)</a></li>
                    <li name="tab2"><a href="#tab-2">@Html.Raw(Users.TabPersonLoginLabel)</a></li>
                    <li name="tab3"><a href="#tab-3">@Html.Raw(Users.TabPersonRoleAndPermissionsLabel)</a></li>
                </ul>

                <div class="border no-border-top p-2">
                    <!-- TAB PERSON INFO -->
                    <div id="tab-1">
                        <div class="row">
                            <div class="cell-sm-4">&nbsp;</div>
                            <div class="cell-fs-12 cell-sm-4">
                                <div class="form-group">
                                    <!-- NAME -->
                                    @Html.LabelFor(model => model.Name, CommonResources.Users.NameLabel, new Dictionary<string, object> { { "class", "control-label" } })
                                    @Html.TextBoxFor(model => model.Name,
                                    new Dictionary<string, object> {
                                    { "data-role", "input" },
                                    { "placeholder", Html.Raw(CommonResources.Users.NamePlaceholder) },
                                    { "onchange", "setDataChanged()" },
                                    })
                                    @Html.Hidden(nameof(CheckIsUserExistantModel.NameForCheck), Model.Name)
                                    @Html.ValidationMessageFor(model => model.Name, "", new Dictionary<string, object> { { "class", "text-danger" } })
                                </div>

                                <!-- LAST NAME -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LastName, CommonResources.Users.LastNameLabel, new Dictionary<string, object> { { "class", "control-label" } })
                                    @Html.TextBoxFor(model => model.LastName,
                                    new Dictionary<string, object> {
                                    { "data-role", "input" },
                                    { "placeholder", Html.Raw(CommonResources.Users.LastNamePlaceholder) },
                                    { "onchange", "setDataChanged()" },
                                    })
                                    @Html.Hidden(nameof(CheckIsUserExistantModel.LastNameForCheck), Model.LastName)
                                    @Html.ValidationMessageFor(model => model.LastName, "", new Dictionary<string, object> { { "class", "text-danger" } })
                                </div>

                                <!-- EMAIL -->
                                <div class="form-group">
                                    @{
                                        var email = Model.Contacts.FirstOrDefault(x => x.ContactType == Enums.ContactType.Email);
                                        string emailValue = string.Empty;
                                        if (email != null)
                                            emailValue = email.Value;
                                    }
                                    @Html.LabelFor(model => email, CommonResources.Users.EmailLabel, new Dictionary<string, object> { { "class", "control-label" } })
                                    <input id="Contacts[0]_Value" name="Contacts[0].Value" value="@emailValue" type="text" data-role="input" data-prepend="<span class='mif-mail'>" placeholder="@Html.Raw(CommonResources.Users.EmailPlaceholder)" />
                                    <input type="hidden" id="Contacts[0]_ContactType" name="Contacts[0].ContactType" value="@Enums.ContactType.Email" />
                                    @Html.Hidden(nameof(CheckIsUserExistantModel.EmailForCheck), emailValue)
                                    @Html.ValidationMessageFor(model => email, "", new Dictionary<string, object> { { "class", "text-danger" } })
                                </div>
                            </div>
                            <div class="cell-sm-4">&nbsp;</div>
                        </div>
                    </div>

                    <!-- TAB PERSON LOGIN -->
                    <div id="tab-2">
                        <div class="row">
                            <div class="cell-sm-4">&nbsp;</div>
                            <div class="cell-fs-12 cell-sm-4">
                                <!-- USERNAME -->
                                <div class="form-group">
                                    <!-- USERNAME -->
                                    @Html.LabelFor(model => model.Login.UserName, CommonResources.Login.UserNameLabel, new Dictionary<string, object> { { "class", "control-label" } })
                                    @Html.TextBoxFor(model => model.Login.UserName,
                                    new Dictionary<string, object> {
                                    { "data-role", "input" },
                                    { "placeholder", Html.Raw(CommonResources.Login.LoginUsernamePlaceholder) },
                                    { "onchange", "setDataChanged()" },
                                    })
                                    @Html.ValidationMessageFor(model => model.Login.UserName, "", new Dictionary<string, object> { { "class", "text-danger" } })
                                </div>

                                <p class="margin-top-8">
                                    <span class="text-secondary">@Html.Raw(CommonResources.Login.PasswordRulesMessage1)</span>
                                    <ol class="decimal text-small">
                                        <li>@Html.Raw(CommonResources.Login.PasswordRulesMessage2)</li>
                                        <li>@Html.Raw(CommonResources.Login.PasswordRulesMessage3)</li>
                                        <li>@Html.Raw(CommonResources.Login.PasswordRulesMessage4)</li>
                                    </ol>
                                </p>

                                <!-- PASSWORD -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Login.Password, CommonResources.Login.PasswordLabel, new Dictionary<string, object> { { "class", "control-label" } })
                                    @Html.PasswordFor(model => model.Login.Password,
                                    new Dictionary<string, object> {
                                    { "data-role", "input" },
                                    { "placeholder", Html.Raw(CommonResources.Login.PasswordPlaceholder) },
                                    { "onchange", "setDataChanged()" },
                                    })
                                    @Html.ValidationMessageFor(model => model.Login.Password, "", new Dictionary<string, object> { { "class", "text-danger" } })
                                </div>

                                <!-- CONFIRM PASSWORD -->
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Login.ConfirmPassword, CommonResources.Login.ConfirmPasswordLabel, new Dictionary<string, object> { { "class", "control-label" } })
                                    @Html.PasswordFor(model => model.Login.ConfirmPassword,
                                    new Dictionary<string, object> {
                                    { "data-role", "input" },
                                    { "placeholder", Html.Raw(CommonResources.Login.ConfirmPasswordPlaceholder) },
                                    { "onchange", "setDataChanged()" },
                                    })
                                    @Html.ValidationMessageFor(model => model.Login.ConfirmPassword, "", new Dictionary<string, object> { { "class", "text-danger" } })
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB PERSON PERMISSIONS -->
                    <div id="tab-3">
                        <div class="row">
                            <div class="cell-sm-4">&nbsp;</div>
                            <div class="cell-fs-12 cell-sm-4">
                                <span class="text-medium">@Html.Raw(Users.RoleAndPermissionsSelectionLabel)</span>
                            </div>
                            <div class="cell-sm-4">&nbsp;</div>
                        </div>
                        <div class="row">
                            <!-- ROLE SELECTION -->
                            <div class="cell-sm-4">&nbsp;</div>
                            <div class="cell-fs-12 cell-sm-4">
                                @Html.DropDownListFor(model => model.RoleId, new SelectList(Model.Roles, nameof(RoleModel.Id), nameof(RoleModel.Name), Model.RoleId),
                                new Dictionary<string, object> { 
                                { "id", "selectRole" },
                                { "data-role", "select" },
                                { "data-on-change", "getRolePermissions" },
                                })
                            </div>
                            <div class="cell-sm-4">&nbsp;</div>
                        </div>
                        <!-- ROLE RELATED PERMISSIONS -->
                        <div class="row">
                            <div class="cell-sm-4">&nbsp;</div>
                            <div class="cell-fs-12 cell-sm-4">
                                <div id="noRolePermissionsFoundMessage" class="remark warning" style="display: none">
                                    @Html.Raw(Users.NoRolePermissionsFoundMessage)
                                </div>
                                <div id="rolePermissionsListContainer" style="display: none">
                                    <p class="text-just text-bold margin-bottom-12">@Html.Raw(Users.ListOfPermissionsDescriptionTitle)</p>
                                    <div id="rolePermissionsList"></div>
                                </div>
                            </div>
                            <div class="cell-sm-4">&nbsp;</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="cell-fs-12">
                <!-- SUBMIT -->
                <button id="submitButton" class="button primary center"><span class="mif-cloud-upload margin-right-8"></span> @Html.Raw(SharedResources.SubmitLabel)</button>
            </div>
        </div>
    </form>
</div>

@await Html.PartialAsync("Partials/_JsCommon")
@await Html.PartialAsync("Partials/_JsUsersCommon")

<script type="text/javascript">
    var UrlGetPermissionsForRole = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.GetPermissionsForRole)/';
    var UrlUpsertUser = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.UpsertUser)';
    var UrlUsersList = '/@GenericHelper.GetControllerName(nameof(UsersController))/@nameof(UsersController.UsersList)/';

    var CloseUpsertUserLabel = '@Users.CloseUpsertUserLabel';
    var UserChangesDiscardQuestion = '@Users.UserChangesDiscardQuestion';
    var UsersManagementTitle = '@Users.UsersManagementTitle';

    var isError = @isError;
    var upsertErrorMessage = '@Users.UpsertUserErrorMessage';
</script>
<environment names="Development">
    <script type="text/javascript" src="~/js/dist/users/upsertuserbundle.js"></script>
</environment>
<environment names="Production">
    <script type="text/javascript" src="~/js/dist/users/upsertuserbundle.min.js"></script>
</environment>