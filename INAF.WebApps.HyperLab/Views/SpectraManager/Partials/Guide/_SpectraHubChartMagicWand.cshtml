@using INAF.WebApps.HyperLab.Resources

<!-- HEADER -->
<div class="row cell-fs-12 margin-16 d-flex flex-justify-between">
    <div><button class="button light cycle outline pointer fg-white margin-right-8" onclick="backToGuideMainMenu()"><span class="mif-arrow-left"></span></button></div>
    <div class="margin-right-16"><button class="button light cycle outline pointer fg-white" onclick="closeGuide()"><span class="mif-cross-light"></span></button></div>
</div>
<!-- CONTENT -->
<div class="row margin-16">
    <div class="cell-fs-12 cell-lg-6">
        <!-- EXPLANATION -->
        <div class="row d-flex cell-fs-12 margin-top-16">
            <p class="text-normal text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.SpectraHubChartPanelsLabel)</p>
        </div>
        <!-- BUTTONS -->
        <div class="row margin-top-8">
            <div class="cell-fs-12 d-flex">
                <button class="button light cycle outline min-width-36" title="Show/hide legend"><span class="mif-arrow-right" onclick="showGuideAlignmentPanel()"></span></button>
                <div>
                    <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.SpectraHubChartPanelsAlignmentButtonLabel)</p>
                    <p class="text-small fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.SpectraHubChartOnlySLabLoggedLabel)</p>
                </div>
            </div>
        </div>
        <div class="row margin-top-8">
            <div class="cell-fs-12 d-flex">
                <button class="button light cycle outline min-width-36" title="Show/hide legend"><span class="mif-arrow-right" onclick="showGuideContinuumRemovalPanel()"></span></button>
                <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.SpectraHubChartPanelsContinuumRemovalButtonLabel)</p>
            </div>
        </div>
        <div class="row margin-top-8">
            <div class="cell-fs-12 d-flex">
                <button class="button light cycle outline min-width-36" title="Show/hide legend"><span class="mif-arrow-right" onclick="showGuideSmoothingPanel()"></span></button>
                <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.SpectraHubChartPanelsSmoothingButtonLabel)</p>
            </div>
        </div>
        <div class="row margin-top-8">
            <div class="cell-fs-12 d-flex">
                <button class="button light cycle outline min-width-36" title="Show/hide legend"><span class="mif-arrow-right" onclick="showGuideBandAnalysisPanel()"></span></button>
                <p class="text-leader2 text-medium fg-white margin-left-8 margin-top-4">@Html.Raw(Guide.SpectraHubChartPanelsBandAnalysisButtonLabel)</p>
            </div>
        </div>
    </div>
    <!-- IMAGES -->
    <div class="cell-fs-12 cell-lg-6">
        <div class="d-flex flex-column-fs flex-row-lg flex-align-center-lg">
            <div class="margin-horizontal-8"><img src="~/images/guide/magic_wand/image_continuum_removed.png" class="panels-images pointer" title="@Html.Raw(SharedResources.ClickToShowImageFullScreenLabel)" onclick="openFullscreen(this)" /></div>
            <div class="panel-image-caption"><p class="text-secondary text-just fg-white">@Html.Raw(Guide.SpectraHubChartPanelsContinuumRemovedImageLabel)</p></div>
        </div>
        <div class="d-flex flex-column-fs flex-row-lg flex-align-center-lg margin-top-16">
            <div class="margin-horizontal-8 order-fs-1 order-md-2"><img src="~/images/guide/magic_wand/image_smoothed.png" class="panels-images pointer" title="@Html.Raw(SharedResources.ClickToShowImageFullScreenLabel)" onclick="openFullscreen(this)" /></div>
            <div class="panel-image-caption order-fs-2 order-lg-1"><p class="text-secondary text-just fg-white">@Html.Raw(Guide.SpectraHubChartPanelsSmoothingImageLabel)</p></div>
        </div>
        <div class="d-flex flex-column-fs flex-row-lg flex-align-center-lg margin-top-16">
            <div class="margin-horizontal-8"><img src="~/images/guide/magic_wand/image_band_analysis.png" class="panels-images pointer" title="@Html.Raw(SharedResources.ClickToShowImageFullScreenLabel)" onclick="openFullscreen(this)" /></div>
            <div class="panel-image-caption"><p class="text-secondary text-just fg-white">@Html.Raw(Guide.SpectraHubChartPanelsBandAnalysisImageLabel)</p></div>
        </div>
    </div>
</div>