@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.CommonWebAppModels.Models.Menu
@using INAF.Libraries.Net.HyperLab.CommonModels.Resources
@using INAF.WebApps.HyperLab.Controllers

@inject INAF.WebApps.HyperLab.Helpers.MenuHelper menuHelper

@{
	bool isUserAuthenticated = false;
	if (Context.User.Identity != null)
		isUserAuthenticated = Context.User.Identity.IsAuthenticated;

	<li>
		<a class="menuitem" href="@Url.Action(nameof(HomeController.Index), GenericHelper.GetControllerName(nameof(HomeController)))">
			<span class="icon"><span class="mif mif-home"></span></span>
			<span class="caption fg-white">@Html.Raw(INAF.WebApps.HyperLab.Resources.Home.HomeLabel)</span>
		</a>
	</li>

	Menu? menu = menuHelper.GetMenu(Context);
	int index = 0;

	if (menu != null && menu.Items != null && menu.Items.Any())
	{
		foreach (var item in menu.Items)
		{
			if (item.ChildrenNum == 0)
			{
				<li>
					<a class="menuitem" href="@Url.Action(item.ActionName, item.ControllerName)">
						<span class="icon"><span class="@item.Icon"></span></span>
						<span class="caption fg-white">@item.Label</span>
					</a>
				</li>
			}
			else
			{
				<li>
					<a href="#" class="dropdown-toggle">
						<span class="icon"><span class="@item.Icon"></span></span>
						<span class="caption fg-white">@item.Label</span>
					</a>
					<ul class="navview-menu" data-role="dropdown">
						@{
							List<MenuItem>? children = menuHelper.GetItemSubMenu(Context, item.Id);
							if (children != null)
							{
								foreach (var child in children)
								{
									<li>
										<a class="menuhref" href="@Url.Action(child.ActionName, child.ControllerName)">
											<span class="icon" style="margin-left: 24px"><span class="@child.Icon"></span></span>
											<span class="caption">@child.Label</span>
										</a>
									</li>
								}
							}
						}
					</ul>
				</li>
			}

			index++;
		}
	}

	if (!isUserAuthenticated)
	{
		<li>
            @{
				string loginUrl = Url.Action(nameof(AccountController.Login), GenericHelper.GetControllerName(nameof(AccountController)));
			}
			<a id="loginItem" class="menuitem">
				<span class="icon"><span class="mif mif-unlock"></span></span>
				<span class="caption fg-white">@Html.Raw(Account.LoginSLabLabel)</span>
			</a>
		</li>
		<script type="text/javascript">
		$(function() {
			var Url = `@loginUrl?returnUrl=${currentView}`;
            $('#loginItem').attr('href', Url);
		})
		</script>
	}
}