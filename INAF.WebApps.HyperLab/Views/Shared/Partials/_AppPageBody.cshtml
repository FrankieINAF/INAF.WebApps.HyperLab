@using INAF.WebApps.HyperLab.Resources

@{
    int descriptionsCount = Model.Descriptions.Count;
    if (descriptionsCount > 0)
    {
        <div class="description-grid d-flex flex-column">
            @for (int i = 0; i < descriptionsCount; i++)
            {
                <div class="description-item">
                    <div class="description-item-text">
                        <p class="text-just padding-16 fg-white">@Html.Raw(Model.Descriptions[i])</p>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- DOWNLOAD -->
<div class="d-flex flex-justify-around">
    <!-- DOWNLOAD APP -->
    <button id="buttonDownloadApp" class="download-button command-button primary rounded d-flex" onclick="downloadApp()">
        <span class="mif-download icon"></span>
        <span class="caption">
            Download app
            <small id="downloadCaption">Use this option for home or work</small>
        </span>
    </button>
    <!-- DOWNLOAD MANUAL -->
    <button id="buttonDownloadUserManual" class="shortcut primary" onclick="downloadUserManual()">
        <span class="mif-open-book icon"></span>
        <span class="caption">User manual</span>
    </button>
</div>

<!-- FEATURES -->
<div class="features-container">
    <div class="d-flex flex-column-fs flex-row-sm">
        <div class="feature-item d-flex flex-row-fs flex-column-sm">
            <img class="d-flex flex-self-center feature-item-image1" src="~/images/apps/reach.png" />
            <div class="feature-item-text d-flex flex-column flex-justify-center">
                <p class="text-just padding-horizontal-8 fg-white">@Html.Raw(Apps.AppFeatureRich)</p>
            </div>
        </div>
        <div class="feature-item d-flex flex-row-fs flex-column-sm">
            <img class="d-flex flex-self-center feature-item-image2" src="~/images/apps/cross_platform.png" />
            <div class="feature-item-text d-flex flex-column flex-justify-center">
                <p class="text-just padding-horizontal-8 fg-white">@Html.Raw(Apps.AppFeatureCrossPlatform)</p>
            </div>
        </div>
        <div class="feature-item d-flex flex-row-fs flex-column-sm">
            <img class="d-flex flex-self-center feature-item-image1" src="~/images/apps/portable.png" />
            <div class="feature-item-text d-flex flex-column flex-justify-center">
                <p class="text-just padding-horizontal-8 fg-white">@Html.Raw(Apps.AppFeaturePortable)</p>
            </div>
        </div>
    </div>
</div>