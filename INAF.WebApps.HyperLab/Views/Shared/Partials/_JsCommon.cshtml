@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Helpers
@using INAF.WebApps.HyperLab.Resources
@using static INAF.WebApps.HyperLab.Values.Enums
@using Enums = INAF.Libraries.Net.HyperLab.CommonModels.Values;
@using INAF.Libraries.Net.Extensions

<script type="text/javascript">
    var isFirstLoading = true;

    var UTC_OFFSET_HOURS = @System.TimeZoneInfo.Local.GetUtcOffset(DateTime.Now).Hours;

    var JS_DELAY_200 = 200
    var JS_DELAY_500 = 500;

    var INFO_LABEL = '@Html.Raw(SharedResources.InfoLabel)';
    var WARNING_LABEL = '@Html.Raw(SharedResources.WarningLabel)';
    var ERROR_LABEL = '@Html.Raw(SharedResources.ErrorLabel)';

    var CANCEL_LABEL = '@Html.Raw(SharedResources.CancelLabel)';
    var OK_LABEL = '@Html.Raw(SharedResources.OkLabel)';
    var YES_LABEL = '@Html.Raw(SharedResources.YesLabel)';
    var NO_LABEL = '@Html.Raw(SharedResources.NoLabel)';

    var DeleteLabel = "@SharedResources.DeleteLabel";
    var EditLabel = "@SharedResources.EditLabel";

    var MINERAL_TYPE_NONE = @{@((int)Enums.Enums.MineralType.None);};
    var MINERAL_TYPE_MONOMINERALIC = @{@((int)Enums.Enums.MineralType.Monomineralic);};
    var MINERAL_TYPE_AMORPHOUS = @{@((int)Enums.Enums.MineralType.Amorphous);};
    var MINERAL_TYPE_MIX = @{@((int)Enums.Enums.MineralType.Mix);};
    var MINERAL_TYPE_ROCK = @{@((int)Enums.Enums.MineralType.Rock);};
    var MINERAL_TYPE_EXTRATERRESTRIAL = @{@((int)Enums.Enums.MineralType.Extraterrestrial);};

    var SMOOTHING_TYPE_BY_SEGMENTS = @{@((int)Enums.Enums.SmoothingType.BySegments);};
    var SMOOTHING_TYPE_WHOLE_SPECTRUM = @{@((int)Enums.Enums.SmoothingType.WholeSpectrum);};

    var SPECTRUM_TYPE_NONE = @{@((int)Enums.Enums.SpectrumType.None);};
    var SPECTRUM_TYPE_RAW = @{@((int)Enums.Enums.SpectrumType.Raw);};
    var SPECTRUM_TYPE_REF = @{@((int)Enums.Enums.SpectrumType.Ref);};
    var SPECTRUM_TYPE_REF_WHITE = @{@((int)Enums.Enums.SpectrumType.RefWhite);};
    var SPECTRUM_TYPE_ALIGNED = @{@((int)Enums.Enums.SpectrumType.Aligned);};
    var SPECTRUM_TYPE_ALIGNED_SMOOTHED_BY_SEGMENTS = @{@((int)Enums.Enums.SpectrumType.AlignedSmoothedBySegments);};
    var SPECTRUM_TYPE_ALIGNED_SMOOTHED = @{@((int)Enums.Enums.SpectrumType.AlignedSmoothed);};
    var SPECTRUM_TYPE_CONTINUUM = @{@((int)Enums.Enums.SpectrumType.Continuum);};
    var SPECTRUM_TYPE_CONTINUUM_REMOVED = @{@((int)Enums.Enums.SpectrumType.ContinuumRemoved);};
    var SPECTRUM_TYPE_CONTINUUM_REMOVED_SMOOTHED_BY_SEGMENTS = @{@((int)Enums.Enums.SpectrumType.ContinuumRemovedSmoothedBySegments);};
    var SPECTRUM_TYPE_CONTINUUM_REMOVED_SMOOTHED = @{@((int)Enums.Enums.SpectrumType.ContinuumRemovedSmoothed);};

    var CONTROLLER_OPERATION_NONE = @{@((int)ControllerOperationStatus.None);};
    var CONTROLLER_OPERATION_OK = @{@((int)ControllerOperationStatus.Ok);};
    var CONTROLLER_OPERATION_MODEL_INVALID = @{@((int)ControllerOperationStatus.ModelInvalid);};
    var CONTROLLER_OPERATION_ERROR = @{@((int)ControllerOperationStatus.UpsertError);};

    function getSpectrumTypeDescription(spectrumType) {
        let spectrumTypeText = 'Raw';
        switch (spectrumType) {
            case 2:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Raw.GetDescription()';
            break;

            case 3:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Ref.GetDescription()';
            break;

            case 4:
                spectrumTypeText = '@Enums.Enums.SpectrumType.RefWhite.GetDescription()';
            break;

            case 5:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Aligned.GetDescription()';
            break;

            case 6:
                spectrumTypeText = '@Enums.Enums.SpectrumType.AlignedSmoothedBySegments.GetDescription()';
            break;

            case 7:
                spectrumTypeText = '@Enums.Enums.SpectrumType.AlignedSmoothed.GetDescription()';
            break;

            case 8:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Continuum.GetDescription()';
            break;

            case 9:
                spectrumTypeText = '@Enums.Enums.SpectrumType.ContinuumRemoved.GetDescription()';
            break;

            case 10:
                spectrumTypeText = '@Enums.Enums.SpectrumType.ContinuumRemovedSmoothedBySegments.GetDescription()';
            break;

            case 11:
                spectrumTypeText = '@Enums.Enums.SpectrumType.ContinuumRemovedSmoothed.GetDescription()';
            break;
        }

        return spectrumTypeText;
    }

    function getSpectrumTypeString(spectrumType) {
        let spectrumTypeText = 'Raw';
        switch (spectrumType) {
            case 1:
                spectrumTypeText = '@Enums.Enums.SpectrumType.None.ToString()';
                break;

            case 2:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Raw.ToString()';
                break;

            case 3:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Ref.ToString()';
                break;

            case 4:
                spectrumTypeText = '@Enums.Enums.SpectrumType.RefWhite.ToString()';
                break;

            case 5:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Aligned.ToString()';
                break;

            case 6:
                spectrumTypeText = '@Enums.Enums.SpectrumType.AlignedSmoothedBySegments.ToString()';
                break;

            case 7:
                spectrumTypeText = '@Enums.Enums.SpectrumType.AlignedSmoothed.ToString()';
                break;

            case 8:
                spectrumTypeText = '@Enums.Enums.SpectrumType.Continuum.ToString()';
                break;

            case 9:
                spectrumTypeText = '@Enums.Enums.SpectrumType.ContinuumRemoved.ToString()';
                break;

            case 10:
                spectrumTypeText = '@Enums.Enums.SpectrumType.ContinuumRemovedSmoothedBySegments.ToString()';
                break;

            case 11:
                spectrumTypeText = '@Enums.Enums.SpectrumType.ContinuumRemovedSmoothed.ToString()';
                break;
        }

        return spectrumTypeText;
    }

    function navigateToHome() {
        navigateTo('/@GenericHelper.GetControllerName(nameof(HomeController))/@nameof(HomeController.Index)/');
    }

    $('.menuhref').click(function(e) {
        //console.log(this.href);
        var url = this.href.replace(window.location.origin, '');
        loadPartialView(url);
        e.preventDefault();
        e.stopPropagation();
        updateMenuActiveItemProcedure(this);
    });

    function loadPartialView(url)
    {
        tryClearAppBar();
        $('#renderbody').load(url);
    }

    /* set currently selected item as active */
    function setActiveItem(liItem) {
        $(liItem).addClass('active');
    }

    function updateMenuActiveItemProcedureByUrl(url) {
        var aItem = $('#divMenu').find('a[href$="'+url+'"]');
        console.log(aItem);

        /* find parent ul */
        var ulItem = aItem.closest('ul')[0];
        console.log(ulItem);
        updateMenuActiveItemProcedureCommon(aItem, ulItem);
    }

    /* set the current active item and remove class for previously selected item */
    function updateMenuActiveItemProcedure(aItem) {
        /* find parent ul */
        var ulItem = aItem.closest('ul');
        updateMenuActiveItemProcedureCommon(aItem, ulItem);
    }

    function updateMenuActiveItemProcedureCommon(aItem, ulItem) {
        /* find parent ul */
        var liItems = ulItem.children;
        if (!liItems)
            return;

        /* find all li children */
        let liItemsNum = liItems.length;
        console.log('found ' + liItems.length + ' li');
        for (i = 0; i < liItemsNum; i++) {
            $(liItems[i]).removeClass('active');
        }

        var selectedIlItem = aItem.closest('li');
        setActiveItem(selectedIlItem);
    }

    /* ################################################################################ */
    /* PAGE INTRO */
    /* ################################################################################ */
    function animateShowIntro() {
        if (isFirstLoading)
            return;

        isFirstLoading = false;
        showByClass('pageCoverLogo');
        animateCSS('pageCoverLogo', 'fadeIn', FASTER);

        window.removeEventListener('load', animateShowIntro);
    }

    function animateHideIntro(extcallback) {
        let callback = function () {
            $('#pageCover').remove();

            showPageItems(extcallback);
        };

        animateCSS('pageCover', 'fadeOut', FASTER, callback);
    }

    function showPageItems(extcallback){
        showByClass('leftMenu');
        animateCSS('leftMenu', 'fadeIn', FASTER);

        showByClass('appbar');
        animateCSS('appbar', 'fadeIn', FASTER);

        showByClass('renderbody');
        animateCSS('renderbody', 'fadeIn', FASTER, extcallback);
    }

    window.addEventListener("load", animateShowIntro);
</script>