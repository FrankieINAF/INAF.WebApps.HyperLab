@using Enums = INAF.Libraries.Net.HyperLab.CommonModels.Values;
@using INAF.Libraries.Net.CommonWebAppHelpers
@using INAF.Libraries.Net.Extensions
@using INAF.WebApps.HyperLab.Controllers
@using INAF.WebApps.HyperLab.Resources
@using static INAF.Libraries.Net.ScienceModels.Values.Enums
@using static INAF.WebApps.HyperLab.Values.Enums

<script type="text/javascript">
    var UrlHome = '/@GenericHelper.GetControllerName(nameof(HomeController))/@nameof(HomeController.Index)';

    var UTC_OFFSET_HOURS = @System.TimeZoneInfo.Local.GetUtcOffset(DateTime.Now).Hours;

    var JS_DELAY_200 = 200
    var JS_DELAY_500 = 500;

    var INFO_LABEL = '@Html.Raw(SharedResources.InfoLabel)';
    var WARNING_LABEL = '@Html.Raw(SharedResources.WarningLabel)';
    var ERROR_LABEL = '@Html.Raw(SharedResources.ErrorLabel)';

    var CANCEL_LABEL = '@Html.Raw(SharedResources.CancelLabel)';
    var OK_LABEL = '@Html.Raw(SharedResources.OkLabel)';
    var YES_LABEL = '@Html.Raw(SharedResources.YesLabel)';
    var NO_LABEL = '@Html.Raw(SharedResources.NoLabel)';

    var DeleteLabel = "@SharedResources.DeleteLabel";
    var EditLabel = "@SharedResources.EditLabel";

    var MINERAL_TYPE_NONE = @{@((int)Enums.Enums.MineralType.None);};
    var MINERAL_TYPE_MONOMINERALIC = @{@((int)Enums.Enums.MineralType.Monomineralic);};
    var MINERAL_TYPE_AMORPHOUS = @{@((int)Enums.Enums.MineralType.Amorphous);};
    var MINERAL_TYPE_MIX = @{@((int)Enums.Enums.MineralType.Mix);};
    var MINERAL_TYPE_ROCK = @{@((int)Enums.Enums.MineralType.Rock);};
    var MINERAL_TYPE_EXTRATERRESTRIAL = @{@((int)Enums.Enums.MineralType.Extraterrestrial);};

    var SMOOTHING_TYPE_BY_SEGMENTS = @{@((int)Enums.Enums.SmoothingType.BySegments);};
    var SMOOTHING_TYPE_WHOLE_SPECTRUM = @{@((int)Enums.Enums.SmoothingType.WholeSpectrum);};

    var SPECTRUM_TYPE_NONE = @{@((int)SpectrumType.None);};
    var SPECTRUM_TYPE_RAW = @{@((int)SpectrumType.Raw);};
    var SPECTRUM_TYPE_REF = @{@((int)SpectrumType.Ref);};
    var SPECTRUM_TYPE_REF_WHITE = @{@((int)SpectrumType.RefWhite);};
    var SPECTRUM_TYPE_ALIGNED = @{@((int)SpectrumType.Aligned);};
    var SPECTRUM_TYPE_ALIGNED_SMOOTHED_BY_SEGMENTS = @{@((int)SpectrumType.AlignedSmoothedBySegments);};
    var SPECTRUM_TYPE_ALIGNED_SMOOTHED = @{@((int)SpectrumType.AlignedSmoothed);};
    var SPECTRUM_TYPE_CONTINUUM = @{@((int)SpectrumType.Continuum);};
    var SPECTRUM_TYPE_CONTINUUM_REMOVED = @{@((int)SpectrumType.ContinuumRemoved);};
    var SPECTRUM_TYPE_CONTINUUM_REMOVED_SMOOTHED_BY_SEGMENTS = @{@((int)SpectrumType.ContinuumRemovedSmoothedBySegments);};
    var SPECTRUM_TYPE_CONTINUUM_REMOVED_SMOOTHED = @{@((int)SpectrumType.ContinuumRemovedSmoothed);};

    var CONTROLLER_OPERATION_NONE = @{@((int)ControllerOperationStatus.None);};
    var CONTROLLER_OPERATION_OK = @{@((int)ControllerOperationStatus.Ok);};
    var CONTROLLER_OPERATION_MODEL_INVALID = @{@((int)ControllerOperationStatus.ModelInvalid);};
    var CONTROLLER_OPERATION_ERROR = @{@((int)ControllerOperationStatus.UpsertError);};

    var SPECTRUM_LEVEL_SINGLE_ACQUISITION = @{@((int)SpectrumLevel.SingleAcquisition);};
    var SPECTRUM_LEVEL_AVERAGED = @{@((int)SpectrumLevel.Averaged);};

    var SPECTRUM_SOURCE_EXTERNAL = @{@((int)SpectrumSource.External);};
    var SPECTRUM_SOURCE_SLAB = @{@((int)SpectrumSource.SLab);};

    function getSpectrumLevelString(spectrumLevel) {
        let spectrumLevelText = 'SLab';
        switch (spectrumLevel) {
            case 1:
                spectrumLevelText = '@SpectrumLevel.SingleAcquisition.ToString()';
            break;

            case 2:
                spectrumLevelText = '@SpectrumLevel.Averaged.ToString()';
            break;
        }

        return spectrumLevelText;
    }

    function getSearchTypeString(searchType) {
        let searchTypeText = 'SimpleByFilename';
        switch (searchType) {
            case 1:
                searchTypeText = '@Enums.Enums.SearchType.SimpleByFilename.ToString()';
            break;

            case 2:
                searchTypeText = '@Enums.Enums.SearchType.SimpleByMaterial.ToString()';
            break;

            case 3:
                searchTypeText = '@Enums.Enums.SearchType.SimpleByMineralType.ToString()';
            break;

            case 4:
                searchTypeText = '@Enums.Enums.SearchType.SimpleByOriginType.ToString()';
            break;

            case 5:
                searchTypeText = '@Enums.Enums.SearchType.SimpleBySampleName.ToString()';
            break;

            case 6:
                searchTypeText = '@Enums.Enums.SearchType.SimpleBySampleType.ToString()';
            break;

            case 7:
                searchTypeText = '@Enums.Enums.SearchType.Complex.ToString()';
            break;
        }

        return searchTypeText;
    }

    function getSpectrumSourceString(spectrumSource) {
        let spectrumSourceText = 'SLab';
        switch (spectrumSource) {
            case 1:
                spectrumSourceText = '@SpectrumSource.SLab.ToString()';
            break;

            case 2:
                spectrumSourceText = '@SpectrumSource.External.ToString()';
            break;
        }

        return spectrumSourceText;
    }

    function getSpectrumTypeDescription(spectrumType) {
        let spectrumTypeText = 'Raw';
        switch (spectrumType) {
            case 2:
                spectrumTypeText = '@SpectrumType.Raw.GetDescription()';
            break;

            case 3:
                spectrumTypeText = '@SpectrumType.Ref.GetDescription()';
            break;

            case 4:
                spectrumTypeText = '@SpectrumType.RefWhite.GetDescription()';
            break;

            case 5:
                spectrumTypeText = '@SpectrumType.Aligned.GetDescription()';
            break;

            case 6:
                spectrumTypeText = '@SpectrumType.AlignedSmoothedBySegments.GetDescription()';
            break;

            case 7:
                spectrumTypeText = '@SpectrumType.AlignedSmoothed.GetDescription()';
            break;

            case 8:
                spectrumTypeText = '@SpectrumType.Continuum.GetDescription()';
            break;

            case 9:
                spectrumTypeText = '@SpectrumType.ContinuumRemoved.GetDescription()';
            break;

            case 10:
                spectrumTypeText = '@SpectrumType.ContinuumRemovedSmoothedBySegments.GetDescription()';
            break;

            case 11:
                spectrumTypeText = '@SpectrumType.ContinuumRemovedSmoothed.GetDescription()';
            break;
        }

        return spectrumTypeText;
    }

    function getSpectrumTypeString(spectrumType) {
        let spectrumTypeText = 'Raw';
        switch (spectrumType) {
            case 1:
                spectrumTypeText = '@SpectrumType.None.ToString()';
                break;

            case 2:
                spectrumTypeText = '@SpectrumType.Raw.ToString()';
                break;

            case 3:
                spectrumTypeText = '@SpectrumType.Ref.ToString()';
                break;

            case 4:
                spectrumTypeText = '@SpectrumType.RefWhite.ToString()';
                break;

            case 5:
                spectrumTypeText = '@SpectrumType.Aligned.ToString()';
                break;

            case 6:
                spectrumTypeText = '@SpectrumType.AlignedSmoothedBySegments.ToString()';
                break;

            case 7:
                spectrumTypeText = '@SpectrumType.AlignedSmoothed.ToString()';
                break;

            case 8:
                spectrumTypeText = '@SpectrumType.Continuum.ToString()';
                break;

            case 9:
                spectrumTypeText = '@SpectrumType.ContinuumRemoved.ToString()';
                break;

            case 10:
                spectrumTypeText = '@SpectrumType.ContinuumRemovedSmoothedBySegments.ToString()';
                break;

            case 11:
                spectrumTypeText = '@SpectrumType.ContinuumRemovedSmoothed.ToString()';
                break;
        }

        return spectrumTypeText;
    }

    function getSpectrumTypeValue(spectrumTypeString) {
        let spectrumTypeValue = 'Raw';
        switch (spectrumTypeString) {
            case 1:
                spectrumTypeValue = SPECTRUM_TYPE_NONE;
                break;

            case '@SpectrumType.Raw.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_RAW;
                break;

            case '@SpectrumType.Ref.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_REF;
                break;

            case '@SpectrumType.RefWhite.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_REF_WHITE;
                break;

            case '@SpectrumType.Aligned.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_ALIGNED;
                break;

            case '@SpectrumType.AlignedSmoothedBySegments.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_ALIGNED_SMOOTHED_BY_SEGMENTS;
                break;

            case '@SpectrumType.AlignedSmoothed.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_ALIGNED_SMOOTHED;
                break;

            case '@SpectrumType.Continuum.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_CONTINUUM;
                break;

            case '@SpectrumType.ContinuumRemoved.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_CONTINUUM_REMOVED;
                break;

            case '@SpectrumType.ContinuumRemovedSmoothedBySegments.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_CONTINUUM_REMOVED_SMOOTHED_BY_SEGMENTS;
                break;

            case '@SpectrumType.ContinuumRemovedSmoothed.ToString()':
                spectrumTypeValue = SPECTRUM_TYPE_CONTINUUM_REMOVED_SMOOTHED;
                break;
        }

        return spectrumTypeValue;
    }

    function navigateToHome() {
        navigateTo('/@GenericHelper.GetControllerName(nameof(HomeController))/@nameof(HomeController.Index)/');
    }

    $('.menuhref').click(function(e) {
        //console.log(this.href);
        var url = this.href.replace(window.location.origin, '');
        loadPartialView(url);
        e.preventDefault();
        e.stopPropagation();
        updateMenuActiveItemProcedure(this);
    });

    function loadPartialView(url)
    {
        tryClearAppBar();
        $('#renderbody').load(url);
    }

    /* set currently selected item as active */
    function setActiveItem(liItem) {
        $(liItem).addClass('active');
    }

    function updateMenuActiveItemProcedureByUrl(url) {
        var aItem = $('#divMenu').find('a[href$="'+url+'"]');
        console.log(aItem);

        /* find parent ul */
        var ulItem = aItem.closest('ul')[0];
        console.log(ulItem);
        updateMenuActiveItemProcedureCommon(aItem, ulItem);
    }

    /* set the current active item and remove class for previously selected item */
    function updateMenuActiveItemProcedure(aItem) {
        /* find parent ul */
        var ulItem = aItem.closest('ul');
        updateMenuActiveItemProcedureCommon(aItem, ulItem);
    }

    function updateMenuActiveItemProcedureCommon(aItem, ulItem) {
        /* find parent ul */
        var liItems = ulItem.children;
        if (!liItems)
            return;

        /* find all li children */
        let liItemsNum = liItems.length;
        console.log('found ' + liItems.length + ' li');
        for (i = 0; i < liItemsNum; i++) {
            $(liItems[i]).removeClass('active');
        }

        var selectedIlItem = aItem.closest('li');
        setActiveItem(selectedIlItem);
    }
</script>