                                result.isOk = true;
                                result.id = spectrumResult.id;
                                result.segmentsResult = settingsResult.segmentsResult;
                            }
                        }
                    }

                    if (result.isOk)
                        await transaction.CommitAsync();
                    else
                        await transaction.RollbackAsync();
                }
            }

            return result;
        }

        public async Task<(bool isOk, int id, List<SegmentResponseModel> segmentsResult)> saveAsCopySpectrumFileOfTypeSmoothedProcedureAsync(SaveSpectrumOfTypeSmoothedRequestModel saveSpectrumRequest,
                                                                                                                                             int operationUserId,
                                                                                                                                             int scientificResponsibleUserId)
        {
            (bool isOk, int id, List<SegmentResponseModel> segmentsResult) result = (false, int.MinValue, new List<SegmentResponseModel>());

            if (saveSpectrumRequest.SpectrumFile == null ||
                saveSpectrumRequest.SpectrumFile.ParentId == null ||
                string.IsNullOrEmpty(saveSpectrumRequest.SpectrumFile.Filename) ||
                string.IsNullOrEmpty(saveSpectrumRequest.SpectrumFile.Xml) ||
                saveSpectrumRequest.SmoothingSettings == null ||
                saveSpectrumRequest.SmoothingSettings.Segments == null)
                return result;

            using (var context = getDataContext())
            {
                using (var transaction = context.Database.BeginTransaction())
                {
                    int version = getSpectrumFileVersion((int)saveSpectrumRequest.SpectrumFile.ParentId, context);

                    (bool isOk, int id) addFileResult = await addSpectrumFileAsync(saveSpectrumRequest.SpectrumFile.Filename,
                                                                                   saveSpectrumRequest.SpectrumFile.Type,
                                                                                   saveSpectrumRequest.SpectrumFile.ParentId,
                                                                                   saveSpectrumRequest.SpectrumFile.Level,
                                                                                   saveSpectrumRequest.SpectrumFile.Source,
                                                                                   saveSpectrumRequest.EnvironmentType,
                                                                                   saveSpectrumRequest.SpectrumFile.Description,
                                                                                   saveSpectrumRequest.SpectrumFile.Xml,
                                                                                   operationUserId,
                                                                                   scientificResponsibleUserId,
                                                                                   context);

                    if (addFileResult.isOk)
                    {
                        /* save file id */
                        result.id = addFileResult.id;

                        /* save file version */
                        if (await setSpectrumFileVersionAsync(addFileResult.id,
                                                              (int)saveSpectrumRequest.SpectrumFile.ParentId,
                                                              version,
                                                              operationUserId,
                                                              context))
                        {
                            (bool isOk, List<SegmentResponseModel> segmentsResult) settingsResult = await upsertSmoothingSettingsProcedureAsync(addFileResult.id,
                                                                                                                                                saveSpectrumRequest.SmoothingSettings.Segments,
                                                                                                                                                operationUserId,
                                                                                                                                                context);

                            if (settingsResult.isOk)
                            {
                                if (await removeNotUsedSmoothingSegmentsAsync(addFileResult.id,
                                                                              saveSpectrumRequest.SmoothingSettings.Segments,
                                                                              operationUserId,
                                                                              context))
                                {
                                    result.isOk = true;
                                    result.id = addFileResult.id;
                                    result.segmentsResult = settingsResult.segmentsResult;
                                }
                            }

                            result.isOk = settingsResult.isOk;
                        }
                    }

                    /* close transaction */
                    if (result.isOk)
                        await transaction.CommitAsync();
                    else
                        await transaction.RollbackAsync();
                }
            }

            return result;
        }

        /* save INFO (SAMPLE DATA + MEASUREMENT INFO) */
        public async Task<(bool isOk, int id)> saveSpectrumInfoProcedureAsync(InfoSelectedValuesModel infoSelectedValues,
                                                                              int operationUserId,
                                                                              int scientificResponsibleId)
        {
            (bool isOk, int id) result = (false, int.MinValue);

            if (infoSelectedValues == null ||
                string.IsNullOrEmpty(infoSelectedValues.Name) ||
                infoSelectedValues.SampleDataSelectedValues == null ||
                infoSelectedValues.SpectrumFileMeasurementInfoValues == null)
                return result;

            using (var context = getDataContext())
            {
                using (var transaction = context.Database.BeginTransaction())
                {
                    result.id = infoSelectedValues.FileId;

                    if (!await upsertSampleDataAsync(infoSelectedValues.FileId,
                                                     infoSelectedValues.Name,
                                                     infoSelectedValues.SampleDataSelectedValues.SampleTypeId,
                                                     infoSelectedValues.SampleDataSelectedValues.GrainSizeTypeId,
                                                     infoSelectedValues.SampleDataSelectedValues.GrainSizeLowerValueId,
                                                     infoSelectedValues.SampleDataSelectedValues.GrainSizeUpperValueId,
                                                     infoSelectedValues.SampleDataSelectedValues.OriginTypeId,
                                                     infoSelectedValues.SampleDataSelectedValues.MineralTypeId,
                                                     infoSelectedValues.SampleDataSelectedValues.Minerals,
                                                     infoSelectedValues.SampleDataSelectedValues.Rock!,
                                                     infoSelectedValues.SampleDataSelectedValues.MeteoriteClass!,
                                                     operationUserId,
                                                     context))
                    {
                        await transaction.RollbackAsync();
                        return result;
                    }

                    if (!await upsertMeasurementInfoAsync(infoSelectedValues.FileId,
                                                          infoSelectedValues.SpectrumFileMeasurementInfoValues.NumOfAcquiredSpectra,
                                                          infoSelectedValues.SpectrumFileMeasurementInfoValues.NumOfAcquisitionsForSpectrum,
                                                          infoSelectedValues.SpectrumFileMeasurementInfoValues.IncidenceAngle,
                                                          infoSelectedValues.SpectrumFileMeasurementInfoValues.EmissionAngle,
                                                          operationUserId,
                                                          context))
                    {
                        await transaction.RollbackAsync();
                        return result;
                    }

                    if (infoSelectedValues.SpectrumFileMeasurementInfoValues.InputSpectra?.Count > 0)
                        result.isOk = await upsertInputFilesAsync(infoSelectedValues.FileId,
                                                                  infoSelectedValues.SpectrumFileMeasurementInfoValues.InputSpectra,
                                                                  infoSelectedValues.EnvironmentType,
                                                                  operationUserId,
                                                                  scientificResponsibleId,
                                                                  context);
                    else
                    {
                        result.isOk = true;
                        result.id = infoSelectedValues.FileId;
                    }

                    if (result.isOk)
                        await transaction.CommitAsync();
                    else
                        await transaction.RollbackAsync();
                }
            }

            return result;
        }

        #region private
        private int getSpectrumFileVersion(int parentId,
                                           HyperLabDataContext? extcontext = null)
        {
            int version = int.MinValue;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                var items = (from x in context.SpectrumFileVersions.AsNoTrackingWithIdentityResolution()
                             where x.SpectrumFileParentId == parentId
                             && !x.IsDeleted
                             select x.Version)
                             .ToList();

                if (items?.Count > 0)
                {
                    version = items.Max() + 1;
                }
                else
                    version = 1;
            }
            catch (Exception ex)
            {
                logError(nameof(getSpectrumFileVersion), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return version;
        }

