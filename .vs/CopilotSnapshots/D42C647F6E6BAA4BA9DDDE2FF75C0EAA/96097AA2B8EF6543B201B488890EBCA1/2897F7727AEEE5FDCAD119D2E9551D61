        private SpectraFiles? queryGetSpectrumFromId(int id,
                                                     int operationUserId,
                                                     HyperLabDataContext context)
        {
            return (from s in context.SpectraFiles
                    where s.Id == id
                    && !s.IsDeleted
                    select s)
                    .AsEnumerable()
                    .FirstOrDefault(x => isUserAuthorized(x, operationUserId) || isSpectrumSharedWithUser(context, x, operationUserId));
        }

        private SpectraFiles? queryGetSpectrumFromIdAsNoTracking(int id,
                                                                 int operationUserId,
                                                                 HyperLabDataContext context)
        {
            return (from s in context.SpectraFiles
                    where s.Id == id
                    && !s.IsDeleted
                    select s)
                    .AsNoTrackingWithIdentityResolution()
                    .AsEnumerable()
                    .FirstOrDefault(x => isUserAuthorized(x, operationUserId) || isSpectrumSharedWithUser(context, x, operationUserId));
        }

        private SpectraFiles? queryGetSpectrumFromNameAndType(string name,
                                                              int typeId,
                                                              int sourceId,
                                                              int levelId,
                                                              int operationUserId,
                                                              HyperLabDataContext context)
        {
            return queryGetQueryFromNameAndType(name,
                                                typeId,
                                                sourceId,
                                                levelId,
                                                operationUserId,
                                                context)?
                   .FirstOrDefault();
        }

        private IEnumerable<SpectraFiles>? queryGetQueryFromNameAndType(string name,
                                                                        int typeId,
                                                                        int sourceId,
                                                                        int levelId,
                                                                        int operationUserId,
                                                                        HyperLabDataContext context)
        {
            return (from sf in context.SpectraFiles
                    where EF.Functions.Like(sf.Filename, $"{name}%")
                    && sf.TypeId == typeId
                    && sf.SourceId == sourceId
                    && sf.LevelId == levelId
                    && !sf.IsDeleted
                    select sf)
                    .AsNoTrackingWithIdentityResolution()
                    .AsEnumerable()
                    .Where(x => isUserAuthorized(x, operationUserId) || isSpectrumSharedWithUser(context, x, operationUserId));
        }
