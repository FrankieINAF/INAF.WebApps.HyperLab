        #region SAVE
        /* save ALIGNED file */
        public async Task<(bool isOk, int id)> saveSpectrumFileOfTypeAlignedProcedureAsync(SaveSpectrumOfTypeAlignedRequestModel saveSpectrumRequest,
                                                                                           int operationUserId,
                                                                                           int scientificResponsibleUserId)
        {
            (bool isOk, int id) result = (false, int.MinValue);

            if (saveSpectrumRequest.SpectrumFile == null ||
                string.IsNullOrEmpty(saveSpectrumRequest.SpectrumFile.Filename) ||
                string.IsNullOrEmpty(saveSpectrumRequest.SpectrumFile.Xml) ||
                saveSpectrumRequest.AlignmentSettings == null ||
                saveSpectrumRequest.AlignmentSettings.AlignmentSegmentBoundaries == null ||
                saveSpectrumRequest.ParentFiles == null ||
                saveSpectrumRequest.ParentFiles.RefFile == null ||
                saveSpectrumRequest.ParentFiles.RefWhiteFile == null)
                return result;

            using (var context = getDataContext())
            {
                using (var transaction = context.Database.BeginTransaction())
                {
                    /* 1) upsert spectrum data */
                    result = await upsertSpectrumFileAsync(saveSpectrumRequest.SpectrumFile.Id,
                                                           saveSpectrumRequest.SpectrumFile.Filename,
                                                           saveSpectrumRequest.SpectrumFile.Type,
                                                           saveSpectrumRequest.SpectrumFile.ParentId,
                                                           saveSpectrumRequest.SpectrumFile.Level,
                                                           saveSpectrumRequest.SpectrumFile.Source,
                                                           saveSpectrumRequest.EnvironmentType,
                                                           saveSpectrumRequest.SpectrumFile.Description,
                                                           saveSpectrumRequest.SpectrumFile.Xml,
                                                           operationUserId,
                                                           scientificResponsibleUserId,
                                                           context);

                    if (result.isOk)
                    {
                        (bool isOk, int id) alignmentSettingsResult = await upsertSpectrumAlignmentSettingsAsync(saveSpectrumRequest.AlignmentSettings.NumOfPoints,
                                                                                                                 saveSpectrumRequest.AlignmentSettings.AlignmentSegmentBoundaries.Min,
                                                                                                                 saveSpectrumRequest.AlignmentSettings.AlignmentSegmentBoundaries.Max,
                                                                                                                 result.id,
                                                                                                                 saveSpectrumRequest.ParentFiles.RefFile.Id,
                                                                                                                 saveSpectrumRequest.ParentFiles.RefWhiteFile.Id,
                                                                                                                 operationUserId,
                                                                                                                 context);

                        if (alignmentSettingsResult.isOk)
                            result.isOk = await upsertLinkSpectrumFileAlignmentSettingsAsync(result.id,
                                                                                             alignmentSettingsResult.id,
                                                                                             operationUserId,
                                                                                             context);
                        else
                            result.isOk &= alignmentSettingsResult.isOk;
                    }

                    if (result.isOk)
                        await transaction.CommitAsync();
                    else
                        await transaction.RollbackAsync();
                }
            }

            return result;
        }

        /* upsert CONTINUUM-REMOVED file */
        /* NEW COPY */
        public async Task<(bool isOk, int id, List<SegmentResponseModel> segmentsResult)> saveAsCopySpectrumFileOfTypeContinuumRemovedProcedureAsync(SaveSpectrumOfTypeContinuumRemovedRequestModel saveSpectrumRequest,
                                                                                                                                                     int operationUserId,
                                                                                                                                                     int scientificResponsibleUserId)
        {
            (bool isOk, int id, List<SegmentResponseModel> segmentsResult) result = (false, int.MinValue, new List<SegmentResponseModel>());

            if (saveSpectrumRequest.SpectrumFile == null ||
                saveSpectrumRequest.SpectrumFile.ParentId == null ||
                string.IsNullOrEmpty(saveSpectrumRequest.SpectrumFile.Filename) ||
                string.IsNullOrEmpty(saveSpectrumRequest.SpectrumFile.Xml) ||
                saveSpectrumRequest.ContinuumRemovalSettings == null ||
                saveSpectrumRequest.ContinuumRemovalSettings.Segments == null)
                return result;

            using (var context = getDataContext())
            {
                using (var transaction = context.Database.BeginTransaction())
                {
                    int version = getSpectrumFileVersion((int)saveSpectrumRequest.SpectrumFile.ParentId, context);

                    (bool isOk, int id) addFileResult = await addSpectrumFileAsync(saveSpectrumRequest.SpectrumFile.Filename,
                                                                                   saveSpectrumRequest.SpectrumFile.Type,
                                                                                   saveSpectrumRequest.SpectrumFile.ParentId,
                                                                                   saveSpectrumRequest.SpectrumFile.Level,
                                                                                   saveSpectrumRequest.SpectrumFile.Source,
                                                                                   saveSpectrumRequest.EnvironmentType,
                                                                                   saveSpectrumRequest.SpectrumFile.Description,
                                                                                   saveSpectrumRequest.SpectrumFile.Xml,
                                                                                   operationUserId,
                                                                                   scientificResponsibleUserId,
                                                                                   context);

                    if (addFileResult.isOk)
                    {
                        /* save file id */
                        result.id = addFileResult.id;

                        /* save file version */
                        if (await setSpectrumFileVersionAsync(addFileResult.id,
                                                              (int)saveSpectrumRequest.SpectrumFile.ParentId,
                                                              version,
                                                              operationUserId,
                                                              context))
                        {
                            /* save segments for continuum */
                            (bool isOk, List<SegmentResponseModel> segmentsResult) continuumResult = await upsertContinuumFitSettingsAsync(addFileResult.id,
                                                                                                                                           saveSpectrumRequest.ContinuumRemovalSettings.NumOfPointsForAveragingMissingPointX,
                                                                                                                                           saveSpectrumRequest.ContinuumRemovalSettings.FitModeId,
                                                                                                                                           saveSpectrumRequest.ContinuumRemovalSettings.Segments,
                                                                                                                                           operationUserId,
                                                                                                                                           context);

                            result.isOk = continuumResult.isOk;
                        }
                    }

                    /* close transaction */
                    if (result.isOk)
                        await transaction.CommitAsync();
                    else
                        await transaction.RollbackAsync();
                }
            }

            return result;
        }

