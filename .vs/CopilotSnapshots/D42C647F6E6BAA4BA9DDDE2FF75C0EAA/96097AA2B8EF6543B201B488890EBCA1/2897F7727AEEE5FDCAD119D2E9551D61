        public IEnumerable<SpectrumVersionModel>? getSpectrumVersions(string filename,
                                                                      SpectrumType spectrumType,
                                                                      SpectrumSource spectrumSource,
                                                                      SpectrumLevel spectrumLevel,
                                                                      int operationUserId)
        {
            IEnumerable<SpectrumVersionModel>? spectrumVersions = null;

            using (var context = getDataContext())
            {
                try
                {
                    var query = queryGetQueryFromNameAndType(filename,
                                                             (int)spectrumType,
                                                             (int)spectrumSource,
                                                             (int)spectrumLevel,
                                                             operationUserId,
                                                             context);

                    if (query != null && query.Any())
                    {
                        spectrumVersions = query
                                            .Select(x => new SpectrumVersionModel()
                                            {
                                                Id = x.Id,
                                                Filename = x.Filename,
                                                ParentId = x.ParentId,
                                                Type = x.TypeId.ToSpectrumType(),
                                                Level = x.LevelId.ToSpectrumLevel(),
                                                InsertDateTime = x.InsertDateTime
                                            })
                                            .OrderByDescending(x => x.InsertDateTime)
                                            .ToList();

                        foreach (var spectrumVersion in spectrumVersions)
                        {
                            var points = executeRawSqlQueryForList<PointModel>($"exec dbo.GetSpectrumElements @id={spectrumVersion.Id}",
                                                                               x => new PointModel(Convert.ToDouble(x[0]), Convert.ToDouble(x[1])),
                                                                               context);
                            spectrumVersion.Points = points;
                        }
                    }
                }
                catch (Exception ex)
                {
                    logError(nameof(getSpectrumVersions), ex);
                }
            }

            return spectrumVersions;
        }

        public (bool isOk, int id) isAnySpectrumTypeSaved(string filename,
                                                          IEnumerable<SpectrumType> spectrumTypes,
                                                          int operationUserId)
        {
            (bool isSaved, int id) result = (false, int.MinValue);

            try
            {
                using (var context = getDataContext())
                {
                    IEnumerable<int> spectrumTypeValues = spectrumTypes.Cast<int>();

                    var item = (from x in context.SpectraFiles
                                where x.Filename.Equals(filename)
                                && spectrumTypeValues.Contains(x.TypeId)
                                && !x.IsDeleted
                                select x)
                                .AsNoTrackingWithIdentityResolution()
                                .AsEnumerable()
                                .FirstOrDefault(x => isUserAuthorized(x, operationUserId) || isSpectrumSharedWithUser(context, x, operationUserId));

                    if (item != null)
                    {
                        result.isSaved = true;
                        result.id = item.Id;
                    }
                }
            }
            catch (Exception ex)
            {
                logError(nameof(isAnySpectrumTypeSaved), ex);
            }

            return result;
        }

