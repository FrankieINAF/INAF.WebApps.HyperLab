            List<SpectrumType> childrenSpectraTypes = new List<SpectrumType>();

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                childrenSpectraTypes = (from x in context.ReadOnlyLinkSpectrumTypeChildrenSpectraTypes.AsNoTrackingWithIdentityResolution()
                                        where x.SpectrumTypeId == (int)spectrumType
                                        select x.ChildSpectrumTypeId.ToSpectrumType())
                                        .ToList();
            }
            catch (Exception ex)
            {
                logError(nameof(getChildrenSpectraTypes), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return childrenSpectraTypes;
        }

        private int getChildIdForSpectrumType(int parentId,
                                              SpectrumType spectrumType,
                                              HyperLabDataContext? extcontext = null)
        {
            int childrenId = int.MinValue;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                childrenId = (from st in context.SpectraFiles.AsNoTrackingWithIdentityResolution()
                              where st.ParentId == parentId
                              && st.TypeId == (int)spectrumType
                              && !st.IsDeleted
                              select st.Id)
                              .FirstOrDefault();
            }
            catch (Exception ex)
            {
                logError(nameof(getChildIdForSpectrumType), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return childrenId;
        }
