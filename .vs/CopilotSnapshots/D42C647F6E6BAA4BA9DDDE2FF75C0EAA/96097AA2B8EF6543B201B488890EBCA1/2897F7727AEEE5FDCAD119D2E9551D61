        public async Task<bool> deleteSpectrumFileProcedureAsync(int id,
                                                                 int operationUserId,
                                                                 HyperLabDataContext? extcontext = null,
                                                                 IDbContextTransaction? exttransaction = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            IDbContextTransaction transaction = getDataContextTransaction(context, exttransaction);

            try
            {
                /* retrieve spectrum type */
                SpectrumType spectrumType = getSpectrumFileType(id,
                                                                operationUserId,
                                                                context);

                System.Diagnostics.Debug.WriteLine($"{nameof(deleteSpectrumFileProcedureAsync)} - id: {id}, spectrumType: {spectrumType.ToString()}");
                if (await deleteSpectrumFileAsync(id, operationUserId, context))
                {
                    switch (spectrumType)
                    {
                        case SpectrumType.Raw:
                            isOk = await deleteRawSpectrumFileRelatedDataProcedureAsync(id,
                                                                                        operationUserId,
                                                                                        context);
                            break;
                        case SpectrumType.Ref:
                            break;
                        case SpectrumType.Aligned:
                            /* delete alignment settings */
                            isOk = await deleteAlignmentSettingsAsync(id,
                                                                      operationUserId,
                                                                      context);
                            break;
                        case SpectrumType.RefWhite:
                            break;
                        case SpectrumType.Continuum:
                            break;
                        case SpectrumType.ContinuumRemoved:
                            /* delete settings for continuum removal */
                            isOk = await deleteContinuumRemovedSettingsAsync(id,
                                                                             operationUserId,
                                                                             context);
                            break;
                    }

                    isOk = await deleteChildrenSpectraTypesAsync(id,
                                                                 spectrumType,
                                                                 operationUserId,
                                                                 context,
                                                                 transaction);
                }
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(deleteSpectrumFileProcedureAsync), ex);
            }

            if (exttransaction == null)
            {
                if (isOk)
                    await transaction.CommitAsync();
                else
                    await transaction.RollbackAsync();

                transaction.Dispose();
            }

            if (extcontext == null)
                closeDataContext(context);

            return isOk;
        }

        #region private
        private async Task<bool> deleteSpectrumFileAsync(int id,
                                                         int operationUserId,
                                                         HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                var spectrum = queryGetSpectrumFromId(id,
                                                      operationUserId,
                                                      context);

                if (spectrum == null)
                    return false;

                System.Diagnostics.Debug.WriteLine($"deleting id: {id}, spectrumType: {spectrum.TypeId.ToSpectrumType().ToString()}...");
                spectrum.IsDeleted = true;
                spectrum.DeleteDateTime = DateTime.UtcNow;
                spectrum.DeleteUserId = operationUserId;

                await context.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(deleteSpectrumFileAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return isOk;
        }

        private async Task<bool> deleteChildrenSpectraTypesAsync(int id,
                                                                 SpectrumType spectrumType,
                                                                 int operationUserId,
                                                                 HyperLabDataContext? extcontext = null,
                                                                 IDbContextTransaction? exttransaction = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                IEnumerable<SpectrumType> childrenSpectraTypes = getChildrenSpectraTypes(spectrumType,
                                                                                         context);
                /* if no children spectra types are found, then we're finished */
                if (!childrenSpectraTypes.Any())
                    return true;

                foreach (var childSpectrumType in childrenSpectraTypes)
                {
                    System.Diagnostics.Debug.Write($"testing parentId: {id}, spectrumType: {childSpectrumType.ToString()}...");
                    int childId = getChildIdForSpectrumType(id,
                                                            childSpectrumType,
                                                            context);

                    /* if no child id is found, then skip this step */
                    if (childId == int.MinValue || childId == 0)
                    {
                        System.Diagnostics.Debug.WriteLine("NO");
                        continue;
                    }

                    System.Diagnostics.Debug.WriteLine("");
                    //System.Diagnostics.Debug.WriteLine($"deleting id: {childId}...");
                    if (!await deleteSpectrumFileProcedureAsync(childId,
                                                                operationUserId,
                                                                context,
                                                                exttransaction))
                        return false;
                }
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(deleteChildrenSpectraTypesAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return isOk;
        }

