        public async Task<bool> deleteRecursivelyChildrenAsync(int parentId,
                                                               SpectrumType spectrumType,
                                                               int operationUserId)
        {
            bool isOk = true;

            using (var context = getDataContext())
            {
                try
                {
                    List<int> ids = executeRawSqlQueryForList<int>($"WITH cte AS (" +
                                                                   $"SELECT Id, ParentId, TypeId, IsDeleted " +
                                                                   $"FROM SpectraFiles " +
                                                                   $"WHERE Id = ${parentId} " +
                                                                   $"AND {getUserAuthorizationFilter(operationUserId)} " +
                                                                   $"AND IsDeleted = 0 " +
                                                                   $"UNION ALL " +
                                                                   $"SELECT sf.Id, sf.ParentId, sf.TypeId, sf.IsDeleted " +
                                                                   $"FROM cte INNER JOIN SpectraFiles sf on cte.id = sf.ParentId) " +
                                                                   $"SELECT Id " +
                                                                   $"FROM cte where TypeId > {(int)spectrumType} " +
                                                                   $"AND cte.IsDeleted = 0",
                                                                   x => Convert.ToInt32(x[0]),
                                                                   context);

                    if (ids.Any())
                    {
                        foreach (var id in ids)
                        {
                            isOk = await deleteSpectrumFileProcedureAsync(id,
                                                                          operationUserId,
                                                                          context);
                        }
                    }
                }
                catch (Exception ex)
                {
                    isOk = false;
                    logError(nameof(deleteRecursivelyChildrenAsync), ex);
                }
            }

            return isOk;
        }

