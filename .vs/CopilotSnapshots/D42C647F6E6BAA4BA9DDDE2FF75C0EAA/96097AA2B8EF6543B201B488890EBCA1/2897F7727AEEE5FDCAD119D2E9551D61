                                                                                       saveSpectrumRequest.SpectrumFile.Xml,
                                                                                       operationUserId,
                                                                                       scientificResponsibleUserId,
                                                                                       context);

                    if (spectrumResult.isOk)
                    {
                        (bool isOk, List<SegmentResponseModel> segmentsResult) settingsResult = await upsertSmoothingSettingsProcedureAsync(spectrumResult.id,
                                                                                                                                            saveSpectrumRequest.SmoothingSettings.Segments,
                                                                                                                                            operationUserId,
                                                                                                                                            context);

                        if (settingsResult.isOk)
                        {
                            if (await removeNotUsedSmoothingSegmentsAsync(spectrumResult.id,
                                                                          saveSpectrumRequest.SmoothingSettings.Segments,
                                                                          operationUserId,
                                                                          context))
