        private async Task<(bool isOk, int id)> upsertSpectrumFileAsync(int fileId,
                                                                        string name,
                                                                        SpectrumType spectrumType,
                                                                        int? parentId,
                                                                        SpectrumLevel level,
                                                                        SpectrumSource source,
                                                                        EnvironmentType environmentType,
                                                                        string description,
                                                                        string xml,
                                                                        int operationUserId,
                                                                        int scientificResponsibleUserId,
                                                                        HyperLabDataContext? extcontext = null)
        {
            (bool isOk, int id) result = (false, int.MinValue);

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                (bool isSaved, int id) isSavedResult = isSpectrumTypeSaved(name,
                                                                           spectrumType,
                                                                           source,
                                                                           level,
                                                                           operationUserId,
                                                                           context);

                if (isSavedResult.isSaved)
                {
                    result = await updateSpectrumFileAsync(isSavedResult.id,
                                                           name,
                                                           spectrumType,
                                                           parentId,
                                                           level,
                                                           source,
                                                           environmentType,
                                                           description,
                                                           xml,
                                                           operationUserId,
                                                           scientificResponsibleUserId,
                                                           context);
                    result.id = isSavedResult.id;
                }
                else
                {
                    result = await addSpectrumFileAsync(name,
                                                        spectrumType,
                                                        parentId,
                                                        level,
                                                        source,
                                                        environmentType,
                                                        description,
                                                        xml,
                                                        operationUserId,
                                                        scientificResponsibleUserId,
                                                        extcontext);
                }
            }
            catch (Exception ex)
            {
                result.isOk = false;
                logError(nameof(upsertSpectrumFileAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return result;
        }

        private async Task<(bool isOk, int id)> addSpectrumFileAsync(string name,
                                                                     SpectrumType spectrumType,
                                                                     int? parentId,
                                                                     SpectrumLevel level,
                                                                     SpectrumSource source,
                                                                     EnvironmentType environmentType,
                                                                     string description,
                                                                     string xml,
                                                                     int operationUserId,
                                                                     int scientificResponsibleUserId,
                                                                     HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;
            int id = int.MinValue;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                var file = new SpectraFiles()
                {
                    Filename = name,
                    TypeId = (int)spectrumType,
                    ParentId = (parentId != null ? (int)parentId : null),
                    LevelId = (int)level,
                    SourceId = (int)source,
                    Description = description,
                    XmlContent = xml,

                    OwnerUserId = getScientificResponsibleIdOrUserId(operationUserId, scientificResponsibleUserId, spectrumType),

                    InsertDateTime = DateTime.UtcNow,
                    InsertUserId = operationUserId
                };

                context.SpectraFiles.Add(file);
                await context.SaveChangesAsync();

                id = file.Id;
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(addSpectrumFileAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return (isOk, id);
        }

        private async Task<(bool isOk, int id)> updateSpectrumFileAsync(int id,
                                                                        string name,
                                                                        SpectrumType spectrumType,
                                                                        int? parentId,
                                                                        SpectrumLevel level,
                                                                        SpectrumSource source,
                                                                        EnvironmentType environmentType,
                                                                        string description,
                                                                        string xml,
                                                                        int operationUserId,
                                                                        int scientificResponsibleUserId,
                                                                        HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                var file = (from x in context.SpectraFiles
                            where x.Id == id
                            select x)
                            .FirstOrDefault();

                if (file != null)
                {
                    file.Filename = name;
                    file.TypeId = (int)spectrumType;
                    if (parentId != null)
                        file.ParentId = (int)parentId;
                    file.SourceId = (int)source;
                    file.LevelId = (int)level;
                    file.SourceId = (int)source;
                    file.Description = description;
                    file.XmlContent = xml;

                    file.OwnerUserId = getScientificResponsibleIdOrUserId(operationUserId, scientificResponsibleUserId, spectrumType);

                    file.EditDateTime = DateTime.UtcNow;
                    file.EditUserId = operationUserId;

                    await context.SaveChangesAsync();

                    id = file.Id;
                }
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(updateSpectrumFileAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return (isOk, id);
        }
