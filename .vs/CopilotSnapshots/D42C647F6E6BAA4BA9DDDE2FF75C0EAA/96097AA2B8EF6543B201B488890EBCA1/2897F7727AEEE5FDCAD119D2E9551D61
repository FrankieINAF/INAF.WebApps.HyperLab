        public RawRefSpectrumDataModel? getSpectrumDataInfo(int id,
                                                            int operationUserId)
        {
            RawRefSpectrumDataModel? spectrumModel = null;

            try
            {
                using (var context = getDataContext())
                {
                    var spectrum = queryGetSpectrumFromIdAsNoTracking(id,
                                                                      operationUserId,
                                                                      context);

                    if (spectrum == null)
                        return null;

                    if (spectrum != null && !string.IsNullOrEmpty(spectrum.XmlContent))
                    {
                        XmlHelper xmlHelper = new XmlHelper();

                        XmlDocument doc = new XmlDocument();
                        doc.LoadXml(spectrum.XmlContent);

                        XmlNodeList? elements = doc.SelectNodes("/Spectrum/Elements/Element");

                        int linesNum = elements?.Count ?? 0;

                        double xMin = double.MaxValue;
                        double xMax = double.MinValue;
                        double yMin = double.MaxValue;
                        double yMax = double.MinValue;

                        var firstElement = elements?.Item(0);

                        if (firstElement != null)
                        {
                            string? wavelength = xmlHelper.getAttributeValue(spectrum.XmlContent, "//Element", "Wavelength");
                            xMin = wavelength.ToDoubleInvariant();

                            string? yvalue = xmlHelper.getAttributeValue(spectrum.XmlContent, "//Element", "Value");
                            yMin = yvalue.ToDoubleInvariant();
                        }

                        var lastElement = elements?.Item(linesNum - 1);
                        if (lastElement != null)
                        {
                            string? wavelength = xmlHelper.getAttributeValue(spectrum.XmlContent, "//Element[last()]", "Wavelength");
                            xMax = wavelength.ToDoubleInvariant();

                            string? yvalue = xmlHelper.getAttributeValue(spectrum.XmlContent, "//Element[last()]", "Value");
                            yMax = yvalue.ToDoubleInvariant();
                        }

                        spectrumModel = new RawRefSpectrumDataModel()
                        {
                            LinesNum = linesNum,
                            XRange = [xMin, xMax],
                            YRange = [yMin, yMax]
                        };
                    }
                }
            }
            catch (Exception ex)
            {
                logError(nameof(getSpectrumDataInfo), ex);
            }

            return spectrumModel;

        }

