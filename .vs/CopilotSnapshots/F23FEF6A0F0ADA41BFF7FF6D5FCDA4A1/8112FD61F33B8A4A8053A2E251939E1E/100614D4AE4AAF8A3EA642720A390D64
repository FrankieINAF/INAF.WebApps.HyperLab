        public static IQueryable<SpectraFiles> ApplyAccessFilter(this IQueryable<SpectraFiles> query,
                                                                 HyperLabDataContext context,
                                                                 bool isPublicSearch,
                                                                 int operationUserId)
        {
            if (isPublicSearch)
                return query.Where(x => x.IsPublic);

            return query
                .Where(sf => sf.InsertUserId == operationUserId
                          || sf.OwnerUserId == operationUserId
                          || context.LinkSharesSpectraFiles
                                .Any(lssf => lssf.SpectrumFileId == sf.Id
                                          && !lssf.IsDeleted
                                          && context.Shares
                                                .Any(s => s.Id == lssf.ShareId
                                                       && s.UserId == operationUserId
                                                       && !s.IsDeleted)));
        }

        public static IQueryable<SpectrumFileSampleNameDto> ApplyAccessFilter(this IQueryable<SpectrumFileSampleNameDto> query,
                                                                              HyperLabDataContext context,
                                                                              bool isPublicSearch,
                                                                              int operationUserId)
        {
            if (isPublicSearch)
                return query.Where(x => x.Sf.IsPublic);

            return query
                .Where(x => x.Sf.InsertUserId == operationUserId || x.Sf.OwnerUserId == operationUserId)
                .Where(x => !context.LinkSharesSpectraFiles.Any(ls => ls.SpectrumFileId == x.Sf.Id && ls.IsDeleted))
                .Where(x => !context.LinkSharesSpectraFiles
                    .Where(ls => ls.SpectrumFileId == x.Sf.Id)
                    .Any(ls => context.Shares.Any(ss => ss.Id == ls.ShareId && ss.IsDeleted)));
        }

        public static FileSpectrumModel ToSpectrumModel(this SpectraFiles spectrum)
        {
            //var elements = new List<PointModel>();

            return new FileSpectrumModel()
            {
                Id = spectrum.Id,
                Filename = spectrum.Filename,
                ParentId = spectrum.ParentId,
                Type = spectrum.TypeId.ToSpectrumType(),
                Level = spectrum.LevelId.ToSpectrumLevel(),
                Xml = spectrum.XmlContent
            };
        }

        public static ComplexSearchDetailedInfoModel FixMaterialTypeConditions(this ComplexSearchDetailedInfoModel complexSearchDetailedInfoModel,
                                                                               HyperLabDataContext context)
        {
            var materialConditions = complexSearchDetailedInfoModel.Conditions.Where(x => x.ConditionType == ConditionType.ConditionMaterial.ToString());
            foreach (var condition in materialConditions)
            {
                switch (condition.MaterialTypeId)
                {
                    case 2:
                        condition.ValueText = (from x in context.ReadOnlyImaminerals
                                               where x.Id == condition.ValueId
                                               select x.Name)
                                               .AsNoTracking()
                                               .FirstOrDefault();
                        break;

                    case 3:
                        condition.ValueText = (from x in context.ReadOnlyRocks
                                               where x.Id == condition.ValueId
                                               select x.Name)
                                               .AsNoTracking()
                                               .FirstOrDefault();
                        break;

                    case 4:
                        condition.ValueText = (from x in context.ReadOnlyMeteoriteClasses
                                               where x.Id == condition.ValueId
                                               select x.Name)
                                               .AsNoTracking()
                                               .FirstOrDefault();
                        break;
                }
            }

            return complexSearchDetailedInfoModel;
        }

        public static ComplexSearchDetailedInfoModel FixMineralTypeConditions(this ComplexSearchDetailedInfoModel complexSearchDetailedInfoModel,
                                                                              HyperLabDataContext context)
        {
            var mineralConditions = complexSearchDetailedInfoModel.Conditions.Where(x => x.ConditionType == ConditionType.ConditionMineralType.ToString());
            if (mineralConditions?.Count() > 0)
            {
                foreach (var condition in mineralConditions)
                {
                    condition.ValueText = (from x in context.ReadOnlySampleMineralTypeValues
                                           where x.Id == condition.ValueId
                                           select x.Value)
                                           .AsNoTracking()
                                           .FirstOrDefault();
                }
            }

            return complexSearchDetailedInfoModel;
        }

