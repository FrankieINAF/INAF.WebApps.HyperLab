        }

        private MineralsSpectraGroupInfoModel? getMaterialsSpectraGroupInfoModel(SpectraGroupInfoModel spectraGroupInfoModel,
                                                                                MineralType mineralType,
                                                                                int operationUserId,
                                                                                HyperLabDataContext extcontext)
        {
            MineralsSpectraGroupInfoModel? mineralsSpectraGroupInfoModel = getItem<MineralsSpectraGroupInfoModel>(spectraGroupInfoModel,
                                                                                                                  mineralType);
            if (mineralsSpectraGroupInfoModel == null)
                return null;

            mineralsSpectraGroupInfoModel.Minerals = (from lsfm in extcontext.LinkSpectrumFileImaminerals
                                                      join rom in extcontext.ReadOnlyImaminerals on lsfm.MineralId equals rom.Id
                                                      where lsfm.SpectrumId == spectraGroupInfoModel.Id
                                                      && !lsfm.IsDeleted
                                                      select new MaterialModel()
                                                      {
                                                          Id = rom.Id,
                                                          Name = rom.Name
                                                      })
                                                      .ToList();

            return mineralsSpectraGroupInfoModel;
        }

        private SingleMaterialSpectraGroupInfoModel? getMeteorSpectraGroupInfoModel(SpectraGroupInfoModel spectraGroupInfoModel,
                                                                                   MineralType mineralType,
