        public List<SpectraGroupInfoModel>? searchSimpleGroupsByFilename(string filename,
                                                                         List<int> requestedLevels,
                                                                         bool isPublicSearch,
                                                                         int operationUserId)
        {
            List<SpectraGroupInfoModel>? spectra = null;

            try
            {
                using (var context = getDataContext())
                {
                    spectra = (from sf in context.SpectraFiles
                               where EF.Functions.Like(sf.Filename, $"{filename}%")
                               && (
                                (sf.TypeId == (int)SpectrumType.Raw && sf.SourceId == (int)SpectrumSource.SLab)
                                || (sf.TypeId == (int)SpectrumType.Aligned && sf.SourceId == (int)SpectrumSource.External)
                               )
                               && (!isPublicSearch || sf.IsPublic)
                               && requestedLevels.Contains(sf.LevelId)
                               && !sf.IsDeleted
                               orderby sf.Filename
                               select sf)
                               .AsNoTracking()
                               .AsEnumerable()
                               .Where(x => isUserAuthorized(x, operationUserId) || isSpectrumSharedWithUser(context, x, operationUserId))
                               .Select(x => new SpectraGroupInfoModel()
                               {
                                   Id = x.Id,
                                   SpectrumFilename = x.Filename,
                                   SpectrumLevel = x.LevelId.ToSpectrumLevel(),
                               })
                               .ToList();
                }

                if (spectra?.Count > 0)
                {
#if DEBUG
                    foreach (var spectrum in spectra)
                    {
                        System.Diagnostics.Debug.WriteLine($"Found spectrum: {spectrum.SpectrumFilename} (ID: {spectrum.Id})");
                    }
#endif
                    setAvailableSpectrumTypes(ref spectra,
                                              requestedLevels,
                                              operationUserId);
                }
            }
            catch (Exception ex)
            {
                logError(nameof(searchSimpleGroupsBySampleName), ex);
            }

            return spectra;
        }

        public List<SpectraGroupInfoModel>? searchSimpleGroupsByMineralType(int mineralTypeId,
                                                                            List<int> requestedLevels,
                                                                            bool isPublicSearch,
                                                                            int operationUserId)
        {
            List<SpectraGroupInfoModel>? spectraFileInfoModels = null;

            try
            {
                List<SpectraGroupInfoModel>? spectra = null;

                using (var context = getDataContext())
                {
                    spectra = (from sf in context.SpectraFiles
                               join lsfmt in context.LinkSpectrumFileSampleMineralType on sf.Id equals lsfmt.SpectrumFileId into join0
                               from elem in join0.DefaultIfEmpty()
                               where elem.SampleMineralTypeId == mineralTypeId
                               && (
                                (sf.TypeId == (int)SpectrumType.Raw && sf.SourceId == (int)SpectrumSource.SLab)
                                || (sf.TypeId == (int)SpectrumType.Aligned && sf.SourceId == (int)SpectrumSource.External)
                               )
                               && requestedLevels.Contains(sf.LevelId)
                               && (!isPublicSearch || sf.IsPublic)
                               && !elem.IsDeleted
                               && !sf.IsDeleted
                               select sf)
                               .AsNoTracking()
                               .AsEnumerable()
                               .Where(x => isUserAuthorized(x, operationUserId) || isSpectrumSharedWithUser(context, x, operationUserId))
                               .Select(x => new SpectraGroupInfoModel()
                               {
                                   Id = x.Id,
                                   SpectrumFilename = x.Filename,
                                   SpectrumLevel = x.LevelId.ToSpectrumLevel(),
                                   MineralType = mineralTypeId.ToMineralType()
                               })
                               .ToList();
                }

                if (spectra.Count > 0)
                {
                    setAvailableSpectrumTypes(ref spectra,
                                              requestedLevels,
                                              operationUserId);

                    spectraFileInfoModels = new List<SpectraGroupInfoModel>();

                    MineralType mineralType = mineralTypeId.ToMineralType();

                    using (var context = getDataContext())
                    {
                        foreach (var spectrum in spectra)
                        {
                            switch (mineralType)
                            {
                                case MineralType.Monomineralic:
                                    var monoMineral = getMonomineralicMaterialSpectraGroupInfoModel(spectrum,
                                                                                                    mineralType,
                                                                                                    operationUserId,
                                                                                                    context);
                                    if (monoMineral != null)
                                        spectraFileInfoModels.Add(monoMineral);
                                    break;
                                case MineralType.Mix:
                                    var mix = getMaterialsSpectraGroupInfoModel(spectrum,
                                                                              mineralType,
                                                                              operationUserId,
                                                                              context);
                                    if (mix != null)
                                        spectraFileInfoModels.Add(mix);
                                    break;
                                case MineralType.Rock:
                                    var rock = getRockSpectraGroupInfoModel(spectrum,
                                                                           mineralType,
                                                                           operationUserId,
                                                                           context);
                                    if (rock != null)
                                        spectraFileInfoModels.Add(rock);
                                    break;
                                case MineralType.Extraterrestrial:
                                    var meteorite = getMeteorSpectraGroupInfoModel(spectrum,
                                                                                   mineralType,
                                                                                   operationUserId,
                                                                                   context);
                                    if (meteorite != null)
                                        spectraFileInfoModels.Add(meteorite);
                                    break;
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                logError(nameof(searchSimpleGroupsByMineralType), ex);
            }

            return spectraFileInfoModels;
        }

