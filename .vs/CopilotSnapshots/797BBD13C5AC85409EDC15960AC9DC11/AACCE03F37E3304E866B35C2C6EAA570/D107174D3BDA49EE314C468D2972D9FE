        #region private
        private T? getItem<T>(SpectraGroupInfoModel spectraGroupInfoModel,
                             MineralType mineralType)
        {
            return (T?)Activator.CreateInstance(typeof(T), [ spectraGroupInfoModel.Id,
                                                            spectraGroupInfoModel.SpectrumFilename,
                                                            spectraGroupInfoModel.AvailableSpectraTypes,
                                                            spectraGroupInfoModel.SpectrumLevel,
