            if (meteorSpectraGroupInfoModel == null)
                return null;

            meteorSpectraGroupInfoModel.Mineral = (from lsfmc in extcontext.LinkSpectrumFileMeteoriteClass
                                                   join rom in extcontext.ReadOnlyMeteoriteClasses on lsfmc.MeteoriteClassId equals rom.Id
                                                   where lsfmc.SpectrumId == spectraGroupInfoModel.Id
                                                   && !lsfmc.IsDeleted
