        private void setAvailableSpectrumTypes(ref List<SpectraGroupInfoModel> spectraInfoModels,
                                               List<int> requestedLevels,
                                               int operationUserId)
        {
            using (var context = getDataContext())
            {
                foreach (var spectrumInfoModel in spectraInfoModels)
                {
                    int requestedLevelsNum = requestedLevels.Count;
                    for (int j = 0; j < requestedLevelsNum; j++)
                    {
                        var groupSpectrumTypes = executeRawSqlQueryForList<SpectrumType>(getRecursiveQueryForRawChildrenSpectra(spectrumInfoModel.Id, requestedLevels[j], operationUserId),
                                                                                         x => Convert.ToInt32(x[2]).ToSpectrumType(),
                                                                                         context);
                        if (groupSpectrumTypes != null && groupSpectrumTypes.Count > 0)
                            spectrumInfoModel.AvailableSpectraTypes = groupSpectrumTypes;
                    }
                }
            }
        }

        private List<SpectrumType>? getAvailableSpectraTypes(int spectrumId,
                                                             List<int> requestedLevels,
                                                             int operationUserId,
                                                             HyperLabDataContext extcontext)
        {
            return executeRawSqlQueryForList<SpectrumType>(getRecursiveQueryForRawChildrenSpectra(spectrumId, requestedLevels, operationUserId),
                                                           x => Convert.ToInt32(x[2]).ToSpectrumType(),
                                                           extcontext);
        }

        private string getRecursiveQueryForRawChildrenSpectra(int rawId,
                                                              int levelId,
                                                              int operationUserId)
        {
            return $"WITH cte AS (SELECT * FROM SpectraFiles WHERE Id = {rawId} and LevelId = {levelId} " +
                   $"AND ({getUserAuthorizationFilter(operationUserId)} OR EXISTS ({getSpectrumSharedWithUserQuery(rawId, operationUserId)})) " +
                   $"AND IsDeleted = 0 " +
                   $"UNION ALL " +
                   $"SELECT sf.* FROM cte " +
                   $"INNER JOIN SpectraFiles sf on cte.id = sf.ParentId where sf.IsDeleted = 0 and sf.LevelId = {levelId}) " +
                   $"SELECT Id, Filename, TypeId, LevelId, InsertDateTime, EditDateTime, IsDeleted " +
                   $"FROM cte;";
        }

        private string getRecursiveQueryForRawChildrenSpectra(int rawId,
                                                              List<int> levelIds,
                                                              int operationUserId)
        {
            StringBuilder sb = new StringBuilder();
            sb.AppendLine("declare @level table (id int);");
            sb.Append($"insert into @level values ");
            int levelIdsNum = levelIds.Count;
            for (int i = 0; i < levelIdsNum; i++)
            {
                sb.Append($"({levelIds[i]})");
                if (i < levelIdsNum - 1)
                    sb.Append(",");
            }
            sb.AppendLine(";");
            sb.AppendLine($"WITH cte AS (SELECT * FROM SpectraFiles WHERE Id = {rawId} and LevelId in (select id from @level) " +
                          $"AND ({getUserAuthorizationFilter(operationUserId)} OR EXISTS ({getSpectrumSharedWithUserQuery(rawId, operationUserId)})) " +
                          $"AND IsDeleted = 0 " +
                          $"UNION ALL " +
                          $"SELECT sf.* FROM cte " +
                          $"INNER JOIN SpectraFiles sf on cte.id = sf.ParentId where sf.IsDeleted = 0 and sf.LevelId in (select id from @level) )" +
                          $"SELECT Id, Filename, TypeId, LevelId, InsertDateTime, EditDateTime, IsDeleted " +
                          $"FROM cte;");
            System.Diagnostics.Debug.WriteLine(sb.ToString());
            return sb.ToString();
        }
