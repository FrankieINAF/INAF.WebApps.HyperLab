using INAF.Libraries.Net.CommonWebAppModels.Models;
using INAF.Libraries.Net.CommonWebAppModels.Models.Account;
using INAF.Libraries.Net.CommonWebAppModels.Models.Requests;
using INAF.Libraries.Net.CommonWebAppModels.Models.Responses;
using System.Net;
using System.Text;
using System.Text.Json;

namespace INAF.WebApps.HyperLab.Helpers
{
    public class AuthorizationHelper
    {
        private readonly IServiceProvider serviceProvider;
        private readonly IConfiguration configuration;
        private readonly ILogger<AuthorizationHelper> logger;
        private readonly IHttpClientFactory httpClientFactory;

        private readonly string appName;
        private readonly string authServiceBaseUrl;

        public AuthorizationHelper(IServiceProvider serviceProvider,
                                   IConfiguration configuration,
                                   ILogger<AuthorizationHelper> logger,
                                   IHttpClientFactory httpClientFactory)
        {
            this.serviceProvider = serviceProvider;
            this.configuration = configuration;
            this.logger = logger;
            this.httpClientFactory = httpClientFactory;

            appName = configuration.GetValue<string>("AppSettings:AuthService:ApplicationName") ?? throw new ArgumentNullException("AppSettings:ApplicationName configuration is missing");
            authServiceBaseUrl = configuration.GetValue<string>("AppSettings:AuthService:BaseUrl") ?? throw new ArgumentNullException("AppSettings:AuthService:BaseUrl configuration is missing");
        }

        public async Task<GenericResponseModel?> Login(LoginModel model, 
                                                       CancellationToken cancellationToken = default)
        {
            try
            {
                var loginUrl = $"{authServiceBaseUrl}/Account/Login";

                var response = await sendPostRequestAsync<LoginModel, GenericResponseModel>(loginUrl, model, cancellationToken);

                return response;
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error occurred during login for user {UserName}", model.UserName);
                return null;
            }
        }

        #region SEND REQUESTS/MANAGE RESPONSES
        public async Task<TResponse?> sendGetRequestAsync<TResponse>(
            string url,
            GenericRequestByTextModel requestData,
            CancellationToken cancellationToken = default)
        {
            try
            {
                using var httpClient = httpClientFactory.CreateClient();

                httpClient.DefaultRequestHeaders.Add("X-Calling-Application", appName);

                var requestUri = $"{url}?Text={Uri.EscapeDataString(requestData.Text ?? string.Empty)}";

                logger.LogInformation("Sending GET request to {Url}", requestUri);

                var response = await httpClient.GetAsync(requestUri, cancellationToken);

                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync(cancellationToken);
                    var result = JsonSerializer.Deserialize<TResponse>(responseContent);

                    logger.LogInformation("GET request to {Url} completed successfully", requestUri);
                    return result;
                }
                else
                {
                    logger.LogError("GET request to {Url} failed with status code {StatusCode}", requestUri, response.StatusCode);

                    if (response.StatusCode == HttpStatusCode.Unauthorized)
                        return await manageUnauthorizedResponseAsync<TResponse>(response);

                    return default;
                }
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error occurred while sending GET request to {Url}", url);
                throw;
            }
        }

        public async Task<TResponse?> sendPostRequestAsync<TRequest, TResponse>(
            string url,
            TRequest requestData,
            CancellationToken cancellationToken = default)
        {
            try
            {
                using var httpClient = httpClientFactory.CreateClient();

                var jsonContent = JsonSerializer.Serialize(requestData);
                var content = new StringContent(jsonContent, Encoding.UTF8, "application/json");

                httpClient.DefaultRequestHeaders.Add("X-Calling-Application", appName);

                logger.LogInformation("Sending POST request to {Url}", url);

                var response = await httpClient.PostAsync(url, content, cancellationToken);

                if (response.IsSuccessStatusCode)
                {
                    var responseContent = await response.Content.ReadAsStringAsync(cancellationToken);
                    var result = JsonSerializer.Deserialize<TResponse>(responseContent);

                    logger.LogInformation("POST request to {Url} completed successfully", url);
                    return result;
                }
                else
                {
                    logger.LogError("POST request to {Url} failed with status code {StatusCode}", url, response.StatusCode);

                    if (response.StatusCode == HttpStatusCode.Unauthorized)
                        return await manageUnauthorizedResponseAsync<TResponse>(response);

                    return default;
                }
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "Error occurred while sending POST request to {Url}", url);
                throw;
            }
        }



        private async Task<TResponse?> manageUnauthorizedResponseAsync<TResponse>(HttpResponseMessage? response)
        {
            if (response == null || response.StatusCode != HttpStatusCode.Unauthorized)
                return default;

            var unhautorizedContent = await response.Content.ReadAsStringAsync();
            var errorResponse = JsonSerializer.Deserialize<ErrorResponseModel>(unhautorizedContent);

            if (errorResponse != null)
            {
                string? error = errorResponse.Error;
                bool requiresNewToken = errorResponse.RequiresNewToken;

                if (requiresNewToken)
                {
                    // Redirect to login or token refresh
                }
            }
        }
        #endregion
    }
}
