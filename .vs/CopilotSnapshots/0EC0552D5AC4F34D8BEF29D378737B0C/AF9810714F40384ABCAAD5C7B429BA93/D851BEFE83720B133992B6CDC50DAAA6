        #region SAVE
        private async Task<bool> upsertSampleDataAsync(int fileId,
                                                       string sampleName,
                                                       int sampleTypeId,
                                                       int grainSizeTypeId,
                                                       int? grainSizeLowerValueId,
                                                       int? grainSizeUpperValueId,
                                                       int originTypeId,
                                                       int mineralTypeId,
                                                       List<MaterialBaseModel>? minerals,
                                                       MaterialBaseModel rock,
                                                       MaterialBaseModel meteorClass,
                                                       int operationUserId,
                                                       HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                if (!await upsertNameAsync(fileId,
                                           sampleName,
                                           operationUserId,
                                           extcontext))
                    return false;

                /* save selected grain size type */
                int grainSizeTypeResultId = 0;
                if (grainSizeTypeId > 0)
                {
                    (bool isOk, int id) grainSizeTypeResult = await upsertLinkSpectrumFileGrainSizeTypeAsync(fileId,
                                                                                                             grainSizeTypeId,
                                                                                                             operationUserId,
                                                                                                             context);

                    if (!grainSizeTypeResult.isOk)
                        return false;

                    grainSizeTypeResultId = grainSizeTypeResult.id;
                }

                /* save sample type */
                if (!await upsertSampleTypeLinkAsync(fileId,
                                                     sampleTypeId,
                                                     operationUserId,
                                                     context))
                    return false;

                // se grainSizeTypeId è 3,4 allora si salva questo, altrimenti si mette isdeleted = 1
                SampleType sampleType = sampleTypeId.ToSampleType();
                switch (sampleType)
                {
                    case SampleType.None:
                    case SampleType.Slab:
                    case SampleType.Chip:
                        if (!await deleteLinkSpectrumFileGrainSizeTypeAsync(fileId,
                                                                            operationUserId,
                                                                            context))
                            return false;

                        if (!await deleteLinkGrainSizeTypeGrainSizeValuesAsync(grainSizeTypeResultId,
                                                                               operationUserId,
                                                                               context))
                            return false;
                        break;
                    case SampleType.Pellet:
                    case SampleType.Particulate:
                        /* save grain size type - related - grain size */
                        if (!await upsertLinkGrainSizeTypeGrainSizeValuesAsync(fileId,
                                                                               grainSizeTypeResultId,
                                                                               grainSizeTypeId,
                                                                               grainSizeLowerValueId,
                                                                               grainSizeUpperValueId,
                                                                               operationUserId,
                                                                               context))
                            return false;
                        break;
                }

                /* save related meteor class (if present) */
                if (!await upsertMeteoriteClassLinkAsync(fileId,
                                                      meteorClass,
                                                      operationUserId,
                                                      context))
                    return false;

                /* save mineral type */
                if (!await upsertMineralTypeLinkAsync(fileId,
                                                      mineralTypeId,
                                                      operationUserId,
                                                      context))
                    return false;

                /* save related mineral(s) (if present) */
                if (!await upsertMineralLinksAsync(fileId,
                                                   minerals,
                                                   operationUserId,
                                                   context))
                    return false;

                /* save related rock (if present) */
                if (!await upsertRockLinkAsync(fileId,
                                               rock,
                                               operationUserId,
                                               context))
                    return false;

                /* save origin type */
                if (!await upsertOriginTypeLinkAsync(fileId,
                                                     originTypeId,
                                                     operationUserId,
                                                     context))
                    return false;
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(upsertSampleDataAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return isOk;
        }

        private async Task<(bool isOk, int id)> upsertLinkSpectrumFileGrainSizeTypeAsync(int fileId,
                                                                                         int grainSizeTypeId,
                                                                                         int operationUserId,
                                                                                         HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;
            int id = int.MinValue;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                LinkSpectrumFileGrainSizeType? item = null;

                var query = (from lsfgst in context.LinkSpectrumFileGrainSizeType
                             join sf in context.SpectraFiles on lsfgst.SpectrumFileId equals sf.Id
                             where lsfgst.SpectrumFileId == fileId
                             && !lsfgst.IsDeleted
                             && !sf.IsDeleted
                             select new { sf, lsfgst })
                             .AsEnumerable()
                             .Where(x => isUserStrictlyAuthorized(x.sf, operationUserId));

                if (query.Any())
                {
                    /* if a relation for current file already exists, then update it... */
                    item = query.First().lsfgst;

                    if (grainSizeTypeId == 0)
                    {
                        item.IsDeleted = true;

                        item.DeleteDateTime = DateTime.UtcNow;
                        item.DeleteUserId = operationUserId;
                    }
                    else
                    {
                        item.SampleGrainSizeTypeId = (int)grainSizeTypeId!;

                        item.EditDateTime = DateTime.UtcNow;
                        item.EditUserId = operationUserId;
                    }
                }
                else
                {
                    if (grainSizeTypeId > 0)
                    {
                        /* ...otherwise add a new one */
                        item = new LinkSpectrumFileGrainSizeType()
                        {
                            SpectrumFileId = fileId,
                            SampleGrainSizeTypeId = (int)grainSizeTypeId!,

                            InsertDateTime = DateTime.UtcNow,
                            InsertUserId = operationUserId,
                        };

                        context.LinkSpectrumFileGrainSizeType.Add(item);
                    }
                }

                if (item != null)
                {
                    await context.SaveChangesAsync();
                    id = item.Id;
                }
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(upsertLinkSpectrumFileGrainSizeTypeAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return (isOk, id);
        }

        private async Task<bool> upsertMeteoriteClassLinkAsync(int fileId,
                                                               IMaterialModel meteorClass,
                                                               int operationUserId,
                                                               HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            try
            {
                /* if no meteorite class is related to current spectrum, then check whether
                 * a rock was previously related and, if so, remove relationship */
                if (MaterialBaseModel.IsEmpty(meteorClass))
                    return await deleteMeteoriteClassLinkAsync(fileId,
                                                               operationUserId,
                                                               context);

                var query = (from lsfmc in context.LinkSpectrumFileMeteoriteClass
                             join sf in context.SpectraFiles on lsfmc.SpectrumId equals sf.Id
                             where lsfmc.SpectrumId == fileId
                             && !lsfmc.IsDeleted
                             && !sf.IsDeleted
                             select new { sf, lsfmc })
                             .AsEnumerable()
                             .Where(x => isUserStrictlyAuthorized(x.sf, operationUserId));

                if (query.Any())
                {
                    /* if a relation for current file already exists, then update it... */
                    var item = query.FirstOrDefault();

                    if (item != null)
                    {
                        item.lsfmc.EditDateTime = DateTime.UtcNow;
                        item.lsfmc.EditUserId = operationUserId;
                    }
                }
                else
                {
                    var item = new LinkSpectrumFileMeteoriteClass()
                    {
                        SpectrumId = fileId,
                        MeteoriteClassId = meteorClass.Id,

                        InsertDateTime = DateTime.UtcNow,
                        InsertUserId = operationUserId,
                    };

                    context.LinkSpectrumFileMeteoriteClass.Add(item);
                }

                await context.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(upsertMeteoriteClassLinkAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return isOk;
        }

        private async Task<bool> upsertMineralLinksAsync(int fileId,
                                                         List<MaterialBaseModel>? minerals,
                                                         int operationUserId,
                                                         HyperLabDataContext? extcontext = null)
        {
            bool isOk = true;

            HyperLabDataContext context = getDataContext(extcontext);

            //string currentOperation = string.Empty;
            int currentMineralId = 0;

            try
            {
                /* if no minerals are related to current spectrum,
                 * then check whether any mineral was previously related and, 
                 * if so, delete the relationship(s) */
                if (minerals == null || minerals.Count == 0)
                    return await deleteMineralLinksAsync(fileId,
                                                         operationUserId,
                                                         context);

                var existantMinerals = (from lsfim in context.LinkSpectrumFileImaminerals
                                        join sf in context.SpectraFiles on lsfim.SpectrumId equals sf.Id
                                        join m in context.ReadOnlyImaminerals on lsfim.MineralId equals m.Id
                                        where lsfim.SpectrumId == fileId
                                        && !lsfim.IsDeleted
                                        && !m.IsDeleted
                                        && !sf.IsDeleted
                                        select new { sf, lsfim, m })
                                        .AsEnumerable()
                                        .Where(x => isUserStrictlyAuthorized(x.sf, operationUserId))
                                        .Select(m => new MaterialModel()
                                        {
                                            Id = m.m.Id,
                                            Name = m.m.Name,
                                            Percentage = m.lsfim.Percentage.HasValue ? (double)m.lsfim.Percentage.Value : 0
                                        })
                                        .ToList();


                var materialBaseModelComparer = new IMaterialModelComparer();

                var newMinerals = minerals.Except(existantMinerals, materialBaseModelComparer).ToList();

                var removedMinerals = existantMinerals.Except(minerals, materialBaseModelComparer).ToList();

                /* add new minerals */
                foreach (var mineral in newMinerals)
                {
                    //currentOperation = "Add";
                    currentMineralId = mineral.Id;

                    var item = new LinkSpectrumFileImaminerals()
                    {
                        SpectrumId = fileId,
                        MineralId = mineral.Id,
                        Percentage = (decimal)mineral.Percentage,

                        InsertDateTime = DateTime.UtcNow,
                        InsertUserId = operationUserId,
                    };

                    context.LinkSpectrumFileImaminerals.Add(item);
                }

                await context.SaveChangesAsync();

                /* remove minerals not present anymore */
                foreach (var mineral in removedMinerals)
                {
                    //currentOperation = "Remove";
                    currentMineralId = mineral.Id;

                    var removedMineral = (from lsfim in context.LinkSpectrumFileImaminerals
                                          join sf in context.SpectraFiles on lsfim.SpectrumId equals sf.Id
                                          where lsfim.SpectrumId == fileId
                                          && lsfim.MineralId == mineral.Id
                                          && !lsfim.IsDeleted
                                          && !sf.IsDeleted
                                          select new { sf, lsfim })
                                          .AsEnumerable()
                                          .Where(x => isUserStrictlyAuthorized(x.sf, operationUserId))
                                          .FirstOrDefault();

                    if (removedMineral == null)
                        continue;

                    removedMineral.lsfim.IsDeleted = true;

                    removedMineral.lsfim.DeleteDateTime = DateTime.UtcNow;
                    removedMineral.lsfim.DeleteUserId = operationUserId;
                }

                await context.SaveChangesAsync();

                /* update percentage of already existing minerals */
                foreach (var existingMineral in existantMinerals)
                {
                    //currentOperation = "Update";
                    currentMineralId = existingMineral.Id;

                    var incomingExistingMineral = minerals.FirstOrDefault(x => x.Id == existingMineral.Id);
                    if (incomingExistingMineral == null)
                        continue;

                    var existingMineralInDb = (from lsfim in context.LinkSpectrumFileImaminerals
                                               join sf in context.SpectraFiles on lsfim.SpectrumId equals sf.Id
                                               where lsfim.SpectrumId == fileId
                                               && lsfim.MineralId == incomingExistingMineral.Id
                                               && !lsfim.IsDeleted
                                               && !sf.IsDeleted
                                               select new { sf, lsfim })
                                               .AsEnumerable()
                                               .Where(x => isUserStrictlyAuthorized(x.sf, operationUserId))
                                               .FirstOrDefault();

                    if (existingMineralInDb == null)
                        continue;

                    existingMineralInDb.lsfim.Percentage = (decimal)incomingExistingMineral.Percentage;
                    existingMineralInDb.lsfim.EditDateTime = DateTime.UtcNow;
                    existingMineralInDb.lsfim.EditUserId = operationUserId;
                }

                await context.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                isOk = false;
                logError(nameof(upsertMineralLinksAsync), ex);
            }

            if (extcontext == null)
                closeDataContext(context);

            return isOk;
        }

