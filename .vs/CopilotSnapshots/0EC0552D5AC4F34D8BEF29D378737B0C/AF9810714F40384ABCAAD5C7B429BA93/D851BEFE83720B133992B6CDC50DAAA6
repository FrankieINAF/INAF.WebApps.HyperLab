        public SampleDataSelectedValues? getSpectrumFileSampleData(int fileId,
                                                                   bool isPublicSearch,
                                                                   int operationUserId)
        {
            SampleDataSelectedValues? spectrumFileSampleDataValues = null;

            try
            {
                using (var context = getDataContext())
                {
                    spectrumFileSampleDataValues = (from sf in context.SpectraFiles
                                                    join sn in context.SampleName on sf.Id equals sn.SpectrumFileId
                                                    join lsfst in context.LinkSpectrumFileSampleType on sf.Id equals lsfst.SpectrumFileId
                                                    join lsfsmt in context.LinkSpectrumFileSampleMineralType on sf.Id equals lsfsmt.SpectrumFileId
                                                    join lsfsot in context.LinkSpectrumFileSampleOriginType on sf.Id equals lsfsot.SpectrumFileId
                                                    where sf.Id == fileId
                                                    && !lsfst.IsDeleted
                                                    && !lsfsmt.IsDeleted
                                                    && !lsfsot.IsDeleted
                                                    select new { sf, sn, lsfst, lsfsmt, lsfsot })
                                                    .AsNoTracking()
                                                    .Select(x => new SampleDataSelectedValues()
                                                    {
                                                        Name = x.sn.Name,
                                                        SampleTypeId = x.lsfst.SampleTypeId,
                                                        GrainSizeTypeId = (from rogstv in context.ReadOnlyGrainSizeTypeValues
                                                                           join lsfgst in context.LinkSpectrumFileGrainSizeType on rogstv.Id equals lsfgst.SampleGrainSizeTypeId
                                                                           where lsfgst.SpectrumFileId == fileId
                                                                           && !lsfgst.IsDeleted
                                                                           select rogstv.Id)
                                                                           .FirstOrDefault(),
                                                        OriginTypeId = x.lsfsot.OriginTypeId,
                                                        MineralTypeId = x.lsfsmt.SampleMineralTypeId,
                                                        Minerals = (from lsfim in context.LinkSpectrumFileImaminerals
                                                                    join roim in context.ReadOnlyImaminerals on lsfim.MineralId equals roim.Id into g
                                                                    from gelem in g.DefaultIfEmpty()
                                                                    where lsfim.SpectrumId == x.sf.Id
                                                                    && !lsfim.IsDeleted
                                                                    orderby gelem.Name
                                                                    select new MaterialBaseModel()
                                                                    {
                                                                        Id = gelem.Id,
                                                                        Name = gelem.Name,
                                                                        Percentage = lsfim.Percentage.HasValue ? (double)lsfim.Percentage : 0,
                                                                    })
                                                                    .ToList(),
                                                        Rock = (from ror in context.ReadOnlyRocks
                                                                join lsfr in context.LinkSpectrumFileRock on ror.Id equals lsfr.RockId into g
                                                                from gelem in g.DefaultIfEmpty()
                                                                where gelem.SpectrumId == x.sf.Id
                                                                && !gelem.IsDeleted
                                                                orderby ror.Name
                                                                select new MaterialBaseModel()
                                                                {
                                                                    Id = ror.Id,
                                                                    Name = ror.Name
                                                                })
                                                                                       .FirstOrDefault(),
                                                        MeteoriteClass = (from mc in context.ReadOnlyMeteoriteClasses
                                                                          join lsfmc in context.LinkSpectrumFileMeteoriteClass on mc.Id equals lsfmc.MeteoriteClassId into g
                                                                          from gelem in g.DefaultIfEmpty()
                                                                          where gelem.SpectrumId == x.sf.Id
                                                                          && !gelem.IsDeleted
                                                                          orderby mc.Name
                                                                          select new MaterialBaseModel()
                                                                          {
                                                                              Id = gelem.Id,
                                                                              Name = mc.Name,
                                                                          })
                                                                          .FirstOrDefault()
                                                    })
                                                    .FirstOrDefault();

                    if (spectrumFileSampleDataValues != null && 
                        (spectrumFileSampleDataValues.GrainSizeTypeId == (int)GrainSizeType.LowerLimit || spectrumFileSampleDataValues.GrainSizeTypeId == (int)GrainSizeType.Range))
                        spectrumFileSampleDataValues.GrainSizeLowerValueId = (int)(from x in context.ReadOnlyLinkSampleTypeGrainSizeValues
                                                                                   where x.Id == ((
                                                                                     from y in context.LinkGrainSizeTypeGrainSizeValues
                                                                                     where y.LinkSpectrumFileGrainSizeTypeId == ((
                                                                                         from z in context.LinkSpectrumFileGrainSizeType
                                                                                         where z.SpectrumFileId == fileId
                                                                                         && !z.IsDeleted
                                                                                         select z.Id
                                                                                     ).FirstOrDefault())
                                                                                     && !y.IsDeleted
                                                                                     select y.GrainSizeLowerValueId
                                                                                     ).FirstOrDefault())
                                                                                   select x.Id)
                                                                                   .FirstOrDefault();

                    if (spectrumFileSampleDataValues != null &&
                        (spectrumFileSampleDataValues.GrainSizeTypeId == (int)GrainSizeType.UpperLimit || spectrumFileSampleDataValues.GrainSizeTypeId == (int)GrainSizeType.Range))
                        spectrumFileSampleDataValues.GrainSizeUpperValueId = (int)(from x in context.ReadOnlyLinkSampleTypeGrainSizeValues
                                                                                   where x.Id == ((
                                                                                     from y in context.LinkGrainSizeTypeGrainSizeValues
                                                                                     where y.LinkSpectrumFileGrainSizeTypeId == ((
                                                                                         from z in context.LinkSpectrumFileGrainSizeType
                                                                                         where z.SpectrumFileId == fileId
                                                                                         && !z.IsDeleted
                                                                                         select z.Id
                                                                                     ).FirstOrDefault())
                                                                                     && !y.IsDeleted
                                                                                     select y.GrainSizeUpperValueId
                                                                                     ).FirstOrDefault())
                                                                                   select x.Id)
                                                                                   .FirstOrDefault();
                }
            }
            catch (Exception ex)
            {
                logError(nameof(getSpectrumFileSampleData), ex);
            }

            return spectrumFileSampleDataValues;
        }

        #region GET FIXED NAME FROM NAME
        public MaterialBaseModel? getMeteoriteClassByName(string name)
        {
            MaterialBaseModel? meteoriteClass = null;
            try
            {
                using (var context = getDataContext())
                {
                    var candidates = (from m in context.ReadOnlyMeteoriteClasses
                                      where (EF.Functions.Like(m.Name, $"%{name}%")
                                      || EF.Functions.Like(name, $"%{m.Name}%"))
                                      select new MaterialBaseModel()
                                      {
                                          Id = m.Id,
                                          Name = m.Name
                                      })
                                      .AsNoTracking()
                                      .ToList();

                    if (!candidates.Any())
                        return null;

                    // fuzzy: scegli quello con distanza minore
                    return candidates
                            .OrderBy(m =>
                                m.Name!.Equals(name, StringComparison.OrdinalIgnoreCase) ? 0 :
                                m.Name!.StartsWith(name, StringComparison.OrdinalIgnoreCase) ? 1 :
                                Levenshtein(name.ToLower(), m.Name!.ToLower()))
                            .ThenBy(m => m.Name!.Length)
                            .First();
                }
            }
            catch (Exception ex)
            {
                logError(nameof(getMeteoriteClassByName), ex);
            }
            return meteoriteClass;
        }

